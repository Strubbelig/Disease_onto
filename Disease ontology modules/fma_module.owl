        <oboInOwl:hasExactSynonym>Distal segment of free limb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:83015</oboInOwl:id>
        <rdfs:label>Distal free limb segment</rdfs:label>
    </owl:Class>
    


