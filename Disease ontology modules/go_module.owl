    <!-- http://purl.obolibrary.org/obo/GO_0006913 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0006913">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0051169"/>
