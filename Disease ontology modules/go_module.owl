    <!-- http://purl.obolibrary.org/obo/GO_0043062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0043062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0016043"/>
        <obo:IAO_0000115>A process that is carried out at the cellular level which results in the assembly, arrangement of constituent parts, or disassembly of structures in the space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane, and also covers the host cell environment outside an intracellular parasite.</obo:IAO_0000115>
