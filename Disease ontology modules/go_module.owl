        <oboInOwl:id>GO:0038001</oboInOwl:id>
        <rdfs:comment>This term should be used with caution, and only used when the signaling between cells has been clearly distinguished from endocrine signaling.</rdfs:comment>
        <rdfs:label>paracrine signaling</rdfs:label>
    </owl:Class>
    <owl:Axiom>
