    <!-- http://purl.obolibrary.org/obo/GO_0043170 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0043170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008152"/>
