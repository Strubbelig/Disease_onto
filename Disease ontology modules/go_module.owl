        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_1990636"/>
        <obo:IAO_0000115>Cessation of menstruation, occurring in (e.g.) the human female usually around the age of 50.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Menopause</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
