    <!-- http://purl.obolibrary.org/obo/GO_0048870 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0048870">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009987"/>
        <obo:IAO_0000115>Any process involved in the controlled self-propelled movement of a cell that results in translocation of the cell from one place to another.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/geneontology/go-ontology/issues/19809</obo:IAO_0000233>
        <oboInOwl:hasExactSynonym>cell locomotion</oboInOwl:hasExactSynonym>
