        <obo:IAO_0000115 xml:lang="en">A specimen obtained through a lavage process which includes fluid in addition to cells and/or cellular secretions.</obo:IAO_0000115>
        <obo:IAO_0000117>Sebastian Duesing</obo:IAO_0000117>
