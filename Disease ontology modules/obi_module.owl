        <oboInOwl:hasDbXref>galen:Mucosa</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>mucosa of organ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mucosa of organ part</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mucosal region</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mucous membrane</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>organ mucosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>uberon</oboInOwl:hasOBONamespace>
