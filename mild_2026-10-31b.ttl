###  https://bioportal.bioontology.org/ontologies/MILD/MILD_120102
:MILD_120102 rdf:type owl:Class ;
                                                                rdfs:subClassOf obo:BFO_0000019 ;
                                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A quality that a material entity has because medicine classifies it as pathological. Pathologicity is asserted, never inferred: MILD lays down no criteria, rules or inferences for it, because what is pathological can depend on context."@en ;
                                                                rdfs:label "pathological"@en .


###  https://bioportal.bioontology.org/ontologies/MILD/MILD_120000
:MILD_120000 rdf:type owl:Class ;
                                                                rdfs:subClassOf obo:OBI_0001930 ;
                                                                rdfs:label "disease classification stage"@en .


###  https://bioportal.bioontology.org/ontologies/MILD/MILD_120001
:MILD_120001 rdf:type owl:Class ;
                                                                rdfs:subClassOf :MILD_120020 ,
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty obo:RO_0000056 ;
                                                                                  owl:someValuesFrom :MILD_120028
                                                                                ] ,
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty obo:RO_0002353 ;
                                                                                  owl:someValuesFrom :MILD_120021
                                                                                ] ;
                                                                obo:IAO_0000115 "A disease whose disorders had to develop."@en ;
                                                                dc:description "A disease whose disorders had to develop."@en ;
                                                                rdfs:label "Developed material disease entity"@en .


###  https://bioportal.bioontology.org/ontologies/MILD/MILD_120005
:MILD_120005 rdf:type owl:Class ;
                                                                rdfs:subClassOf obo:BFO_0000016 ,
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty obo:BFO_0000197 ;
                                                                                  owl:someValuesFrom obo:BFO_0000040
                                                                                ] ;
                                                                obo:IAO_0000115 "A realizable entity that inheres in a material entity and that, in virtue of the physical makeup of its bearer, inclines that bearer toward participating in processes of a certain type — such that the inclination raises the objective probability of, but does not necessitate, the occurrence of those processes; that may be counteracted or reinforced by other tendencies of the same bearer without thereby ceasing to exist; and that may be realized to varying degrees, or not at all."@en ;
                                                                rdfs:comment "A tendency is distinguished from a disposition not by its bearer or by requiring a material basis — both inhere in a material entity and supervene on its physical makeup — but by its mode of realization: a disposition, once its trigger conditions obtain, is realized; a tendency only probabilistically and partially inclines toward realization and can be opposed by competing tendencies. It is therefore modelled as a sibling of disposition, function, and role under realizable entity, not as a subtype of disposition."@en ;
                                                                rdfs:label "tendency"@en ;
                                                                skos:definition "A realizable entity that inheres in a material entity and that, in virtue of the physical makeup of its bearer, inclines that bearer toward participating in processes of a certain type — such that the inclination raises the objective probability of, but does not necessitate, the occurrence of those processes; that may be counteracted or reinforced by other tendencies of the same bearer without thereby ceasing to exist; and that may be realized to varying degrees, or not at all."@en .


