<https://example.org/disease-review/modules/aura_hierarchy> a owl:Ontology ;
    dcterms:source "BioPortal API hierarchy extraction" ;
    rdfs:comment "Contains review target classes, BioPortal ancestors, direct superclass edges, and common annotations only." .

<http://www.projecthalo.com/aura#Condition> <http://purl.org/dc/terms/source> "review target in AURA from disease_terms_review_enriched.csv" .
