    dcterms:source "BioPortal API hierarchy extraction" ;
    owl:versionInfo "BioPortal: version=1.1, released=2016-05-28T00:00:00.000+00:00, creationDate=2016-06-03T10:38:39.000-07:00, submissionId=1" ;
