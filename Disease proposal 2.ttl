                                                                                ] ;
                                                                <http://purl.obolibrary.org/obo/IAO_0000118> "Predisposition / risk proper"@en ;
                                                                <http://purl.org/dc/elements/1.1/description> "A tendency inhering in a person, grounded in a material basis, whose realization may produce a target pathological disorder."@en ;
                                                                rdfs:label "disease predisposition"@en .


###  https://bioportal.bioontology.org/ontologies/MILD/MILD_120024
<https://bioportal.bioontology.org/ontologies/MILD/MILD_120024> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000030> ,
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty <http://purl.obolibrary.org/obo/IAO_0000136> ;
                                                                                  owl:someValuesFrom <https://bioportal.bioontology.org/ontologies/MILD/MILD_120022>
                                                                                ] ,
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000312> ;
                                                                                  owl:someValuesFrom <https://bioportal.bioontology.org/ontologies/MILD/MILD_120047>
                                                                                ] ;
                                                                <http://purl.obolibrary.org/obo/IAO_0000118> "diagnosis"@en ;
                                                                <http://purl.org/dc/elements/1.1/description> "An information content entity that classifies or groups one or more pathological disorders according to diagnostic criteria. Names such as 'substance use disorder' can denote this diagnostic layer when used as DSM/ICD-style categories or results; this diagnostic use is distinct from any material disease entity in the patient."@en ;
                                                                rdfs:label "disease diagnostic result"@en .


