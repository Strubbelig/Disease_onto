###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120000
:WOND_120000 rdf:type owl:Class ;
             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0001930> ;
             rdfs:label "disease classification stage"@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120001
:WOND_120001 rdf:type owl:Class ;
             rdfs:subClassOf :WOND_120020 ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000056> ;
                               owl:someValuesFrom :WOND_120028
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/RO_0002353> ;
                               owl:someValuesFrom :WOND_120021
                             ] ;
             <http://purl.org/dc/elements/1.1/description> "A disease whose disorders had to develop."@en ;
             rdfs:label "Developed material disease entity"@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120004
:WOND_120004 rdf:type owl:Class ;
             rdfs:subClassOf :WOND_120022 ;
             <http://purl.org/dc/elements/1.1/description> "This is not a predisposition: the pathological material is already present, it just has no observed phenotype yet (e.g. an early subclinical plaque). Silent disorders have no associated phenotype."@en ;
             rdfs:label "silent disorder"@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120005
:WOND_120005 rdf:type owl:Class ;
             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000197> ;
                               owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                             ] ;
             rdfs:comment "A tendency is distinguished from a disposition not by its bearer or by requiring a material basis — both inhere in a material entity and supervene on its physical makeup — but by its mode of realization: a disposition, once its trigger conditions obtain, is realized; a tendency only probabilistically and partially inclines toward realization and can be opposed by competing tendencies. It is therefore modelled as a sibling of disposition, function, and role under realizable entity, not as a subtype of disposition."@en ;
             rdfs:label "tendency"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A realizable entity that inheres in a material entity and that, in virtue of the physical makeup of its bearer, inclines that bearer toward participating in processes of a certain type — such that the inclination raises the objective probability of, but does not necessitate, the occurrence of those processes; that may be counteracted or reinforced by other tendencies of the same bearer without thereby ceasing to exist; and that may be realized to varying degrees, or not at all."@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120006
:WOND_120006 rdf:type owl:Class ;
             rdfs:label "disorder removal process"@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120007
:WOND_120007 rdf:type owl:Class ;
             rdfs:subClassOf :WOND_120020 ;
             rdfs:comment "Disorder asserted but not yet characterized; defined operationally at the classification layer."@en ;
             rdfs:label "unknown-disorder disease"@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120008
:WOND_120008 rdf:type owl:Class ;
             rdfs:subClassOf :WOND_120023 ,
                             [ owl:intersectionOf ( :WOND_120023
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000218> ;
                                                      owl:someValuesFrom :WOND_120009
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
             rdfs:label "genetic predisposition"@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120009
:WOND_120009 rdf:type owl:Class ;
             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
             rdfs:label "genetic variant"@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120010
:WOND_120010 rdf:type owl:Class ;
             rdfs:subClassOf :WOND_120023 ,
                             [ owl:intersectionOf ( :WOND_120023
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000197> ;
                                                      owl:someValuesFrom [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/NCBITaxon_9606>
                                                                                                [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                                                  owl:someValuesFrom :WOND_120022
                                                                                                ]
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ]
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
             rdfs:label "predisposition from an existing disorder"@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120011
:WOND_120011 rdf:type owl:Class ;
             rdfs:subClassOf :WOND_120086 ,
                             :WOND_120087 ;
             rdfs:label "intended disorder elimination process"@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120012
:WOND_120012 rdf:type owl:Class ;
             rdfs:subClassOf :WOND_120021 ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000055> ;
                               owl:someValuesFrom :WOND_120023
                             ] ;
             rdfs:label "predisposition realizing disorder development process"@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120020
:WOND_120020 rdf:type owl:Class ;
             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                               owl:someValuesFrom <http://purl.obolibrary.org/obo/NCBITaxon_9606>
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                               owl:someValuesFrom :WOND_120022
                             ] ;
             owl:disjointWith :WOND_120023 ;
             <http://purl.org/dc/elements/1.1/description> "A material entity that has one or more pathological disorders as parts; which disorders compose one disease is fixed by the diagnostic classification assigned to them, not by an intrinsic unity criterion. Identity is grounded in the continuity of the disorder lineage, not in momentary material composition (cf. a river persisting through complete material replacement)."@en ;
             rdfs:label "material disease entity"@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120021
:WOND_120021 rdf:type owl:Class ;
             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/RO_0002234> ;
                               owl:someValuesFrom :WOND_120022
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :WOND_120085 ;
                               owl:someValuesFrom :WOND_120031
                             ] ;
             rdfs:comment "Deliberately no input mandatory. A pre-existing disorder as input would be false for de novo disease (the first disorder has no disorder input)."@en ;
             rdfs:label "disorder development process"@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120022
:WOND_120022 rdf:type owl:Class ;
             rdfs:subClassOf <http://purl.obolibrary.org/obo/OGMS_0000045> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                               owl:someValuesFrom <http://purl.obolibrary.org/obo/NCBITaxon_9606>
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                               owl:someValuesFrom :WOND_120020
                             ] ;
             owl:disjointWith :WOND_120023 ;
             <http://purl.org/dc/elements/1.1/description> "Pathologicity is asserted - not inferred -  by primitives (e.g. threat to life, pain/suffering, loss of ability/fertility) as mentioned by Hucklenbroich et al."@en ;
             rdfs:label "pathological disorder"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "a disorder is an abnormal presence or organisation of material components — including the limiting case where the abnormal organisation consists in a normally-present component being absent."@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120023
:WOND_120023 rdf:type owl:Class ;
             rdfs:subClassOf [ owl:intersectionOf ( :WOND_120005
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000054> ;
                                                      owl:someValuesFrom :WOND_120021
                                                    ]
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000197> ;
                                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/NCBITaxon_9606>
                                                    ]
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000218> ;
                                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000218> ;
                               owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                             ] ;
             <http://purl.obolibrary.org/obo/IAO_0000118> "Predisposition / risk proper"@en ;
             rdfs:label "disease predisposition"@en .


###  http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120024
:WOND_120024 rdf:type owl:Class ;
