  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0007417</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">central nervous system development</rdfs:label>
</owl:Class>

