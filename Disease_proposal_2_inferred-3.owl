<owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0061337">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008016"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transfer of an organized electrical impulse across the heart to coordinate the contraction of cardiac muscles. The process begins with generation of an action potential (in the sinoatrial node (SA) in humans) and ends with a change in the rate, frequency, or extent of the contraction of the heart muscles.</obo:IAO_0000115>
