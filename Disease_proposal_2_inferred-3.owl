  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biosynthesis</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synthesis</oboI:hasExactSynonym>
