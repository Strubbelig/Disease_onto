<owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0023052">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0050789"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_agr"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_euk_cellular_processes_ribbon"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_flybase_ribbon"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_generic"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_mouse"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_pombe"/>
