  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0090063</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">positive regulation of microtubule nucleation</rdfs:label>
</owl:Class>

