  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fascia of muscle organ</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uberon</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBERON:0011899</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epimysium</rdfs:label>
</owl:Class>

