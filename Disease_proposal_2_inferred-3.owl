  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p is causally upstream of, negative effect q iff p is casually upstream of q, and the execution of p decreases the execution of q.</obo:IAO_0000115>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">causally upstream of, negative effect</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002335">
