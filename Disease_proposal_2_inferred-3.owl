  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pT2a (ovary)</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002274">
  <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0002270"/>
