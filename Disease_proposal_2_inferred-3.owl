  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://wiki.geneontology.org/Acts_upstream_of_or_within,_positive_effect</rdfs:seeAlso>
</owl:ObjectProperty>

