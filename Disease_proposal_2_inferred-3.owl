<owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001084">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36080"/>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that is a translation product of the human CD8A gene or a 1:1 ortholog thereof. CD8 is a transmembrane that is a co-receptor for MHC class-I antigen/T-cell receptor interaction. The most common form of CD8 is composed of a CD8 alpha and a CD8 beta chain.</obo:IAO_0000115>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CD8a</oboI:hasExactSynonym>
