  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">motoneuron</oboI:hasExactSynonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">motor neuron</rdfs:label>
</owl:Class>

