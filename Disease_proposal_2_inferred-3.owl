  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCIT:C12957</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Exocrine_gland</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WikipediaCategory:Exocrine_system</oboI:hasDbXref>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exocrine glandular system</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uberon</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBERON:0002330</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exocrine system</rdfs:label>
</owl:Class>

