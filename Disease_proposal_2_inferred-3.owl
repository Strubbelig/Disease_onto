  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sinusoidal capillary</oboI:hasRelatedSynonym>
  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sinusoidal endothelium</oboI:hasRelatedSynonym>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBERON:0003909</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sinusoid</rdfs:label>
