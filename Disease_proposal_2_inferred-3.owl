  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0034220</oboI:id>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Note that this term is not intended for use in annotating lateral movement within membranes.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">monoatomic ion transmembrane transport</rdfs:label>
