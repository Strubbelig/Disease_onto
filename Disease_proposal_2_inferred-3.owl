  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0003158</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endothelium development</rdfs:label>
</owl:Class>

