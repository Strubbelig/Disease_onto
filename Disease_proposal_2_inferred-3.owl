    </owl:Restriction>
  </rdfs:subClassOf>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The formation of the neural tube from an epithelial cell sheet (the neuroepithelium or neural plate). In primary neurulation, the cells surrounding the neural plate direct the neural plate cells to proliferate, invaginate, and pinch off from the surface to form a hollow epithelial tube. Primary neurulation is the typical mechanism of formation of the anterior neural tube.</obo:IAO_0000115>
  <oboI:hasAlternativeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0014024</oboI:hasAlternativeId>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">primary neural tube morphogenesis</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">primary neurulation</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological_process</oboI:hasOBONamespace>
  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">neural rod cavitation</oboI:hasRelatedSynonym>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0014020</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">primary neural tube formation</rdfs:label>
</owl:Class>

