    </owl:Restriction>
  </rdfs:subClassOf>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process in which a relatively unspecialized cell acquires specialized features of a skeletal muscle fiber cell. Skeletal muscle fiber differentiation starts with myoblast fusion and the appearance of specific cell markers (this is the cell development step). Then individual skeletal muscle fibers fuse to form bigger myotubes and start to contract.</obo:IAO_0000115>
  <oboI:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dos</oboI:created_by>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-10-15T14:00:34Z</oboI:creation_date>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological_process</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0098528</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">skeletal muscle fiber differentiation</rdfs:label>
</owl:Class>

