<owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0060437">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0048589"/>
