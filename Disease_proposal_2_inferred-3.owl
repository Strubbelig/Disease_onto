  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transmembrane ion transport</oboI:hasExactSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ATP hydrolysis coupled ion transmembrane transport</oboI:hasNarrowSynonym>
