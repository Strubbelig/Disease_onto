  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein that is a translation product of the human CD8A gene or a 1:1 ortholog thereof. CD8 is a transmembrane that is a co-receptor for MHC class-I antigen/T-cell receptor interaction. The most common form of CD8 is composed of a CD8 alpha and a CD8 beta chain.</owl:annotatedTarget>
