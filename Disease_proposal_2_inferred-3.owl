  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">downregulation of translational elongation</oboI:hasExactSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inhibition of translational elongation</oboI:hasNarrowSynonym>
