  <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Occult Carcinoma (AJCC 7th)</obo:IAO_0000111>
  <obo:IAO_0000115 xml:lang="en">A clinical tumor stage group according to AJCC 7th edition indicating a small carcinoma, either asymptomatic or giving rise to metastases without symptoms due to the primary carcinoma.</obo:IAO_0000115>
