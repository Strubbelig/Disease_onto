  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oxidoreductase acting on donor CH-NH group, NAD(+) or NADP(+) as acceptor (EC 1.5.1.*) inhibitors</oboI:hasRelatedSynonym>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEBI:76863</oboI:id>
