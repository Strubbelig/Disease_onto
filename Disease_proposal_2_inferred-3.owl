  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An extracellular matrix consisting mainly of proteins (especially collagen) and glycosaminoglycans (mostly as proteoglycans) that provides not only essential physical scaffolding for the cellular constituents but can also initiate crucial biochemical and biomechanical cues required for tissue morphogenesis, differentiation and homeostasis. The components are secreted by cells in the vicinity and form a sheet underlying or overlying cells such as endothelial and epithelial cells.</obo:IAO_0000115>
  <oboI:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dph</oboI:created_by>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-04-13T12:47:21Z</oboI:creation_date>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collagen-containing ECM</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cellular_component</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0062023</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collagen-containing extracellular matrix</rdfs:label>
</owl:Class>

