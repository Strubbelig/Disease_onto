  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0048749</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compound eye development</rdfs:label>
</owl:Class>

