  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0035912</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dorsal aorta morphogenesis</rdfs:label>
</owl:Class>

