  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relation that holds between a disease or an organism and a phenotype</obo:IAO_0000115>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has symptom</rdfs:label>
</owl:ObjectProperty>

