  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any process that decreases the rate or extent of striated muscle cell apoptotic process, a form of programmed cell death induced by external or internal signals that trigger the activity of proteolytic caspases whose actions dismantle a striated muscle cell and result in its death.</obo:IAO_0000115>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">down regulation of striated muscle cell apoptosis</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">down-regulation of striated muscle cell apoptosis</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">downregulation of striated muscle cell apoptosis</oboI:hasExactSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inhibition of striated muscle cell apoptosis</oboI:hasNarrowSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">negative regulation of striated muscle cell apoptosis</oboI:hasNarrowSynonym>
