<owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007059">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0022402"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_chembl"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_drosophila"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_generic"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_pir"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_prokaryote"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_yeast"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process in which genetic material, in the form of chromosomes, is organized into specific structures and then physically separated and apportioned to two or more sets. In eukaryotes, chromosome segregation begins with the condensation of chromosomes, includes chromosome separation, and ends when chromosomes have completed movement to the spindle poles.</obo:IAO_0000115>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Chromosome_segregation</oboI:hasDbXref>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromosome division</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological_process</oboI:hasOBONamespace>
  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromosome transmission</oboI:hasRelatedSynonym>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0007059</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromosome segregation</rdfs:label>
</owl:Class>

