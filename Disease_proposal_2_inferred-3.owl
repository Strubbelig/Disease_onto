    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002230"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0097194"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/go.owl"/>
  <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apoptotic process</obo:IAO_0000111>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A programmed cell death process which begins when a cell receives an internal (e.g. DNA damage) or external signal (e.g. an extracellular death ligand), and proceeds through a series of biochemical events (signaling pathway phase) which trigger an execution phase. The execution phase is the last step of an apoptotic process, and is typically characterized by rounding-up of the cell, retraction of pseudopodes, reduction of cellular volume (pyknosis), chromatin condensation, nuclear fragmentation (karyorrhexis), plasma membrane blebbing and fragmentation of the cell into apoptotic bodies. When the execution phase is completed, the cell has died.</obo:IAO_0000115>
  <oboI:hasAlternativeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0006917</oboI:hasAlternativeId>
  <oboI:hasAlternativeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0008632</oboI:hasAlternativeId>
  <oboI:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell suicide</oboI:hasBroadSynonym>
  <oboI:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cellular suicide</oboI:hasBroadSynonym>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome:R-HSA-109581</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Apoptosis</oboI:hasDbXref>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apoptotic cell death</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apoptotic programmed cell death</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">programmed cell death by apoptosis</oboI:hasExactSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">activation of apoptosis</oboI:hasNarrowSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apoptosis</oboI:hasNarrowSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apoptosis signaling</oboI:hasNarrowSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apoptotic program</oboI:hasNarrowSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">type I programmed cell death</oboI:hasNarrowSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological_process</oboI:hasOBONamespace>
  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apoptosis activator activity</oboI:hasRelatedSynonym>
  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">caspase-dependent programmed cell death</oboI:hasRelatedSynonym>
  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">commitment to apoptosis</oboI:hasRelatedSynonym>
  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">induction of apoptosis</oboI:hasRelatedSynonym>
  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">induction of apoptosis by p53</oboI:hasRelatedSynonym>
  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signaling (initiator) caspase activity</oboI:hasRelatedSynonym>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0006915</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apoptotic process</rdfs:label>
</owl:Class>

