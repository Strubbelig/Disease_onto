          <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000037"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0002244"/>
