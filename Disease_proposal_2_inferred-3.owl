  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0005798</oboI:id>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Note that this definition includes vesicles that are transiently associated with the Golgi.</rdfs:comment>
