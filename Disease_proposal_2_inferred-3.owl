</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002629">
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002213"/>
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002578"/>
  <obo:IAO_0000119 rdf:resource="http://purl.obolibrary.org/obo/ro/docs/causal-relations"/>
  <obo:RO_0004049 rdf:resource="http://purl.obolibrary.org/obo/RO_0002578"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_annotation_extension"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_ontology"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_gocam"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p directly positively regulates q iff p is immediately causally upstream of q, and p positively regulates q.</obo:IAO_0000115>
  <obo:IAO_0000589 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">directly positively regulates (process to process)</obo:IAO_0000589>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">directly positively regulates</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://wiki.geneontology.org/Directly_positively_regulates</rdfs:seeAlso>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002342">
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002021"/>
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002344"/>
