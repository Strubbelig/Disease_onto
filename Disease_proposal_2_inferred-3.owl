  <obo:IAO_0000115 xml:lang="en">A planned process with the objective to produce a processed material which will have a function for future use.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A person or organization (having manufacturer role) is a participant in this process</obo:IAO_0000116>
