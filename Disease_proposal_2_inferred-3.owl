  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell blebbing</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">plasma membrane bleb assembly</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">plasma membrane blebbing</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological_process</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0032060</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bleb assembly</rdfs:label>
</owl:Class>

