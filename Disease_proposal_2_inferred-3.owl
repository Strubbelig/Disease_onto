  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_gp2term"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">c 'acts upstream of, positive effect' p if c is enables f, and f is causally upstream of p, and the direction of f is positive</obo:IAO_0000115>
