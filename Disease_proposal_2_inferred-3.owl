  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromosome organisation</oboI:hasExactSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNA packaging</oboI:hasNarrowSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological_process</oboI:hasOBONamespace>
  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromosome organization and biogenesis</oboI:hasRelatedSynonym>
  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maintenance of genome integrity</oboI:hasRelatedSynonym>
  <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nuclear genome maintenance</oboI:hasRelatedSynonym>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0051276</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromosome organization</rdfs:label>
</owl:Class>

