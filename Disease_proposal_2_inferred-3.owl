  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0090596</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sensory organ morphogenesis</rdfs:label>
</owl:Class>

