  <term:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A stem cell that can give rise to multiple cell types (i.e. smooth muscle, endothelial) in the developing heart.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-07-11T03:15:38+00:00</oboI:creation_date>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cardiovascular progenitor cell</oboI:hasExactSynonym>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Discrepancy in develops from origins prevents me from making the assertion that cardioblasts give rise to all instances of cardiocytes as we state cardiac muscle cells develop from cardiac myoblast, which in turn develop from muscle stem cell.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cardioblast</rdfs:label>
</owl:Class>

