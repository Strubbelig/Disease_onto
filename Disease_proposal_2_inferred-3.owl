<owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025031">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
  <term:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
  <term:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-08-27T13:44:32+00:00</term:date>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">human_phenotype</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HP:0025031</oboI:id>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any anomaly of the digestive system, a collection of organs that is made up of the gastrointestinal tract and the liver, pancreas, and gallbladder. The gastrointestinal tract is a series of hollow organs joined in a long, twisting tube from the mouth to the anus, including the mouth, esophagus, stomach, small intestine, large intestine and anus.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Abnormality of the digestive system</rdfs:label>
</owl:Class>

