      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002162"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_6072"/>
    </owl:Restriction>
  </rdfs:subClassOf>
