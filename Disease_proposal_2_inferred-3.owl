  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0024115</oboI:hasDbXref>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disease_ontology</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DOID:850</oboI:id>
  <rdfs:comment xml:lang="en">Updating out dated CUI and removing lung abscess as a synonym.</rdfs:comment>
  <rdfs:label xml:lang="en">lung disease</rdfs:label>
</owl:Class>

