  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0086068</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Purkinje myocyte to ventricular cardiac muscle cell communication</rdfs:label>
</owl:Class>

