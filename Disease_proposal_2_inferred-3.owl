  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The multiplication or reproduction of acinar cells, resulting in the expansion of a cell population. An acinar cell is a secretory cell that is grouped together with other cells of the same type to form grape-shaped clusters known as acini (singular acinus).</obo:IAO_0000115>
  <oboI:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sl</oboI:created_by>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2015-09-25T14:26:09Z</oboI:creation_date>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acinic cell proliferation</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acinous cell proliferation</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological_process</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:1990863</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acinar cell proliferation</rdfs:label>
</owl:Class>

