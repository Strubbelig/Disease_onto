  <rdfs:seeAlso rdf:resource="https://github.com/obophenotype/uberon/issues/2212"/>
  <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In the tree T depicted in https://oborel.github.io/obo-relations/branching_part_of.png, B1 is connecting branch of S, and B1-1 as a connecting branch of B1.</obo:IAO_0000112>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">b connecting-branch-of s iff b is connected to s, and there exists some tree-like structure t such that the mereological sum of b plus s is either the same as t or a branching-part-of t.</obo:IAO_0000115>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">connecting branch of</rdfs:label>
</owl:ObjectProperty>

