  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vein of face</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uberon</oboI:hasOBONamespace>
