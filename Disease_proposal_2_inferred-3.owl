    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000163"/>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000527"/>
