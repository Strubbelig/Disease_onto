  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The enlargement or overgrowth of all or part of an organ due to an increase in size of its smooth muscle cells without cell division. Physiological hypertrophy is a normal process during development, and can also occur in mature structures on demand. In the uterus, smooth muscle cells undergo hypertrophy during pregnancy.</obo:IAO_0000115>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological_process</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0014895</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">smooth muscle hypertrophy</rdfs:label>
</owl:Class>

