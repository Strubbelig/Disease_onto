  <term:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0003-2620-0345"/>
  <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A diagnostic testing device utilizes a specimen.</obo:IAO_0000112>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X device utilizes material Y means X and Y are material entities, and X is capable of some process P that has input Y.</obo:IAO_0000115>
  <obo:IAO_0000232 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A diagnostic testing device utilizes a specimen means that the diagnostic testing device is capable of an assay, and this assay a specimen as its input.</obo:IAO_0000232>
  <obo:IAO_0000232 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">See github ticket https://github.com/oborel/obo-relations/issues/497</obo:IAO_0000232>
  <rdfs:label xml:lang="en">device utilizes material</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002447">
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002436"/>
