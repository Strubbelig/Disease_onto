      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000076"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An ectodermal cell that is part of the external ectoderm, forming the outermost layer of the developing embryo. It is characterized by its polarized nature, with distinct apical and basal surfaces (Ferrante Jr., Reinke, &amp; Stanley, 1995). Surface ectodermal cell gives rise to the epidermis, hair follicles, nails, sensory organs, and specialized structures like the apical ectodermal ridge crucial for limb development (Skoufa et al., 2024).</obo:IAO_0000115>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:72552</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://cellxgene.cziscience.com/cellguide/CL_0000114</oboI:hasDbXref>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell of surface ectoderm</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">surface ectoderm cell</oboI:hasExactSynonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">surface ectodermal cell</rdfs:label>
</owl:Class>

