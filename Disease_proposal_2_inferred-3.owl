<owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002715">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abnormality of the immune system.</obo:IAO_0000115>
  <oboI:hasAlternativeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HP:0003257</oboI:hasAlternativeId>
  <oboI:hasAlternativeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HP:0003346</oboI:hasAlternativeId>
  <oboI:hasAlternativeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HP:0010986</oboI:hasAlternativeId>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C4021753</oboI:hasDbXref>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Abnormality of the immune system</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Immunological abnormality</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">human_phenotype</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HP:0002715</oboI:id>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The immune system is composed of organs and interdependent cell types that collectively protect the body from infections and from the growth of tumor cells. The organs of the immune system comprise the bone marrow, the spleen, the thymus,the lymph nodes, and the cell types comprise B cells, T cells, natural killer cells, granulocytes,dendritic cells, and macrophages.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Abnormality of the immune system</rdfs:label>
</owl:Class>

