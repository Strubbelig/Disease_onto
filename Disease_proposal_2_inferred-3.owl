    </owl:Class>
  </rdfs:range>
  <x_1.1:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">267-BFO</x_1.1:identifier>
  <rdfs:label xml:lang="en">environs</rdfs:label>
  <core:altLabel xml:lang="en">contains process</core:altLabel>
  <core:definition xml:lang="en">b environs c =Def c occurs in b</core:definition>
  <core:example xml:lang="en">Mouth environs process of mastication; city environs traffic</core:example>
</owl:ObjectProperty>

