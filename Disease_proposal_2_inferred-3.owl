  </rdfs:subClassOf>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any process that increases the rate, frequency, or extent of neural crest formation. Neural crest formation is the formation of the specialized region of ectoderm between the neural ectoderm (neural plate) and non-neural ectoderm. The neural crest gives rise to the neural crest cells that migrate away from this region as neural tube formation proceeds.</obo:IAO_0000115>
  <oboI:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tb</oboI:created_by>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010-03-12T04:08:26Z</oboI:creation_date>
