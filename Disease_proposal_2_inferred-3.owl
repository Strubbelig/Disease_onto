  <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
  <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has specified numeric value</obo:IAO_0000111>
  <obo:IAO_0000115 xml:lang="en">A relation between a value specification and a number that quantifies it.</obo:IAO_0000115>
  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A range of 'real' might be better than 'float'. For now we follow 'has measurement value' until we can consider technical issues with SPARQL queries and reasoning.</obo:IAO_0000116>
