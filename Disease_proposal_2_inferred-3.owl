    </owl:Restriction>
  </rdfs:subClassOf>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any process that modulates the rate, frequency or extent of neuron projection development. Neuron projection development is the process whose specific outcome is the progression of a neuron projection over time, from its formation to the mature structure. A neuron projection is any process extending from a neural cell, such as axons or dendrites (collectively called neurites).</obo:IAO_0000115>
  <oboI:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tb</oboI:created_by>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2009-06-01T10:44:45Z</oboI:creation_date>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">regulation of neurite biosynthesis</oboI:hasNarrowSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">regulation of neurite development</oboI:hasNarrowSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">regulation of neurite formation</oboI:hasNarrowSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">regulation of neurite growth</oboI:hasNarrowSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological_process</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0010975</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">regulation of neuron projection development</rdfs:label>
</owl:Class>

