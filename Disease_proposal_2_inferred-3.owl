  <obo:IAO_0000115 xml:lang="en">RDF is a format standard of a digital entity that is conformant with the W3C Resource Description Framework RDF/XML Syntax specification.(http://www.w3.org/RDF/)</obo:IAO_0000115>
  <obo:IAO_0000117 xml:lang="en">person:Jennifer Fostel</obo:IAO_0000117>
