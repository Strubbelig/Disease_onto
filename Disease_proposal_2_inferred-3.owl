  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0061351</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">neural precursor cell proliferation</rdfs:label>
</owl:Class>

