  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The pharynx is the part of the digestive system immediately posterior to the mouth[GO].</obo:IAO_0000115>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAT:0000049</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MESH:D010614</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MIAA:0000049</oboI:hasDbXref>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uberon</oboI:hasOBONamespace>
