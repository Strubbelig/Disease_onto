    </owl:Restriction>
  </rdfs:subClassOf>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any process that activates or increases the frequency, rate, or extent of myeloid leukocyte mediated immunity.</obo:IAO_0000115>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">up regulation of myeloid leukocyte mediated immunity</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">up-regulation of myeloid leukocyte mediated immunity</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">upregulation of myeloid leukocyte mediated immunity</oboI:hasExactSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">activation of myeloid leukocyte mediated immunity</oboI:hasNarrowSynonym>
  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stimulation of myeloid leukocyte mediated immunity</oboI:hasNarrowSynonym>
