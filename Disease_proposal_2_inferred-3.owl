  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0099188</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">postsynaptic cytoskeleton organization</rdfs:label>
</owl:Class>

