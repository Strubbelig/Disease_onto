  <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M: kidney distant Metastases (AJCC 7th Edition)</obo:IAO_0000118>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCI BBRB, OBI</obo:IAO_0000119>
  <obo:IAO_0000234 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCI BBRB</obo:IAO_0000234>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pathologic distant metastases stage for kidney according to AJCC 7th edition</rdfs:label>
</owl:Class>

