  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAT:0000181</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MIAA:0000181</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCIT:C33547</oboI:hasDbXref>
