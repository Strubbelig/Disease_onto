  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/ro/subsets#ro-eco"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inverse of branching part of</obo:IAO_0000115>
