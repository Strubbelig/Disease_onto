  <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0002243"/>
  <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
  <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pT0 (kidney)</obo:IAO_0000111>
  <obo:IAO_0000115 xml:lang="en">A pathologic primary tumor stage for kidney according to AJCC 7th edition indicating that there is no evidence of primary tumor.</obo:IAO_0000115>
  <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chris Stoeckert, Helena Ellis</obo:IAO_0000117>
