  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vasodilatation</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological_process</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0042311</oboI:id>
