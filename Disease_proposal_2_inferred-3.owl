<owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005730">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0043232"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0031981"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002162"/>
      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_2759"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_candida"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_chembl"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_drosophila"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_generic"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_pir"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_plant"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_yeast"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A small, dense body one or more of which are present in the nucleus of eukaryotic cells. It is rich in RNA and protein, is not bounded by a limiting membrane, and is not seen during mitosis. Its prime function is the transcription of the nucleolar DNA into 45S ribosomal-precursor RNA, the processing of this RNA into 5.8S, 18S, and 28S components of ribosomal RNA, and the association of these components with 5S RNA and proteins synthesized outside the nucleolus. This association results in the formation of ribonucleoprotein precursors; these pass into the cytoplasm and mature into the 40S and 60S subunits of the ribosome.</obo:IAO_0000115>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NIF_Subcellular:sao1820400233</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Nucleolus</oboI:hasDbXref>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cellular_component</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0005730</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nucleolus</rdfs:label>
</owl:Class>

