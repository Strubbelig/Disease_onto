</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BSPO_0000126"/>

<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000194">
  <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000195"/>
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000020"/>
