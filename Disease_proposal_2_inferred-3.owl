<owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032674">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011121"/>
