<owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001592">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0001638"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0020102"/>
          <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002185"/>
        </owl:Restriction>
