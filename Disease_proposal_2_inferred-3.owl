  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0140014</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mitotic nuclear division</rdfs:label>
</owl:Class>

