  <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gland SubClassOf 'has part structure that is capable of' some 'secretion by cell'</obo:IAO_0000112>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">s 'has part structure that is capable of' p if and only if there exists some part x such that s 'has part' x and x 'capable of' p</obo:IAO_0000115>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has part structure that is capable of</rdfs:label>
</owl:ObjectProperty>

