  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000576"/>
            <owl:Restriction>
              <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
              <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DRON_00000028"/>
            </owl:Restriction>
          </owl:intersectionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-6378-1703"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0002-5039-2052"/>
  <obo:IAO_0000115 xml:lang="en">A material entity that (1) contains at least one scattered molecular aggregate as part and (2) is intended, when administered to an organism, to produce some therapeutic and/or psychoactive effect.</obo:IAO_0000115>
  <obo:IAO_0000117 xml:lang="en">William R. Hogan</obo:IAO_0000117>
  <term:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://orcid.org/0000-0002-9881-1017</term:creator>
  <rdfs:comment xml:lang="en">The "intention" part is important because of situations, such as that with phenylephrine, where it was not effective for the labeled use. Even when a drug is proven effective for a particular indication, it might not be therapeutic for every indivdiual to whom it is administered.</rdfs:comment>
  <rdfs:comment xml:lang="en">The psychoactive effect is added for illicit drugs such as crack cocaine.</rdfs:comment>
  <rdfs:comment xml:lang="en">We are including prophylactic and diagnostic effects / usage under the more general heading of 'therapeutic'.</rdfs:comment>
  <rdfs:label xml:lang="en">drug product</rdfs:label>
</owl:Class>

