<owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002068">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002086"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specialized cardiac myocyte that is subendocardially interspersed with the regular cardiac muscle cell. They are uninucleate cylindrical cells, associated end-to-end in long rows, continue from the node to the atrioventricular bundle; relatively short compared to ordinary myocytes but are nearly twice their diameter.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-06-28T08:36:15+00:00</oboI:creation_date>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BTO:0001032</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:14146</oboI:hasDbXref>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Purkinje cell fiber</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Purkinje muscle cell</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">myocytus conducens cardiacus</oboI:hasExactSynonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Purkinje myocyte</rdfs:label>
</owl:Class>

