  <rdfs:label xml:lang="en">first instant of</rdfs:label>
  <core:definition xml:lang="en">t first instant of t' =Def t is a temporal instant &amp; t' is a temporal region t' &amp; t precedes all temporal parts of t' other than t</core:definition>
  <core:example xml:lang="en">An hour starting at midnight yesterday has first instant midnight yesterday</core:example>
</owl:ObjectProperty>

