<owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001005">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000025796"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An integrin alpha that contains an A domain. A hallmark of this class is the presence of a von Willebrand factor type A domain (Pfam:PF00092) (I-domain) of approximately 200 amino acid residues at the N terminus, which confers divalent cation binding properties. Unlike other integrin alpha proteins, they do not undergo proteolytic cleavage.</obo:IAO_0000115>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIRSF:PIRSF002497</oboI:hasDbXref>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">integrin alpha with I domain</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PR:000001005</oboI:id>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Category=family.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">integrin alpha with A domain</rdfs:label>
</owl:Class>

