<owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032675">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0032674"/>
  <term:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cutaneous wound that is proceeding through an orderly and timely reparative process that results in sustained restoration of the anatomic and functional integrity of the skin.</obo:IAO_0000115>
  <term:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-23T09:13:36+00:00</term:date>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">human_phenotype</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HP:0032675</oboI:id>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wound healing accors in multiple overlapping stages, with re=-eipthelialization normally beginning on day one or two. In most clinical settings, closure of acute and chronic wounds is considered the wound healing end point, but wounds can continue to undergo remodeling or tissue maturation for several months or even years.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acute cutaneous wound</rdfs:label>
</owl:Class>

