      <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PR_000001889"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/CL_4030046"/>
