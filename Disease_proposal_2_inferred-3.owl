  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0060562</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">epithelial tube morphogenesis</rdfs:label>
</owl:Class>

