  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Examples: cranium, the ilium, sternum, rib cage, the sacrum and the scapula; the occipital, parietal, frontal, nasal, lacrimal, vomer, scapula, os coxC&amp;, sternum, and ribs</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">flat bone</rdfs:label>
</owl:Class>

