  <oboI:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stimulation of cardioblast differentiation</oboI:hasNarrowSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological_process</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0051891</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">positive regulation of cardioblast differentiation</rdfs:label>
</owl:Class>

