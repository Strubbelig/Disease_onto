  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">megalokaryocyte</oboI:hasExactSynonym>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Megakaryocytes are reportedly CD181-positive and CD182-positive.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">megakaryocyte</rdfs:label>
</owl:Class>

