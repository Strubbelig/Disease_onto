<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/uberon/core#filtered_through">
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relationship between a fluid and a material entity, where the fluid is the output of a realization of a filtration role that inheres in the material entity.</obo:IAO_0000115>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uberon</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filtered_through</oboI:id>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relationship between a fluid and a filtration barrier, where the portion of fluid arises as a transformation of another portion of fluid on the other side of the barrier, with larger particles removed</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filtered through</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002584">
