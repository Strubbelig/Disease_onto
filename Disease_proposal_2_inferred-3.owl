  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uberon</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBERON:0004357</oboI:id>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genes: In limb buds of chick and mouse, Shh expression is activated as soon as there is a morphological bud, whereas in S. canicula fin buds, consistent with reported data in other cartilaginous fishes, Shh is transcribed late in fin development[PMID:17187056]</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paired limb/fin bud</rdfs:label>
</owl:Class>

