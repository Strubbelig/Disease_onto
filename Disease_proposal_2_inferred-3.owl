  <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">x existence starts during or after y if and only if the time point at which x starts is after or equivalent to the time point at which y starts. Formally: x existence starts during or after y iff α (x) &gt;= α (y).</obo:IAO_0000115>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The relations here were created based on work originally by Fabian Neuhaus and David Osumi-Sutherland. The work has not yet been vetted and errors in definitions may have occurred during transcription.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">existence starts during or after</rdfs:label>
</owl:ObjectProperty>

