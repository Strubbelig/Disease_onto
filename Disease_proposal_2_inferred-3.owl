<owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_8410081">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001981"/>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010523"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any of the smallest blood vessels where blood circulates within organ tissues. Microvessels include terminal arterioles, metarterioles, capillaries, and venules (but exclude lymphatic capillaries). Arterioles carry oxygenated blood to the capillaries, and blood flows out of the capillaries through venules into veins.</obo:IAO_0000115>
  <oboI:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://orcid.org/0000-0002-2825-0621</oboI:created_by>
  <oboI:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">microvasculature</oboI:hasBroadSynonym>
  <oboI:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">microvessel</oboI:hasBroadSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uberon</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBERON:8410081</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blood microvessel</rdfs:label>
</owl:Class>

