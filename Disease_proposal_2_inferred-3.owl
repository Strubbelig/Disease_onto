  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A unit of mass concentration defined as the number of micrograms of a substance per 250 ml Wheaton bottle.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UOB:LTS</oboI:hasDbXref>
</owl:Axiom>

