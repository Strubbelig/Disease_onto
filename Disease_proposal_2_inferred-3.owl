  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The secretory unit of a serous gland. The acinar portion is composed of serous secreting cells.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://orcid.org/0000-0002-6601-2165</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.siumed.edu/~dking2/intro/glands.htm</oboI:hasDbXref>
</owl:Axiom>

