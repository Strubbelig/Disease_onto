  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0061075</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">positive regulation of neural retina development</rdfs:label>
</owl:Class>

