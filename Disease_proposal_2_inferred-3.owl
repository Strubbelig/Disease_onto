<owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002283">
  <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0002279"/>
  <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
