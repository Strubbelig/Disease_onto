    </owl:Restriction>
  </rdfs:subClassOf>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The stroma of the bone marrow is all tissue not directly involved in the primary function of hematopoiesis. The yellow bone marrow belongs here, and makes the majority of the bone marrow stroma, in addition to stromal cells located in the red bone marrow. Yellow bone marrow is found in the Medullary cavity. Still, the stroma is indirectly involved in hematopoiesis, since it provides the hematopoietic microenvironment that facilitates hematopoiesis by the parenchymal cells. For instance, they generate colony stimulating factors, affecting hematopoiesis.</obo:IAO_0000115>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CALOHA:TS-0085</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:21426</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Bone_marrow#Stroma</oboI:hasDbXref>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bone marrow stroma</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uberon</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBERON:0007195</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stroma of bone marrow</rdfs:label>
</owl:Class>

