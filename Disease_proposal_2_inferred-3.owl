  <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Axiomatization to GO to be added later</obo:IAO_0000116>
  <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An interaction relation between x and y in which x catalyzes a reaction in which a phosphate group is added to y.</obo:IAO_0000118>
