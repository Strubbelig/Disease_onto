  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0030048"/>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0099515"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The directed movement of the nucleus along microfilaments within the cell, mediated by motor proteins.</obo:IAO_0000115>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nuclear migration, microfilament-mediated</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological_process</oboI:hasOBONamespace>
