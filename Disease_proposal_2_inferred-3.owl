  </rdfs:subClassOf>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In anatomy, in the occipital bone, the foramen magnum is one of the several oval or circular apertures in the base of the skull, through which the medulla oblongata (an extension of the spinal cord) enters and exits the skull vault. Apart from the transmission of the medulla oblongata and its membranes, the foramen magnum transmits the Spinal Accessory nerve, vertebral arteries, the anterior and posterior spinal arteries, the membrana tectoria and alar ligaments. [WP,unvetted].</obo:IAO_0000115>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAO:0010826</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:75306</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GAID:228</oboI:hasDbXref>
