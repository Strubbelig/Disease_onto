<owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>

<owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002582">
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If R &lt;- P o Q is a defining property chain axiom, then (1) R -&gt; P o Q holds and (2) Q is either reflexive or locally reflexive. A corollary of this is that P SubPropertyOf R.</obo:IAO_0000115>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is a defining property chain axiom where second argument is reflexive</rdfs:label>
</owl:AnnotationProperty>

