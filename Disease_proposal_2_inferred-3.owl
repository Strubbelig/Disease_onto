  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0097746"/>
  <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000409"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A decrease in the diameter of blood vessels, especially arteries, due to constriction of smooth muscle cells that line the vessels, and usually causing an increase in blood pressure.</obo:IAO_0000115>
  <oboI:hasAlternativeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0045908</oboI:hasAlternativeId>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Vasoconstriction</oboI:hasDbXref>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">negative regulation of blood vessel size</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological_process</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GO:0042310</oboI:id>
  <rdfs:label xml:lang="en">Vasoconstriction process</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vasoconstriction</rdfs:label>
</owl:Class>

