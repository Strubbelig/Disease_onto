<owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012399">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0032674"/>
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0200042"/>
  <term:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chronic ulcer of skin where the ulcer is an ulceration of tissue deprived of adequate blood supply by prolonged pressure.</obo:IAO_0000115>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A type of ulcer that is caused when an area of skin is subject to pressure over a prolonged period of time, ranging in range in severity from patches of discolored skin to open wounds that expose the underlying bone or muscle. The most common sites are the sacrum, coccyx, heels and the hips.</obo:IAO_0000115>
  <term:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-11-08T08:49:52+00:00</term:date>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SNOMEDCT_US:399912005</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SNOMEDCT_US:420226006</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C0011127</oboI:hasDbXref>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bedsore</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Decubitus Ulcer</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pressure Sore</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pressure ulcer</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">human_phenotype</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HP:0012399</oboI:id>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pressure ulcers tend to affect persons with reduced mobility who are bedridden or wheelchair-bound.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pressure ulcer</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">decubitus ulcer</rdfs:label>
</owl:Class>

