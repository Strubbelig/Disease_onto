<owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002327">
  <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0002326"/>
  <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
  <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stage IA (FIGO)</obo:IAO_0000111>
  <obo:IAO_0000115 xml:lang="en">An International Federation of Gynecology and Obstetrics cervical cancer stage value specification indicating invasive carcinoma which can be diagnosed only by microscopy, with deepest invasion &lt;5 mm and the largest extension &lt;7 mm.</obo:IAO_0000115>
  <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chris Stoeckert, Helena Ellis</obo:IAO_0000117>
  <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stage IA</obo:IAO_0000118>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Cervical_cancer_staging</obo:IAO_0000119>
  <obo:IAO_0000234 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCI BBRB</obo:IAO_0000234>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stage IA (FIGO)</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002296">
  <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0002290"/>
  <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
  <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pM1a (colon)</obo:IAO_0000111>
  <obo:IAO_0000115 xml:lang="en">A pathologic distant metastases stage for colon according to AJCC 7th edition indicating that metastasis is confined to one organ and histologically confirmed.</obo:IAO_0000115>
  <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chris Stoeckert, Helena Ellis</obo:IAO_0000117>
  <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://staging.seer.cancer.gov/tnm/input/1.0/colon/path_m/</obo:IAO_0000119>
  <obo:IAO_0000234 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCI BBRB</obo:IAO_0000234>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pM1a (colon)</rdfs:label>
</owl:NamedIndividual>

