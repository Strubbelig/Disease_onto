<owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032101">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010978"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-7601-9822"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0001-9382-150X"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0002-2029-0733"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0002-3577-9021"/>
  <term:contributor rdf:resource="https://orcid.org/0000-0002-4315-9105"/>
  <term:contributor rdf:resource="https://orcid.org/0009-0004-8124-8864"/>
  <term:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Increased susceptibility to infection, as manifested by recurrent infection, severe or invasive infection, infection occurring in an unusual anatomical location, or infection with opportunistic organisms, that is unusual for a healthy individual of the same age.</obo:IAO_0000115>
  <term:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-04T22:23:03+00:00</term:date>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">human_phenotype</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HP:0032101</oboI:id>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">There are five general subtypes. (i) Opportunistic infection, meaning infection by a pathogen that is not normally able to cause infection in a healthy host (e.g., pneumonia by Pneumocystis jirovecii or CMV); (ii) Unusual location (focus) of an infection (e.g., an aspergillus brain abscess); (iii) a protracted course or lack of adequate response to treatment (e.g., chronic rhinosinusitis); (iv) Unusual severity or intensity of an infection; and (v) unusual recurrence of infections.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unusual infection</rdfs:label>
</owl:Class>

