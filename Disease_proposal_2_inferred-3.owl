  <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
  <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'mitochondrial transport' results_in_transport_to_from_or_in some  mitochondrion (GO:0005739)</obo:IAO_0000112>
  <rdfs:label xml:lang="en">results in transport to from or in</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0004007">
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
  <oboI:created_by rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
  <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_ontology"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p 'has primary input ot output' c iff either (a) p 'has primary input' c or (b) p 'has primary output' c.</obo:IAO_0000115>
  <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-12-13T11:26:17+00:00</oboI:creation_date>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has primary input or output</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002305">
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002411"/>
  <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0004046"/>
  <obo:RO_0004050 rdf:resource="http://purl.obolibrary.org/obo/RO_0002411"/>
  <term:creator rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
