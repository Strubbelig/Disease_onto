###  https://bioportal.bioontology.org/ontologies/MILD/MILD_120020
:MILD_120020 rdf:type owl:Class ;
             owl:equivalentClass :MILD_120022 ;
             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                               owl:someValuesFrom <http://purl.obolibrary.org/obo/NCBITaxon_9606>
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                               owl:someValuesFrom :MILD_120022
                             ] ;
             owl:disjointWith :MILD_120023 ,
                              :MILD_120054 ;
             <http://purl.obolibrary.org/obo/IAO_0000115> "A material entity that has one or more pathological disorders as parts; which disorders compose one disease is fixed by the diagnostic classification assigned to them, not by an intrinsic unity criterion. Identity is grounded in the continuity of the disorder lineage, not in momentary material composition (cf. a river persisting through complete material replacement)."@en ;
             <http://purl.obolibrary.org/obo/IAO_0000116> "DESIGN RATIONALE - deliberate departure from OGMS. OGMS models disease (OGMS_0000031) as a disposition borne by an organism. MILD does not. Here a disease is a material continuant whose identity is given by the continuity of its disorder lineage, not by a single dispositional potential. Two reasons. (1) Roehl and Jansen show that a disposition-only account breaks on malfunction, because the very disposition said to constitute the disease is the one the bearer has lost. (2) The River Flow Model shows that disease identity persists through complete material replacement, which a single disposition cannot express. MILD keeps what OGMS was built to protect - presymptomatic disease, and the separation of disease from diagnosis and from manifestation - via MILD_120022 pathological disorder under OGMS_0000045 disorder, and via the diagnosis and classification layers. OGMS_0000031 is therefore related but NOT equivalent, and is deliberately not asserted as a parent of this class."@en ;
             <http://purl.org/dc/elements/1.1/description> "A material entity that has one or more pathological disorders as parts; which disorders compose one disease is fixed by the diagnostic classification assigned to them, not by an intrinsic unity criterion. Identity is grounded in the continuity of the disorder lineage, not in momentary material composition (cf. a river persisting through complete material replacement)."@en ;
             rdfs:comment "A named disease expression may be used for a material disease entity only when it denotes an individual pathological organization in a patient, not merely a diagnostic category, criterion set, behaviour, or social/legal classification. For example, a material substance use disorder case would require a stable pathological neuropsychological organization grounding impaired control and disease course processes; the substance itself and isolated use events are not material disease entities."@en ;
             rdfs:label "material disease entity"@en ;
             <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://purl.obolibrary.org/obo/OGMS_0000031> .


###  https://bioportal.bioontology.org/ontologies/MILD/MILD_120021
:MILD_120021 rdf:type owl:Class ;
             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/RO_0002234> ;
                               owl:someValuesFrom :MILD_120022
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :MILD_120085 ;
                               owl:someValuesFrom :MILD_120031
                             ] ;
             <http://purl.obolibrary.org/obo/IAO_0000115> "A process that has as output a pathological disorder and that has as its end boundary a threshold crossing event."@en ;
             <http://purl.obolibrary.org/obo/IAO_0000118> "disease development process"@en ;
             rdfs:comment "Deliberately no input mandatory. A pre-existing disorder as input would be false for de novo disease (the first disorder has no disorder input)."@en ;
             rdfs:label "disorder development process"@en .


###  https://bioportal.bioontology.org/ontologies/MILD/MILD_120022
:MILD_120022 rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/BFO_0000040>
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.obolibrary.org/obo/RO_0000086> ;
                                                          owl:someValuesFrom :MILD_000600
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                               owl:someValuesFrom <http://purl.obolibrary.org/obo/NCBITaxon_9606>
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                               owl:someValuesFrom :MILD_120020
                             ] ;
             owl:disjointWith :MILD_120023 ,
                              :MILD_120024 ;
             <http://purl.obolibrary.org/obo/IAO_0000115> "a disorder is an abnormal presence or organization of material components — including the limiting case where the abnormal organization consists in a normally-present component being absent."@en ;
             <http://purl.org/dc/elements/1.1/description> "Pathologicity is asserted - not inferred -  by primitives (e.g. threat to life, pain/suffering, loss of ability/fertility) as mentioned by Hucklenbroich et al."@en ;
             rdfs:comment "A pathological disorder should not be identified with a merely voluntary, transient, and immediately reversible functional deviation. In substance use disorder cases, the candidate pathological disorder is the relatively stable neurobiological or neuropsychological organization that grounds impaired control, craving, tolerance, withdrawal tendency, or harmful recurrence, not a single act of substance use."@en ,
                          "ExO_0000079 is reused as a comparison anchor rather than as the MILD disease definition: pathological disorder may involve abnormal functioning, abnormal localization of normal functioning, or abnormal localization/organization of constituents relative to relevant members of the same species. Species-comparative abnormality is not sufficient by itself, because rare variation is not automatically pathological."@en ;
             rdfs:label "pathological disorder"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "a disorder is an abnormal presence or organization of material components — including the limiting case where the abnormal organization consists in a normally-present component being absent."@en .


###  https://bioportal.bioontology.org/ontologies/MILD/MILD_120023
:MILD_120023 rdf:type owl:Class ;
             rdfs:subClassOf [ owl:intersectionOf ( :MILD_120005
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000197> ;
                                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/NCBITaxon_9606>
                                                    ]
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :MILD_120094 ;
                                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
             <http://purl.obolibrary.org/obo/IAO_0000115> "A tendency inhering in a person, grounded in a material basis, whose realization may produce a target pathological disorder."@en ;
             <http://purl.obolibrary.org/obo/IAO_0000118> "Predisposition / risk proper"@en ;
             <http://purl.org/dc/elements/1.1/description> "A tendency inhering in a person, grounded in a material basis, whose realization may produce a target pathological disorder."@en ;
             rdfs:label "disease predisposition"@en .


###  https://bioportal.bioontology.org/ontologies/MILD/MILD_120024
:MILD_120024 rdf:type owl:Class ;
