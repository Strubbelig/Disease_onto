                               owl:someValuesFrom :MILD_120047
                             ] ;
             <http://purl.obolibrary.org/obo/IAO_0000115> "An information content entity that classifies or groups one or more pathological disorders according to diagnostic criteria. Names such as 'substance use disorder' can denote this diagnostic layer when used as DSM/ICD-style categories or results; this diagnostic use is distinct from any material disease entity in the patient."@en ;
             <http://purl.obolibrary.org/obo/IAO_0000118> "diagnosis"@en ;
             <http://purl.org/dc/elements/1.1/description> "An information content entity that classifies or groups one or more pathological disorders according to diagnostic criteria. Names such as 'substance use disorder' can denote this diagnostic layer when used as DSM/ICD-style categories or results; this diagnostic use is distinct from any material disease entity in the patient."@en ;
             rdfs:label "disease diagnostic result"@en .


