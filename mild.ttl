###  https://bioportal.bioontology.org/ontologies/MILD/MILD_120085
:MILD_120085 rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000051> ;
             rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
             rdfs:range <http://purl.obolibrary.org/obo/BFO_0000035> ;
             owl:propertyChainAxiom ( <http://purl.obolibrary.org/obo/BFO_0000199>
                                      <http://purl.obolibrary.org/obo/BFO_0000224>
                                      :MILD_120081
                                    ) ;
