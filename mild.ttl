###  https://bioportal.bioontology.org/ontologies/MILD/MILD_120001
:MILD_120001 rdf:type owl:Class ;
             rdfs:subClassOf :MILD_120020 ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000056> ;
                               owl:someValuesFrom :MILD_120028
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/RO_0002353> ;
                               owl:someValuesFrom :MILD_120021
                             ] ;
             <http://purl.obolibrary.org/obo/IAO_0000115> "A disease whose disorders had to develop."@en ;
             <http://purl.org/dc/elements/1.1/description> "A disease whose disorders had to develop."@en ;
             rdfs:label "Developed material disease entity"@en .


###  https://bioportal.bioontology.org/ontologies/MILD/MILD_120005
:MILD_120005 rdf:type owl:Class ;
             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000197> ;
                               owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                             ] ;
             <http://purl.obolibrary.org/obo/IAO_0000115> "A realizable entity that inheres in a material entity and that, in virtue of the physical makeup of its bearer, inclines that bearer toward participating in processes of a certain type — such that the inclination raises the objective probability of, but does not necessitate, the occurrence of those processes; that may be counteracted or reinforced by other tendencies of the same bearer without thereby ceasing to exist; and that may be realized to varying degrees, or not at all."@en ;
             rdfs:comment "A tendency is distinguished from a disposition not by its bearer or by requiring a material basis — both inhere in a material entity and supervene on its physical makeup — but by its mode of realization: a disposition, once its trigger conditions obtain, is realized; a tendency only probabilistically and partially inclines toward realization and can be opposed by competing tendencies. It is therefore modelled as a sibling of disposition, function, and role under realizable entity, not as a subtype of disposition."@en ;
             rdfs:label "tendency"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A realizable entity that inheres in a material entity and that, in virtue of the physical makeup of its bearer, inclines that bearer toward participating in processes of a certain type — such that the inclination raises the objective probability of, but does not necessitate, the occurrence of those processes; that may be counteracted or reinforced by other tendencies of the same bearer without thereby ceasing to exist; and that may be realized to varying degrees, or not at all."@en .


###  https://bioportal.bioontology.org/ontologies/MILD/MILD_120007
:MILD_120007 rdf:type owl:Class ;
             rdfs:subClassOf :MILD_120020 ;
             rdfs:comment "Disorder asserted but not yet characterized; defined operationally at the classification layer."@en ;
