        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>kilogram</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000010 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/UO_0000010">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/UO_0000003"/>
        <obo:IAO_0000111>second</obo:IAO_0000111>
        <obo:IAO_0000115>A time unit which is equal to the duration of 9 192 631 770 periods of the radiation corresponding to the transition between the two hyperfine levels of the ground state of the caesium 133 atom.</obo:IAO_0000115>
        <obo:IAO_0000118>s</obo:IAO_0000118>
        <obo:IAO_0000118>sec</obo:IAO_0000118>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
        <rdfs:label>second</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000015 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/UO_0000015">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/UO_0000001"/>
