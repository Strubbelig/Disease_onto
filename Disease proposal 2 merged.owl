    <!-- http://purl.obolibrary.org/obo/UO_0000017 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/UO_0000017">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/UO_0000001"/>
        <obo:IAO_0000111>micrometer</obo:IAO_0000111>
        <obo:IAO_0000115>A length unit which is equal to one millionth of a meter or 10^[-6] m.</obo:IAO_0000115>
