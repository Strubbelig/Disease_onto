    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0050878"/>
        <obo:IAO_0000115>The stopping of bleeding (loss of body fluid) or the arrest of the circulation to an organ or part.</obo:IAO_0000115>
