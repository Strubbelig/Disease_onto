    <!-- http://purl.obolibrary.org/obo/OBI_0002245 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002245">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0002243"/>
        <obo:IAO_0000111>pT1 (kidney)</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
