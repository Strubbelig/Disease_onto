    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120093 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000012"/>
        <obo:IAO_0000115 xml:lang="en">A healthcare provider role that inheres in a person in virtue of that person being licensed to practise medicine.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">Relocated from WONT_0000090 when the MILD/WONT import direction was reversed: a physician role is not wound-specific, is not used by any WONT class, and its only consumer is the MILD treatment-plan axiom. Reuse an OMRSE physician-role class here if an OMRSE module is later added.</rdfs:comment>
        <rdfs:label xml:lang="en">Physician role</rdfs:label>
    </owl:Class>
    


