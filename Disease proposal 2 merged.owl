        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The flow of blood through the body of an animal, enabling the transport of nutrients to the tissues and the removal of waste products.</owl:annotatedTarget>
