                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A disease predisposition that has as material basis a pathogenic genetic variant.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">pathological genetic predisposition</rdfs:label>
    </owl:Class>
    


