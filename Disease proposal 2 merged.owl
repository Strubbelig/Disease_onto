    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050426 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050426">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_37"/>
        <obo:IAO_0000115 xml:lang="en">A skin disease that is characterized by ulceration of less than 10 percent of the surface area of the body. The disease is often precipitated by the use of medications, such as antibiotics or antiepileptics, or onset of infection.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EFO:0004276</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GARD:7700</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:L51.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:695.13</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D013262</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C79484</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:73442001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0038325</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050426</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">Stevens-Johnson syndrome</rdfs:label>
        <skos:exactMatch>MESH:D013262</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050426"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A skin disease that is characterized by ulceration of less than 10 percent of the surface area of the body. The disease is often precipitated by the use of medications, such as antibiotics or antiepileptics, or onset of infection.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Stevens%E2%80%93Johnson_syndrome</oboInOwl:hasDbXref>
    </owl:Axiom>
    


