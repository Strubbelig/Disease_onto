    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120014 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120014">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120023"/>
        <rdfs:subClassOf>
