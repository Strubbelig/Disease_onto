        <oboInOwl:hasAlternativeId>DOID:5256</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:945</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:95</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:9532</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:9696</oboInOwl:hasAlternativeId>
