        <oboInOwl:hasDbXref>UMLS_CUI:C0001485</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">infectious disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050117</oboInOwl:id>
