                                                                                          "James Malone"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "top-down hierarchical clustering" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: Elisabetta Manduchi"@en ;
                                             rdfs:label "divisive hierarchical clustering"@en .


