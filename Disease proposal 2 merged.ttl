###  http://purl.obolibrary.org/obo/OBI_0200176
<http://purl.obolibrary.org/obo/OBI_0200176> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000673> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0000675>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "Fisher's exact test" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000123> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "Fisher's exact test is a data transformation used to determine if there are nonrandom associations between two Fisher's exact test is a statistical significance test used in the analysis of contingency tables where sample sizes are small where the significance of the deviation from a null hypothesis can be calculated exactly, rather than relying on an approximation that becomes exact in the limit as the sample size grows to infinity, as with many statistical tests."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "James Malone" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "WEB:http://mathworld.wolfram.com/FishersExactTest.html" ;
                                             rdfs:label "Fisher's exact test" .


###  http://purl.obolibrary.org/obo/OBI_0200177
<http://purl.obolibrary.org/obo/OBI_0200177> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200166> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "center calculation objective"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "A mean calculation which has center calculation objective is a data transformation in which the center of the input data is discovered through the calculation of a mean average."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A center calculation objective is a data transformation objective where the aim is to calculate the center of an input data set."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "James Malone"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: James Malone" ;
                                             rdfs:label "center calculation objective"@en .


###  http://purl.obolibrary.org/obo/OBI_0200178
<http://purl.obolibrary.org/obo/OBI_0200178> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200166> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "class discovery objective"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A class discovery objective (sometimes called unsupervised classification) is a data transformation objective where the aim is to organize input data  (typically vectors of attributes) into classes, where the number of classes and their specifications are not known a priori. Depending on usage, the class assignment can be definite or probabilistic."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "James Malone"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "clustering objective" ,
                                                                                          "discriminant analysis objective"@en ,
                                                                                          "unsupervised classification objective"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: Elisabetta Manduchi" ,
                                                                                          "PERSON: James Malone" ;
                                             rdfs:label "class discovery objective"@en .


###  http://purl.obolibrary.org/obo/OBI_0200179
<http://purl.obolibrary.org/obo/OBI_0200179> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200166> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "class prediction objective"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> """A class prediction objective (sometimes called supervised classification) is a data transformation objective where the aim is to create a predictor from training data through a machine learning technique. The training data consist of pairs of objects (typically vectors of attributes) and
class labels for these objects. The resulting predictor can be used to attach class labels to any valid novel input object. Depending on usage, the prediction can be definite or probabilistic. A classification is learned from the training data and can then be tested on test data."""@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "James Malone"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "classification objective" ,
                                                                                          "supervised classification objective"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: Elisabetta Manduchi" ,
                                                                                          "PERSON: James Malone" ;
                                             rdfs:label "class prediction objective"@en .


###  http://purl.obolibrary.org/obo/OBI_0200180
<http://purl.obolibrary.org/obo/OBI_0200180> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200166> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "spread calculation objective"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Spread calculation can be achieved by use of a standard deviation, which measures distance from the mean" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000123> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "is a data transformation objective whereby the aim is to the calculate the spread of a dataset, spread is a descriptive statistic which describes the variability of values in a data set."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Awaiting English definition from Monnie McGee"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "James Malone"@en ,
                                                                                          "Person:Helen Parkinson" ;
                                             rdfs:label "spread calculation objective"@en .


