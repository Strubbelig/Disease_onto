###  http://purl.obolibrary.org/obo/OBI_0000819
<http://purl.obolibrary.org/obo/OBI_0000819> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0302893> ,
