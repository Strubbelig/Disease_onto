###  http://purl.obolibrary.org/obo/OBI_0200079
<http://purl.obolibrary.org/obo/OBI_0200079> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200170> ,
                                                             <http://purl.obolibrary.org/obo/OBI_0200181> ,
                                                             <http://purl.obolibrary.org/obo/OBI_0200184> ,
