###  http://purl.obolibrary.org/obo/OBI_0001064
<http://purl.obolibrary.org/obo/OBI_0001064> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/COB_0001300> ,
