                                            rdfs:range <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "x lumen_of y iff x is the space or substance that is part of y and does not cross any of the inner membranes or boundaries of y that is maximal with respect to the volume of the convex hull." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-6601-2165> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000119> <https://orcid.org/0000-0002-6601-2165> ;
