###  http://purl.obolibrary.org/obo/GO_0019814
<http://purl.obolibrary.org/obo/GO_0019814> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0032991> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "immunoglobulin complex" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A protein complex that in its canonical form is composed of two identical immunoglobulin heavy chains and two identical immunoglobulin light chains, held together by disulfide bonds and sometimes complexed with additional proteins. An immunoglobulin complex may be embedded in the plasma membrane or present in the extracellular space, in mucosal areas or other tissues, or circulating in the blood or lymph." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "immunoglobulin complex" .


###  http://purl.obolibrary.org/obo/GO_0019815
<http://purl.obolibrary.org/obo/GO_0019815> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_1110022> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "B cell receptor complex" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "An immunoglobulin complex that is present in the plasma membrane of B cells and that in its canonical form is composed of two identical immunoglobulin heavy chains and two identical immunoglobulin light chains and a signaling subunit, a heterodimer of the Ig-alpha and Ig-beta proteins." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "B cell receptor complex" .


###  http://purl.obolibrary.org/obo/GO_0019835
<http://purl.obolibrary.org/obo/GO_0019835> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0009987> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "cytolysis" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The rupture of cell membranes and the loss of cytoplasm." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "cytolysis" .


###  http://purl.obolibrary.org/obo/GO_0019882
<http://purl.obolibrary.org/obo/GO_0019882> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "antigen processing and presentation" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The process in which an antigen-presenting cell expresses antigen (peptide or lipid) on its cell surface in association with an MHC protein complex." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "antigen processing and presentation" .


