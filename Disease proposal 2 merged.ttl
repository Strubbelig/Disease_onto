                                             <http://purl.obolibrary.org/obo/IAO_0000116> "different types of telemeters can measure blood pressure, gross activity, heart rate, ECG, glucose and other physiological parameters." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Jennifer Fostel" ;
                                             rdfs:label "telemeter sensor detection assay" .


