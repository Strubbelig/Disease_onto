                                                                                      owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0000791>
                                                                                    ]
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "quantile number of false positives correction method"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A quantile number of false positives correction method is a MTP that controls for the pth quantile of the distribution of the number of false positives out of the total number of tests performed'"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Monnie McGee" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "QNFP"@en ;
