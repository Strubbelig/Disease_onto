 ] .


###  http://purl.obolibrary.org/obo/UBERON_0000467
<http://purl.obolibrary.org/obo/UBERON_0000467> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000062>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Multicellular, connected anatomical structure that has multiple organs as parts and whose parts work together to achieve some shared function." ;
                                                rdfs:label "anatomical system" .


###  http://purl.obolibrary.org/obo/UBERON_0000473
<http://purl.obolibrary.org/obo/UBERON_0000473> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000062> ;
                                                owl:disjointWith <http://purl.obolibrary.org/obo/UBERON_0000992> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A gonad of a male animal. A gonad produces and releases sperm." ;
                                                rdfs:label "testis" .


###  http://purl.obolibrary.org/obo/UBERON_0000477
<http://purl.obolibrary.org/obo/UBERON_0000477> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000465> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Anatomical group whose component anatomical structures lie in close proximity to each other." ;
                                                rdfs:label "anatomical cluster" .


###  http://purl.obolibrary.org/obo/UBERON_0000479
<http://purl.obolibrary.org/obo/UBERON_0000479> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Multicellular anatomical structure that consists of many cells of one or a few types, arranged in an extracellular matrix such that their long-range organisation is at least partly a repetition of their short-range organisation." ;
                                                rdfs:label "tissue" .


###  http://purl.obolibrary.org/obo/UBERON_0000481
<http://purl.obolibrary.org/obo/UBERON_0000481> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000479>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Anatomical structure that has as its parts two or more portions of tissue of at least two different types and which through specific morphogenetic processes forms a single distinct structural unit demarcated by bona-fide boundaries from other distinct structural units of different types." ;
                                                rdfs:label "multi-tissue structure" .


###  http://purl.obolibrary.org/obo/UBERON_0000483
<http://purl.obolibrary.org/obo/UBERON_0000483> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000479> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000061>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Portion of tissue, that consists of one or more layers of epithelial cells connected to each other by cell junctions and which is underlain by a basal lamina. Examples: simple squamous epithelium, glandular cuboidal epithelium, transitional epithelium, myoepithelium[CARO]." ;
                                                rdfs:label "epithelium" .


###  http://purl.obolibrary.org/obo/UBERON_0000945
<http://purl.obolibrary.org/obo/UBERON_0000945> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000062> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000062>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001555>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "An expanded region of the vertebrate alimentary tract that serves as a food storage compartment and digestive organ. A stomach is lined, in whole or in part by a glandular epithelium." ;
                                                rdfs:label "stomach" .


###  http://purl.obolibrary.org/obo/UBERON_0000947
<http://purl.obolibrary.org/obo/UBERON_0000947> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0001981> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000467>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The main trunk of the systemic arterial system that carries blood from the heart to all the organs and other structures of the body, bringing oxygenated blood to all parts of the body in the systemic circulation." ;
                                                rdfs:label "aorta" .


###  http://purl.obolibrary.org/obo/UBERON_0000948
<http://purl.obolibrary.org/obo/UBERON_0000948> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000062> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A myogenic muscular circulatory organ found in the vertebrate cardiovascular system composed of chambers of cardiac muscle. It is the primary circulatory organ." ;
                                                rdfs:label "heart" .


###  http://purl.obolibrary.org/obo/UBERON_0000955
<http://purl.obolibrary.org/obo/UBERON_0000955> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000062> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The brain is the center of the nervous system in all vertebrate, and most invertebrate, animals. Some primitive animals such as jellyfish and starfish have a decentralized nervous system without a brain, while sponges lack any nervous system at all. In vertebrates, the brain is located in the head, protected by the skull and close to the primary sensory apparatus of vision, hearing, balance, taste, and smell[WP]." ;
                                                rdfs:label "brain" .


###  http://purl.obolibrary.org/obo/UBERON_0000956
<http://purl.obolibrary.org/obo/UBERON_0000956> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000467>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The thin layer of gray matter on the surface of the cerebral hemisphere that develops from the telencephalon. It consists of the neocortex (6 layered cortex or isocortex), the hippocampal formation and the olfactory cortex." ;
                                                rdfs:label "cerebral cortex" .


###  http://purl.obolibrary.org/obo/UBERON_0000970
<http://purl.obolibrary.org/obo/UBERON_0000970> rdf:type owl:Class ;
