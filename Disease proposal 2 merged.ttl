                                             <http://purl.obolibrary.org/obo/IAO_0000111> "document title"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Textual characteristics of traditional and Open Access scientific journals are similar"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A textual entity that names a document"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON: Lawrence Hunter"@en ;
                                             rdfs:label "document title"@en .


###  http://purl.obolibrary.org/obo/IAO_0000306
<http://purl.obolibrary.org/obo/IAO_0000306> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000300> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "table"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> """| T     F
--+-----
T   | T     F
F   |  F    F"""@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A textual entity that contains a two-dimensional arrangement of texts repeated at regular intervals across a spatial range, such that the spatial relationships among the constituent texts expresses propositions"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON: Lawrence Hunter"@en ;
                                             rdfs:label "table"@en .


