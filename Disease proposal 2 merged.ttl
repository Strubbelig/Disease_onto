<http://purl.obolibrary.org/obo/GO_0019904> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0001588> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "protein domain specific binding" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Binding to a specific domain of a protein." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "protein domain specific binding" .


###  http://purl.obolibrary.org/obo/GO_0021700
<http://purl.obolibrary.org/obo/GO_0021700> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "developmental maturation" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A developmental process, independent of morphogenetic (shape) change, that is required for an anatomical structure, cell or cellular component to attain its fully functional state." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "developmental maturation" .


###  http://purl.obolibrary.org/obo/GO_0022414
<http://purl.obolibrary.org/obo/GO_0022414> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "reproductive process" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A biological process that directly contributes to the process of producing new individuals by one or two organisms. The new individuals inherit some proportion of their genetic material from the parent or parents." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "reproductive process" .


###  http://purl.obolibrary.org/obo/GO_0030041
<http://purl.obolibrary.org/obo/GO_0030041> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "actin filament polymerization" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Assembly of actin filaments by the addition of actin monomers to a filament." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "actin filament polymerization" .


###  http://purl.obolibrary.org/obo/GO_0030097
<http://purl.obolibrary.org/obo/GO_0030097> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "hemopoiesis" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The process whose specific outcome is the progression of the myeloid and lymphoid derived organ/tissue systems of the blood and other parts of the body over time, from formation to the mature structure. The site of hemopoiesis is variable during development, but occurs primarily in bone marrow or kidney in many adult vertebrates." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "hemopoiesis" .


###  http://purl.obolibrary.org/obo/GO_0030154
<http://purl.obolibrary.org/obo/GO_0030154> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0048869> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "cell differentiation" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The cellular developmental process in which a relatively unspecialized cell, e.g. embryonic or regenerative cell, acquires specialized structural and/or functional features that characterize a specific cell. Differentiation includes the processes involved in commitment of a cell to a specific fate and its subsequent development to the mature state." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "cell differentiation" .


###  http://purl.obolibrary.org/obo/GO_0030182
<http://purl.obolibrary.org/obo/GO_0030182> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0030154> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "neuron differentiation" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The process in which a relatively unspecialized cell acquires specialized features of a neuron." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "neuron differentiation" .


###  http://purl.obolibrary.org/obo/GO_0031175
<http://purl.obolibrary.org/obo/GO_0031175> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0009987> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "neuron projection development" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The process whose specific outcome is the progression of a neuron projection over time, from its formation to the mature structure. A neuron projection is any process extending from a neural cell, such as axons or dendrites (collectively called neurites)." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "neuron projection development" .


###  http://purl.obolibrary.org/obo/GO_0032601
<http://purl.obolibrary.org/obo/GO_0032601> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0001816> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "connective tissue growth factor production" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The appearance of connective tissue growth factor due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "connective tissue growth factor production" .


###  http://purl.obolibrary.org/obo/GO_0032602
<http://purl.obolibrary.org/obo/GO_0032602> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0001816> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "chemokine production" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The appearance of a chemokine due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels. All chemokines possess a number of conserved cysteine residues involved in intramolecular disulfide bond formation. Some chemokines are considered pro-inflammatory and can be induced during an immune response to recruit cells of the immune system to a site of infection, while others are considered homeostatic and are involved in controlling the migration of cells during normal processes of tissue maintenance or development. Chemokines are found in all vertebrates, some viruses and some bacteria." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "chemokine production" .


###  http://purl.obolibrary.org/obo/GO_0032604
<http://purl.obolibrary.org/obo/GO_0032604> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0001816> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "granulocyte macrophage colony-stimulating factor production" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The appearance of granulocyte macrophage colony-stimulating factor due to biosynthesis or secretion following a cellular stimulus, resulting in an increase in its intracellular or extracellular levels." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "granulocyte macrophage colony-stimulating factor production" .


