                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An actively-shielded superconducting magnet from Bruker that combines Bruker BioSpin's advanced, proprietary UltraShield active shielding and UltraStabilized sub-cooling technologies. This shielded and stabilized (US2) magnet system delivers high sensitivity and spectral dispersion."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON:Daniel Schober" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "WEB:<http://www.bruker-biospin.com/nmr_magnets_950us2.html>" ,
                                                                                          "http://msi-ontology.sourceforge.net/ontology/NMR.owl#msi_400189" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000232> "NMR instrument" ;
                                             rdfs:label "Bruker US 2 NMR magnet" .


###  http://purl.obolibrary.org/obo/OBI_0000468
<http://purl.obolibrary.org/obo/OBI_0000468> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000038> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "protein column" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A protein column is a chromatography column used for the separation of complex protein mixtures. Protein columns enable sample desalting, followed by chromatographic separation or fractionation of complex protein samples, e.g. immunodepleted serum or plasma proteins."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON:Daniel Schober" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "GROUP:<http://msi-ontology.sourceforge.net>" ,
                                                                                          "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01238" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000232> "refactor as defined class" ;
                                             rdfs:label "protein column" .


###  http://purl.obolibrary.org/obo/OBI_0000469
<http://purl.obolibrary.org/obo/OBI_0000469> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000485> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "solvent mixer" ;
