                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A correction objective is a data transformation objective where the aim is to correct for error, noise or other impairments to the input of the data transformation or derived from the data transformation itself"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "James Malone"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: James Malone" ,
                                                                                          "PERSON: Melanie Courtot" ;
                                             rdfs:label "correction objective"@en .


