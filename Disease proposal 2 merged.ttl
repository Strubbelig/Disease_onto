                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/COB_0000013> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "cholesterol" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A cholestanoid consisting of cholestane having a double bond at the 5,6-position as well as a 3β-hydroxy group." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/chebi.owl> ;
                                             rdfs:label "cholesterol" .


