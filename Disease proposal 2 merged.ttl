###  http://www.geneontology.org/formats/oboInOwl#source
<http://www.geneontology.org/formats/oboInOwl#source> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#isDefinedBy
rdfs:isDefinedBy rdf:type owl:AnnotationProperty ;
                 <http://purl.obolibrary.org/obo/IAO_0000589> "is defined by" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource rdfs:isDefinedBy ;
   owl:annotatedProperty <http://purl.obolibrary.org/obo/IAO_0000589> ;
   owl:annotatedTarget "is defined by" ;
   rdfs:comment "This is an experimental annotation"
 ] .


###  http://www.w3.org/2000/01/rdf-schema#label
