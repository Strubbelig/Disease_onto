                                             rdfs:label "denaturing" .


###  http://purl.obolibrary.org/obo/OBI_0000804
<http://purl.obolibrary.org/obo/OBI_0000804> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/COB_0000035> ,
