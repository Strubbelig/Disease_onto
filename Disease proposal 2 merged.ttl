###  http://purl.obolibrary.org/obo/OBI_0002176
<http://purl.obolibrary.org/obo/OBI_0002176> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000070> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "electrophysiology assay" ;
