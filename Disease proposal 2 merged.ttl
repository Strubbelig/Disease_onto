                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An assay that detects and identifies chemical entities resulting from biochemical and cellular metabolism"@en ;
