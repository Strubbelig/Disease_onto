                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Joint fluid is a transudate of plasma that is actively secreted by synovial cells." ;
                                                rdfs:label "synovial fluid" .


###  http://purl.obolibrary.org/obo/UBERON_0001103
<http://purl.obolibrary.org/obo/UBERON_0001103> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000062> ,
                                                                [ rdf:type owl:Restriction ;
