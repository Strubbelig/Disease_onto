                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A capillary column is a thin tube with a small inner diameter, usually around 0.5 mm."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON:Daniel Schober" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "GROUP:<http://msi-ontology.sourceforge.net>" ,
                                                                                          "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01066" ;
                                             rdfs:label "capillary column" .


###  http://purl.obolibrary.org/obo/OBI_0000497
<http://purl.obolibrary.org/obo/OBI_0000497> rdf:type owl:Class ;
