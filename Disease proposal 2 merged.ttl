###  http://purl.obolibrary.org/obo/RO_0002248
<http://purl.obolibrary.org/obo/RO_0002248> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                            owl:inverseOf <http://purl.obolibrary.org/obo/RO_0002249> ;
