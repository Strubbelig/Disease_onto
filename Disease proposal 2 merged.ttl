                                             <http://purl.obolibrary.org/obo/IAO_0000119> "WEB: http://en.wikipedia.org/wiki/Pipeline_%28software%29" ;
                                             <http://purl.org/dc/elements/1.1/source> "NIAID GSCID-BRC" ;
                                             rdfs:label "software pipeline"@en .


