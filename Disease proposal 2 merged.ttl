                                           rdfs:subClassOf <http://purl.obolibrary.org/obo/WOND_0000194> ;
                                           <http://purl.obolibrary.org/obo/IAO_0000115> "A contact dermatitis that is an allergic skin reaction to foreign chemical or substances leading to red, itchy, weepy reaction where the skin has come into contact with a substance that the immune system recognizes as foreign." ;
                                           rdfs:label "Allergic contact dermatitis" ,
                                                      "allergic contact dermatitis" .


