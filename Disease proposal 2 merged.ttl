###  http://purl.obolibrary.org/obo/OBI_0001943
<http://purl.obolibrary.org/obo/OBI_0001943> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000104> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "software pipeline"@en ;
