                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002244> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A broad relationship between an exposure event or process and any entity (e.g., an organism, organism population, or an organism part) that interacts with an exposure stimulus during the exposure event." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000119> "ExO:0000001" ;
                                            rdfs:label "has exposure receptor" .


