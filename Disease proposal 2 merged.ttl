                                             <http://purl.obolibrary.org/obo/IAO_0000111> "data vector reduction objective"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "Data vector reduction is a data transformation objective in which k m-dimensional input vectors are reduced to j m-dimensional output vectors, where j is smaller than k."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "James Malone" ,
                                                                                          "Richard H. Scheuermann"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: Richard H. Scheuermann"@en ;
                                             rdfs:label "data vector reduction objective"@en .


###  http://purl.obolibrary.org/obo/OBI_0200160
<http://purl.obolibrary.org/obo/OBI_0200160> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200089> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
