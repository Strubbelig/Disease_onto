                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000312> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200000>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "operational taxonomic unit matrix"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "http://www.ncbi.nlm.nih.gov/pmc/articles/PMC1610290/"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "Operational Taxonomic Unit matrix  is a data item, organized as a table, where organismal taxonomic units, computed by sequence analysis and genetic distance calculation, are counted in a set of biological or environmental samples. The table is  used to appraise biodiversity of a population or community of living organism."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON:Philippe Rocca-Serra"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PRS for OBI"@en ;
                                             rdfs:label "operational taxonomic unit matrix"@en .


###  http://purl.obolibrary.org/obo/OBI_0001969
<http://purl.obolibrary.org/obo/OBI_0001969> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000015> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "biodiversity assessment objective"@en ;
