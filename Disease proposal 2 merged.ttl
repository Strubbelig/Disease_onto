                                                                                                         "AEO:0000006" ,
                                                                                                         "BILA:0000006" ,
                                                                                                         "CARO:0000006" ,
                                                                                                         "EHDAA2:0003006" ,
                                                                                                         "FMA:67165" ,
                                                                                                         "HAO:0000006" ,
                                                                                                         "TAO:0001836" ,
                                                                                                         "TGMA:0001826" ,
                                                                                                         "VHOG:0001721" ;
                                                <http://www.geneontology.org/formats/oboInOwl#id> "UBERON:0000465" ;
                                                <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/uberon/core#common_anatomy> ,
                                                                                                        <http://purl.obolibrary.org/obo/uberon/core#human_subset> ,
                                                                                                        <http://purl.obolibrary.org/obo/uberon/core#mouse_subset> ,
                                                                                                        <http://purl.obolibrary.org/obo/uberon/core#upper_level> ;
                                                rdfs:label "material anatomical entity" .

