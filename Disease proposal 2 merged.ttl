###  http://purl.obolibrary.org/obo/GO_0005694
<http://purl.obolibrary.org/obo/GO_0005694> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0005575> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "chromosome" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A structure composed of a very long molecule of DNA and associated proteins (e.g. histones) that carries hereditary information." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "chromosome" .


###  http://purl.obolibrary.org/obo/GO_0005739
<http://purl.obolibrary.org/obo/GO_0005739> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0043227> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "mitochondrion" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A semiautonomous, self replicating organelle that occurs in varying numbers, shapes, and sizes in the cytoplasm of virtually all eukaryotic cells. It is notably the site of tissue respiration." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "mitochondrion" .


###  http://purl.obolibrary.org/obo/GO_0006006
<http://purl.obolibrary.org/obo/GO_0006006> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "glucose metabolic process" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The chemical reactions and pathways involving glucose, the aldohexose gluco-hexose. D-glucose is dextrorotatory and is sometimes known as dextrose; it is an important source of energy for living organisms and is found free as well as combined in homo- and hetero-oligosaccharides and polysaccharides." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "glucose metabolic process" .


###  http://purl.obolibrary.org/obo/GO_0006260
<http://purl.obolibrary.org/obo/GO_0006260> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "DNA replication" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The cellular metabolic process in which a cell duplicates one or more molecules of DNA. DNA replication begins when specific sequences, known as origins of replication, are recognized and bound by the origin recognition complex, and ends when the original DNA molecule has been completely duplicated and the copies topologically separated. The unit of replication usually corresponds to the genome of the cell, an organelle, or a virus. The template for replication can either be an existing DNA molecule or RNA." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "DNA replication" .


###  http://purl.obolibrary.org/obo/GO_0006282
<http://purl.obolibrary.org/obo/GO_0006282> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "regulation of DNA repair" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Any process that modulates the frequency, rate or extent of DNA repair." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "regulation of DNA repair" .


###  http://purl.obolibrary.org/obo/GO_0006338
<http://purl.obolibrary.org/obo/GO_0006338> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0009987> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "chromatin remodeling" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A dynamic process of chromatin reorganization resulting in changes to chromatin structure. These changes allow DNA metabolic processes such as transcriptional regulation, DNA recombination, DNA repair, and DNA replication." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "chromatin remodeling" .


###  http://purl.obolibrary.org/obo/GO_0006909
<http://purl.obolibrary.org/obo/GO_0006909> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "phagocytosis" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A vesicle-mediated transport process that results in the engulfment of external particulate material by phagocytes and their delivery to the lysosome. The particles are initially contained within phagocytic vacuoles (phagosomes), which then fuse with primary lysosomes to effect digestion of the particles." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "phagocytosis" .


###  http://purl.obolibrary.org/obo/GO_0006915
<http://purl.obolibrary.org/obo/GO_0006915> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0009987> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "apoptotic process" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A programmed cell death process which begins when a cell receives an internal (e.g. DNA damage) or external signal (e.g. an extracellular death ligand), and proceeds through a series of biochemical events (signaling pathway phase) which trigger an execution phase. The execution phase is the last step of an apoptotic process, and is typically characterized by rounding-up of the cell, retraction of pseudopodes, reduction of cellular volume (pyknosis), chromatin condensation, nuclear fragmentation (karyorrhexis), plasma membrane blebbing and fragmentation of the cell into apoptotic bodies. When the execution phase is completed, the cell has died." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "apoptotic process" .


###  http://purl.obolibrary.org/obo/GO_0006955
<http://purl.obolibrary.org/obo/GO_0006955> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0050896> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "immune response" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Any immune system process that functions in the calibrated response of an organism to a potential internal or invasive threat." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "immune response" .


###  http://purl.obolibrary.org/obo/GO_0006974
<http://purl.obolibrary.org/obo/GO_0006974> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0050896> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "DNA damage response" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Any process that results in a change in state or activity of a cell (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a stimulus indicating damage to its DNA from environmental insults or errors during metabolism." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "DNA damage response" .


###  http://purl.obolibrary.org/obo/GO_0007009
<http://purl.obolibrary.org/obo/GO_0007009> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0009987> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "plasma membrane organization" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A process that is carried out at the cellular level which results in the assembly, arrangement of constituent parts, or disassembly of the plasma membrane." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "plasma membrane organization" .


###  http://purl.obolibrary.org/obo/GO_0007049
<http://purl.obolibrary.org/obo/GO_0007049> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "cell cycle" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The progression of biochemical and morphological phases and events that occur in a cell during successive cell replication or nuclear replication events. Canonically, the cell cycle comprises the replication and segregation of genetic material followed by the division of the cell, but in endocycles or syncytial cells nuclear replication or nuclear division may not be followed by cell division." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "cell cycle" .


###  http://purl.obolibrary.org/obo/GO_0007283
<http://purl.obolibrary.org/obo/GO_0007283> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0022414> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "spermatogenesis" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The developmental process by which male germ line stem cells self renew or give rise to successive cell types resulting in the development of a spermatozoa." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "spermatogenesis" .


###  http://purl.obolibrary.org/obo/GO_0007565
<http://purl.obolibrary.org/obo/GO_0007565> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0022414> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "female pregnancy" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The set of physiological processes that allow an embryo or foetus to develop within the body of a female animal. It covers the time from fertilization of a female ovum by a male spermatozoon until birth." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "female pregnancy" .


###  http://purl.obolibrary.org/obo/GO_0007566
<http://purl.obolibrary.org/obo/GO_0007566> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0022414> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "embryo implantation" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Attachment of the blastocyst to the uterine lining." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "embryo implantation" .


###  http://purl.obolibrary.org/obo/GO_0007596
<http://purl.obolibrary.org/obo/GO_0007596> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "blood coagulation" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The sequential process in which the multiple coagulation factors of the blood interact, ultimately resulting in the formation of an insoluble fibrin clot; it may be divided into three stages: stage 1, the formation of intrinsic and extrinsic prothrombin converting principle; stage 2, the formation of thrombin; stage 3, the formation of stable fibrin polymers." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "blood coagulation" .


###  http://purl.obolibrary.org/obo/GO_0007599
<http://purl.obolibrary.org/obo/GO_0007599> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/WOND_0000409> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The stopping of bleeding (loss of body fluid) or the arrest of the circulation to an organ or part." ;
                                            rdfs:label "Hemostasis process"@en ,
                                                       "hemostasis" .


###  http://purl.obolibrary.org/obo/GO_0007611
