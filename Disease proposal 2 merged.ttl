   <http://www.geneontology.org/formats/oboInOwl#source> "ncithesaurus:Capillary"
 ] .


###  http://purl.obolibrary.org/obo/UBERON_0001987
<http://purl.obolibrary.org/obo/UBERON_0001987> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000062> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000481>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Organ of metabolic interchange between fetus and mother, partly of embryonic origin and partly of maternal origin[GO]. The fetal portion of the placenta is known as the villous chorion. The maternal portion is known as the decidua basalis. The two portions are held together by anchoring villi that are anchored to the decidua basalis by the cytotrophoblastic shell." ;
                                                rdfs:label "placenta" .


###  http://purl.obolibrary.org/obo/UBERON_0001988
<http://purl.obolibrary.org/obo/UBERON_0001988> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000463> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Portion of semisolid bodily waste discharged through the anus[MW,modified]." ;
                                                rdfs:label "feces" .


###  http://purl.obolibrary.org/obo/UBERON_0002032
<http://purl.obolibrary.org/obo/UBERON_0002032> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000477>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Subdivision of breast which consists of skin, connective tissue and smooth muscle bundle and modified sebaceous glands and which surrounds the nipple." ;
                                                rdfs:label "areola" .


###  http://purl.obolibrary.org/obo/UBERON_0002037
<http://purl.obolibrary.org/obo/UBERON_0002037> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000481> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000467>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000955>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Part of the metencephalon that lies in the posterior cranial fossa behind the brain stem. It is concerned with the coordination of movement[MESH]. A large dorsally projecting part of the brain concerned especially with the coordination of muscles and the maintenance of bodily equilibrium, situated between the brain stem and the back of the cerebrum , and formed in humans of two lateral lobes and a median lobe[BTO]. Brain structure derived from the anterior hindbrain, and perhaps including posterior midbrain. The cerebellum plays a role in somatic motor function, the control of muscle tone, and balance[ZFA]." ;
                                                rdfs:label "cerebellum" .


###  http://purl.obolibrary.org/obo/UBERON_0002046
<http://purl.obolibrary.org/obo/UBERON_0002046> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0002530> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A two-lobed endocrine gland found in all vertebrates, located in front of and on either side of the trachea in humans, and producing various hormones, such as triiodothyronine and calcitonin[BTO]." ;
                                                rdfs:label "thyroid gland" .


###  http://purl.obolibrary.org/obo/UBERON_0002048
<http://purl.obolibrary.org/obo/UBERON_0002048> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000062> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001004>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Respiration organ that develops as an outpocketing of the esophagus." ;
                                                rdfs:label "lung" .


###  http://purl.obolibrary.org/obo/UBERON_0002067
<http://purl.obolibrary.org/obo/UBERON_0002067> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000467>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0002097>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000061>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The dermis is a layer of skin between the epidermis (with which it makes up the skin) and subcutaneous tissues, and is composed of two layers, the papillary and reticular dermis[WP]." ;
                                                rdfs:label "dermis" .


###  http://purl.obolibrary.org/obo/UBERON_0002072
<http://purl.obolibrary.org/obo/UBERON_0002072> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000062>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000467>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0002199>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Lowermost layer of the integumentary system in vertebrates. Types of cells that are found in the hypodermis are fibroblasts, adipose cells, and macrophages. It is derived from the mesoderm, but unlike the dermis, it is not derived from the dermatome region of the mesoderm. The hypodermis is used mainly for fat storage[WP]." ;
                                                rdfs:label "hypodermis" .


###  http://purl.obolibrary.org/obo/UBERON_0002097
<http://purl.obolibrary.org/obo/UBERON_0002097> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000062> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0002199>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The organ covering the body that consists of the dermis and epidermis." ;
                                                rdfs:label "skin of body" .


###  http://purl.obolibrary.org/obo/UBERON_0002106
<http://purl.obolibrary.org/obo/UBERON_0002106> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000062> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The organ that functions to filter blood and to store red corpuscles and platelets." ;
                                                rdfs:label "spleen" .


###  http://purl.obolibrary.org/obo/UBERON_0002107
<http://purl.obolibrary.org/obo/UBERON_0002107> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0002530> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "An exocrine gland which secretes bile and functions in metabolism of protein and carbohydrate and fat, synthesizes substances involved in the clotting of the blood, synthesizes vitamin A, detoxifies poisonous substances, stores glycogen, and breaks down worn-out erythrocytes[GO]." ;
                                                rdfs:label "liver" .


###  http://purl.obolibrary.org/obo/UBERON_0002116
<http://purl.obolibrary.org/obo/UBERON_0002116> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000062>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001555>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The portion of the small intestine that extends from the jejunum to the colon." ;
                                                rdfs:label "ileum" .


###  http://purl.obolibrary.org/obo/UBERON_0002199
<http://purl.obolibrary.org/obo/UBERON_0002199> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000467>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0002072>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0002097>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The dermis, epidermis and hypodermis." ;
                                                rdfs:label "integument" .


###  http://purl.obolibrary.org/obo/UBERON_0002358
<http://purl.obolibrary.org/obo/UBERON_0002358> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000481> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000483>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0002384>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A serous membrane that lines the peritoneal cavity[VHOG,modified]." ;
                                                rdfs:label "peritoneum" .


###  http://purl.obolibrary.org/obo/UBERON_0002367
<http://purl.obolibrary.org/obo/UBERON_0002367> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0002530> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The prostate gland is a partly muscular, partly glandular body that is situated near the base of the mammalian male urethra and secretes an alkaline viscid fluid which is a major constituent of the ejaculatory fluid." ;
                                                rdfs:label "prostate gland" .


###  http://purl.obolibrary.org/obo/UBERON_0002369
<http://purl.obolibrary.org/obo/UBERON_0002369> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0002530> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Either of a pair of complex endocrine organs near the anterior medial border of the kidney consisting of a mesodermal cortex that produces glucocorticoid, mineralocorticoid, and androgenic hormones and an ectodermal medulla that produces epinephrine and norepinephrine[BTO]." ;
                                                rdfs:label "adrenal gland" .


###  http://purl.obolibrary.org/obo/UBERON_0002371
<http://purl.obolibrary.org/obo/UBERON_0002371> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000479> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000467>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000479>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The soft tissue that fills the cavities of bones." ;
                                                rdfs:label "bone marrow" .


###  http://purl.obolibrary.org/obo/UBERON_0002384
<http://purl.obolibrary.org/obo/UBERON_0002384> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000479> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Tissue with cells that deposit non-polarized extracellular matrix including connective tissue fibers and ground substance." ;
                                                rdfs:label "connective tissue" .


###  http://purl.obolibrary.org/obo/UBERON_0002385
<http://purl.obolibrary.org/obo/UBERON_0002385> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000479> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Muscle tissue is a contractile tissue made up of actin and myosin fibers[GO]." ;
                                                rdfs:label "muscle tissue" .


###  http://purl.obolibrary.org/obo/UBERON_0002386
<http://purl.obolibrary.org/obo/UBERON_0002386> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001460>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The middle limb segment of the pectoral free limb, between the autopod and stylopod segments. Includes as parts the forelimb zeugopodial skeleton, which includes as parts the radius and ulna, or their cartilage precursors, or evolutionary variants." ;
                                                rdfs:label "forelimb zeugopod" .


###  http://purl.obolibrary.org/obo/UBERON_0002389
<http://purl.obolibrary.org/obo/UBERON_0002389> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A digit that is part of a manus (hand)." ;
                                                rdfs:label "manual digit" .


###  http://purl.obolibrary.org/obo/UBERON_0002391
<http://purl.obolibrary.org/obo/UBERON_0002391> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0006314> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000467>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Lymph is the fluid that is formed when interstitial fluid enters the conduits of the lymphatic system through lymph capillaries[WP]." ;
                                                rdfs:label "lymph" .


###  http://purl.obolibrary.org/obo/UBERON_0002409
<http://purl.obolibrary.org/obo/UBERON_0002409> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0006314> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Transudate contained in the pericardial cavity.[FMA]." ;
                                                rdfs:label "pericardial fluid" .


###  http://purl.obolibrary.org/obo/UBERON_0002415
<http://purl.obolibrary.org/obo/UBERON_0002415> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "An external caudal extension of the body. In chordates, the tail is post-anal, in other animals the anus ends in the tail." ;
                                                rdfs:label "tail" .


###  http://purl.obolibrary.org/obo/UBERON_0002465
<http://purl.obolibrary.org/obo/UBERON_0002465> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000467> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000467>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The lymphatic system in vertebrates is a network of conduits that carry a clear fluid called lymph. It also includes the lymphoid tissue through which the lymph travels. Lymphoid tissue is found in many organs, particularly the lymph nodes, and in the lymphoid follicles associated with the digestive system such as the tonsils. The system also includes all the structures dedicated to the circulation and production of lymphocytes, which includes the spleen, thymus, bone marrow and the lymphoid tissue associated with the digestive system[WP]." ;
                                                rdfs:label "lymphoid system" .


###  http://purl.obolibrary.org/obo/UBERON_0002469
<http://purl.obolibrary.org/obo/UBERON_0002469> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000062>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000483>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0002384>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A mucosa that is part of a esophagus [Automatically generated definition]." ;
                                                rdfs:label "esophagus mucosa" .


###  http://purl.obolibrary.org/obo/UBERON_0002512
<http://purl.obolibrary.org/obo/UBERON_0002512> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0002530> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000992>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A transient endocrine gland that develops from the postovulatory or atretic follicles and secretes progesterone; it is thought to be related to egg retention[PMID]." ;
                                                rdfs:label "corpus luteum" .


###  http://purl.obolibrary.org/obo/UBERON_0002530
<http://purl.obolibrary.org/obo/UBERON_0002530> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000062> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "An organ that functions as a secretory or excretory organ." ;
                                                rdfs:label "gland" .


###  http://purl.obolibrary.org/obo/UBERON_0002812
<http://purl.obolibrary.org/obo/UBERON_0002812> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000062>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A cerebral hemisphere that is in the left side of a brain." ;
                                                rdfs:label "left cerebral hemisphere" .


###  http://purl.obolibrary.org/obo/UBERON_0002813
<http://purl.obolibrary.org/obo/UBERON_0002813> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000062>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A cerebral hemisphere that is in the right side of a brain." ;
                                                rdfs:label "right cerebral hemisphere" .


###  http://purl.obolibrary.org/obo/UBERON_0003102
<http://purl.obolibrary.org/obo/UBERON_0003102> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Anatomical structure that overlaps the outer epithelial layer and is adjacent to the space surrounding the organism." ;
                                                rdfs:label "surface structure" .


###  http://purl.obolibrary.org/obo/UBERON_0003126
<http://purl.obolibrary.org/obo/UBERON_0003126> rdf:type owl:Class ;
