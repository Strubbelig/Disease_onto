                                                                                    owl:unionOf ( <http://purl.obolibrary.org/obo/COB_0000011>
                                                                                                  <http://purl.obolibrary.org/obo/COB_0000013>
                                                                                                )
                                                                                  ]
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "analyte role" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Glucose in blood (measured in an assay to determine the concentration of glucose)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A measurand role borne by a molecular entity or an atom and realized in an analyte assay which achieves the objective to measure the magnitude/concentration/amount of the analyte in the entity bearing evaluant role."@en ;
