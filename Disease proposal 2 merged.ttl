###  http://purl.obolibrary.org/obo/OBI_0000425
<http://purl.obolibrary.org/obo/OBI_0000425> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200166> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "averaging objective"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "A mean calculation which has averaging objective is a descriptive statistics calculation in which the mean is calculated by taking the sum of all of the observations in a data set divided by the total number of observations. It gives a measure of the 'center of gravity' for the data set. It is also known as the first moment."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An averaging objective is a data transformation objective where the aim is to perform mean calculations on the input of the data transformation."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi" ,
                                                                                          "James Malone"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: Elisabetta Manduchi" ;
                                             rdfs:label "averaging objective"@en .


