                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000842> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A leukocyte with a single non-segmented nucleus in the mature form found in the circulatory pool of blood." ;
                                            rdfs:label "peripheral blood mononuclear cell" .


