###  http://purl.obolibrary.org/obo/OBI_0003306
<http://purl.obolibrary.org/obo/OBI_0003306> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0002440> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "bulk Hi-C assay" ;
