###  http://purl.obolibrary.org/obo/HP_0012399
<http://purl.obolibrary.org/obo/HP_0012399> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/HP_0032674> ,
                                                            <http://purl.obolibrary.org/obo/HP_0200042> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A type of ulcer that is caused when an area of skin is subject to pressure over a prolonged period of time, ranging in range in severity from patches of discolored skin to open wounds that expose the underlying bone or muscle. The most common sites are the sacrum, coccyx, heels and the hips." ,
                                                                                         "A chronic ulcer of skin where the ulcer is an ulceration of tissue deprived of adequate blood supply by prolonged pressure." ;
                                            <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-0736-9199> ;
                                            <http://purl.org/dc/terms/date> "2013-11-08T08:49:52Z"^^xsd:dateTime ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "SNOMEDCT_US:399912005" ,
                                                                                                     "SNOMEDCT_US:420226006" ,
                                                                                                     "UMLS:C0011127" ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Bedsore" ,
                                                                                                           "Decubitus Ulcer" ,
                                                                                                           "Pressure Sore" ,
                                                                                                           "Pressure ulcer" ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "human_phenotype" ;
                                            <http://www.geneontology.org/formats/oboInOwl#id> "HP:0012399" ;
                                            rdfs:comment "Pressure ulcers tend to affect persons with reduced mobility who are bedridden or wheelchair-bound." ;
                                            rdfs:label "Pressure ulcer" ,
                                                       "decubitus ulcer" .

