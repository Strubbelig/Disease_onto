                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000919> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "asphyxiation" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "PMID: 18246869. Loss of cortical function in mice after decapitation, cervical dislocation, potassium chloride injection, and CO2 inhalation. Comp Med. 2007 Dec;57(6):570-"@en ;
