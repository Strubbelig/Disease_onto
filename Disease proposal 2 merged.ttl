                                                               owl:hasValue <http://purl.obolibrary.org/obo/OBI_0000759>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "Illumina HiSeq X Ten" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A DNA sequencer that consists of a set of 10 HiSeq X Sequencing Systems."@en ;
