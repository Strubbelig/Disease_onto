###  http://purl.obolibrary.org/obo/OBI_0200001
<http://purl.obolibrary.org/obo/OBI_0200001> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200181> ,
                                                             <http://purl.obolibrary.org/obo/OBI_0200184> ,
                                                             [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000299> ;
                                                                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0000674>
                                                                                    ]
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200177>
                                                                                    ]
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200078>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "geometric mean calculation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A data transformation in which the mean is calculated by taking the nth root of the product of all of the observations in a data (n being the number of all observations)."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Mathias Brochhausen"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: Mathias Brochhausen"@en ;
                                             rdfs:comment "A geometric mean calculation is a descriptive statistics calculation in which the mean is calculated by taking the nth root of the product of all of the observations in a data (n being the number of all observations)."@en ;
                                             rdfs:label "geometric mean calculation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200002
<http://purl.obolibrary.org/obo/OBI_0200002> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200072> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200174>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "logistic-log curve fitting"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Typically used in an enzyme-linked immunosorbent assay (ELISA) to model the relationship between optical density (OD) and dilution. In this case a and d correspond to the theoretical OD of the assay at zero and infinite concentrations, respectively; c is the dilution associated with the point of symmetry of the sigmoid and is located at the midpoint of the assay found at the inflection point of the curve; b is a curvature parameter and is related to the slope of the curve."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A logistic-log curve fitting is a curve fitting where a curve of the form y=d+((a-d)/(1+(x/c)^b)) is obtained, where a, b, c, and d are determined so to optimize its fit to the input data points (x_1, y_1), (x_2, y_2), ..., (x_n, y_n)."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "James Malone"@en ,
                                                                                          "Melanie Courtot"@en ,
                                                                                          "Ryan Brinkman"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "ARTICLE: Plikaytis B.D. et al. (1991), J. Clin. Microbiol. 29(7): 1439-1448"@en ;
                                             rdfs:label "logistic-log curve fitting"@en .


###  http://purl.obolibrary.org/obo/OBI_0200003
<http://purl.obolibrary.org/obo/OBI_0200003> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200072> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200174>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "logit-log curve fitting"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Typically used in an enzyme-linked immunosorbent assay (ELISA) to model the relationship between optical density (OD) and dilution. In this case OD_0 (also referred to OD_min) and OD_infty (also referred to OD_max) correspond to the theoretical OD of the assay at zero and infinite concentrations, respectively."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A logit-log curve fitting is a curve fitting where first the limits y_0 an y_infty of y when x->0 and x->infinity, respectively, are estimated from the input data points (x_1, y_1), (x_2,y_2), ..., (x_n, y_n). Then a curve with equation log((y-y_0)/(y_infty-y))=a+b log(x) is obtained, where a and b are determined to optimize its fit to the input data points."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "The above definition refers to the 'fully specified' logit-log model. The reduced form of this, when it is assumed that y_0=0, is named 'partially specified' logit-log model."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "James Malone"@en ,
                                                                                          "Melanie Courtot"@en ,
                                                                                          "Ryan Brinkman"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "ARTICLE: Plikaytis B.D. et al. (1991), J. Clin. Microbiol. 29(7): 1439-1448"@en ;
                                             rdfs:label "logit-log curve fitting"@en .


###  http://purl.obolibrary.org/obo/OBI_0200004
<http://purl.obolibrary.org/obo/OBI_0200004> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200072> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200174>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "log-log curve fitting"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Typically used in an enzyme-linked immunosorbent assay (ELISA) to model the relationship between optical density (OD) and dilution."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A log-log curve fitting is a curve fitting where first a logarithmic transformation is applied both to the x and the y coordinates of the input data points (x_1, y_1), (x_2, y_2), ..., (x_n, y_n), and then coefficients a and b are determined to optimize the fit of log(y)=a+b*log(x) to these input data points."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "James Malone"@en ,
                                                                                          "Melanie Courtot"@en ,
                                                                                          "Ryan Brinkman"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "ARTICLE: Plikaytis B.D. et al. (1991), J. Clin. Microbiol. 29(7): 1439-1446"@en ;
                                             rdfs:label "log-log curve fitting"@en .


###  http://purl.obolibrary.org/obo/OBI_0200005
<http://purl.obolibrary.org/obo/OBI_0200005> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200166> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "feature extraction objective"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A feature extraction objective is a data transformation objective where the aim of the data transformation is to generate quantified values from a scanned image."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi" ,
                                                                                          "James Malone"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "TERM: http://mged.sourceforge.net/ontologies/MGEDOntology.owl#feature_extraction"@en ;
                                             rdfs:label "feature extraction objective"@en .


###  http://purl.obolibrary.org/obo/OBI_0200006
<http://purl.obolibrary.org/obo/OBI_0200006> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200072> ,
                                                             <http://purl.obolibrary.org/obo/OBI_0200169> ,
                                                             [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000299> ;
                                                                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0000451>
                                                                                    ]
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200167>
                                                                                    ]
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200174>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "biexponential transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "This type of transformation is typically used in flow cytometry."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A biexponential transformation is a data transformation that, for each (one dimensional) real number input x, outputs an approximation (found, e.g. with the Newton's method) to a solution y of the equation B(y)-x=0, where B denotes a b transformation."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "Joseph Spliden"@en ,
                                                                                          "Ryan Brinkman"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "WEB: http://flowcyt.sourceforge.net/gating/latest.pdf"@en ;
                                             rdfs:label "biexponential transformation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200007
<http://purl.obolibrary.org/obo/OBI_0200007> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200169> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200167>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "box-cox transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A box-cox transformation is a data transformation according to the methods of Box and Cox as described in the article Box, G. E. P. and Cox, D.R. (1964) An analysis of transformations. Journal of Royal Statistical Society, Series B, vol. 26, pp. 211-246."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Ryan Brinkman"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "ARTICLE: Box, G. E. P. and Cox, D.R. (1964), \"An analysis of transformations\", Journal of Royal Statistical Society, Series B, vol. 26, pp. 211-246."@en ;
                                             rdfs:label "box-cox transformation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200008
<http://purl.obolibrary.org/obo/OBI_0200008> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200169> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200167>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "hyperlog transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "This type of transformation is typically used in flow cytometry"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A hyperlog transformation ia a data transformation that, for each (one dimensional) real number input x, outputs an approximation (found, e.g. with the Newton's method) to a solution y of the equation EH(y)-x=0, where EH denotes an eh transformation."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "Joseph Spliden"@en ,
                                                                                          "Ryan Brinkman"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "ARTICLE: Bagwell C.B. (2006), \"Hyperlog - a flexible log-like  transform for negative, zero, and positive valued data\", Cytometry A 64, 34-42.\""@en ,
                                                                                          "http://flowcyt.sourceforge.net/gating/latest.pdf"@en ;
                                             rdfs:label "hyperlog transformation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200010
<http://purl.obolibrary.org/obo/OBI_0200010> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200025> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "loess scale group transformation one-channel"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Loess scale group normalization applied to data from two one-channel expression microarray assays."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A loess scale group transformation one-channel is a loess scale group transformation consisting in the application of a scale adjustment following a loess group transformation one-channel, to render the M group variances similar."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OTHER: Editor's adjustment based on MGED Ontology term"@en ;
                                             rdfs:label "loess scale group transformation one-channel"@en .


###  http://purl.obolibrary.org/obo/OBI_0200011
<http://purl.obolibrary.org/obo/OBI_0200011> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200169> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200167>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "logical transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "This type of transformation is typically used in flow cytometry."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A logical transformation is a data transformation that, for each (one dimensional) real number input x, outputs an approximation (found, e.g. with the Newton's method) to a solution y of the equation S(y)-x=0, where S denotes an s transformation."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "Joseph Spliden"@en ,
                                                                                          "Ryan Brinkman"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "WEB: http://flowcyt.sourceforge.net/gating/latest.pdf"@en ;
                                             rdfs:label "logical transformation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200012
<http://purl.obolibrary.org/obo/OBI_0200012> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200025> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "loess scale group transformation two-channel"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Loess scale group normalization applied to data from a two-channel expression microarray assay."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A loess scale group transformation two-channel is a loess scale group transformation consisting in the application of a scale adjustment following a loess group transformation two-channel, to render the M group variances similar."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OTHER: Adjusted from MGED Ontology"@en ;
                                             rdfs:label "loess scale group transformation two-channel"@en .


###  http://purl.obolibrary.org/obo/OBI_0200013
<http://purl.obolibrary.org/obo/OBI_0200013> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200023> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "loess global transformation one-channel"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Loess global normalization applied to data from two one-channel expression microarray assays, where the curve is obtained using all reporters. The goal is to remove intensity-dependent biases."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A loess global transformation one-channel is a loess global transformation in the special case where the input is the result of an MA transformation applied to intensities from two related one-channel assays."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OTHER: Editor's generalization based on MGED Ontology term"@en ;
                                             rdfs:label "loess global transformation one-channel"@en .


###  http://purl.obolibrary.org/obo/OBI_0200014
<http://purl.obolibrary.org/obo/OBI_0200014> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200000> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "split-scale transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "This type of transformation is typically used in flow cytometry"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A split-scale transformation is a data transformation which is an application of a function f described as follows to a (one dimensional) real number input. f(x)=a*x+b if x=for x>t; where log denotes a logarithmic transformation and a, b, c, d, r, t are real constants, with a, c, d, r, t positive, chosen so that f is continuous with a continuous derivative at the transition point t."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "Joseph Spliden"@en ,
                                                                                          "Ryan Brinkman"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "WEB: http://flowcyt.sourceforge.net/gating/latest.pdf"@en ;
                                             rdfs:label "split-scale transformation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200015
<http://purl.obolibrary.org/obo/OBI_0200015> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200023> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "loess global transformation two-channel"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Loess global normalization applied to data from a two-channel expression microarray assay, where the curve is obtained using all reporters. The goal is to remove intensity-dependent biases."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A loess global transformation two-channel is a loess global transformation in the special case where the input the result of an MA transformation applied to intensities from the two channels of a two-channel assay."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OTHER: Editor's generalization based on MGED Ontology term"@en ;
                                             rdfs:label "loess global transformation two-channel"@en .


###  http://purl.obolibrary.org/obo/OBI_0200016
<http://purl.obolibrary.org/obo/OBI_0200016> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200169> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200167>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "sine transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "sine(0)=0, sine(pi/2)=1, sine(pi)=0, sine(3*pi/2)=-1, sine(pi/6)=1/2, sine(x+2*k*pi)=sine(x) where k is any integer, etc."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A sine transformation is a data transformation which consists in applying the sine function to a (one dimensional) real number input. The sine function is one of the basic trigonometric functions and a definition is provided, e.g., at http://mathworld.wolfram.com/Sine.html."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "WEB: http://mathworld.wolfram.com/Sine.html"@en ;
                                             rdfs:label "sine transformation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200017
<http://purl.obolibrary.org/obo/OBI_0200017> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200169> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200167>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "cosine transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "cosine(0)=1, cosine(pi/2)=0, cosine(pi)=-1, cosine(3*pi/2)=0, cosine(pi/3)=1/2, cosine(x+2*k*pi)=cosine(x) where k is any integer, etc."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A cosine transformation is a data transformation which consists in applying the cosine function to a (one dimensional) real number input. The cosine function is one of the basic trigonometric functions and a definition is provided, e.g., at http://mathworld.wolfram.com/Cosine.html."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "Philippe Rocca-Serra" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "WEB: http://mathworld.wolfram.com/Cosine.html"@en ;
                                             rdfs:label "cosine transformation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200018
<http://purl.obolibrary.org/obo/OBI_0200018> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200024> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "loess group transformation one-channel"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "A loess group transformation one-channel is a loess group transformation in the special case where the input is the result of an MA transformation applied to intensities from two related one-channel assays."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A loess group transformation one-channel is a loess group transformation in the special case where the input is the result of an MA transformation applied to intensities from two related one-channel assays."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OTHER: Editor's generalization based on MGED Ontology term"@en ;
                                             rdfs:label "loess group transformation one-channel"@en .


###  http://purl.obolibrary.org/obo/OBI_0200019
<http://purl.obolibrary.org/obo/OBI_0200019> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200024> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "loess group transformation two-channel"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "A loess group transformation two-channel is a loess group transformation in the special case where the input is the result of an MA transformation applied to intensities from the two channels of a two-channel assay."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A loess group transformation two-channel is a loess group transformation in the special case where the input is the result of an MA transformation applied to intensities from the two channels of a two-channel assay."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OTHER: Editor's generalization based on MGED Ontology term"@en ;
                                             rdfs:label "loess group transformation two-channel"@en .


###  http://purl.obolibrary.org/obo/OBI_0200020
<http://purl.obolibrary.org/obo/OBI_0200020> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200093> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "homogeneous polynomial transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "a*x, with a non-zero, is a homogeneous polynomial of degree 1 in 1 variable, a*x^2, with a non-zero, is a homogeneous polynomial of degree 2 in 1 variable; a_1*x_1+...+a_n*x_n, with at least one of the a_i's non-zero, is a homogeneous polynomial of degree one in n variables; a*x_n^3+b*x_1*x_2*x_3, with at least one of a and b non-zero, is a homogeneous polynomial of degree 3 in n variables."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A homogeneous polynomial transformation is a polynomial transformation where all the term of the polynomial have the same degree."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "WEB: http://mathworld.wolfram.com/HomogeneousPolynomial.html"@en ;
                                             rdfs:label "homogeneous polynomial transformation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200021
<http://purl.obolibrary.org/obo/OBI_0200021> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200169> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200167>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "linlog transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "This can be used for microarray normalization, e.g. to normalize the data from a two-channel expression microarray assay, as described in PMID 16646782."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A linlog transformation is a data transformation, described in PMID 16646782, whose input is a matrix [y_ik] and whose output is a matrix obtained by applying formula (9) of this paper, where values below an appropriately determined threshold (dependent on the row i) are transformed via a polynomial of degree 1, and values above this threshold are transformed via a logarithm."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "Philippe Rocca-Serra" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PMID: 16646782"@en ;
                                             rdfs:label "linlog transformation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200022
<http://purl.obolibrary.org/obo/OBI_0200022> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200169> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200167>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "variance stabilizing transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "This can be used for expression microarray assay normalization and it is referred to as \"variance stabilizing normalization\", according to the procedure described e.g. in PMID 12169536."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A variance stabilizing transformation is a data transformation, described in PMID 12169536, whose input is a matrix [y_ik] and whose output is a matrix obtained by applying formula (6) in this paper. One of the goals is to obtain an output matrix whose rows have equal variances. The method relies on various assumptions described in the paper."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "James Malone"@en ,
                                                                                          "Melanie Courtot"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "variance stabilising transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PMID: 12169536"@en ;
                                             rdfs:label "variance stabilizing transformation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200023
<http://purl.obolibrary.org/obo/OBI_0200023> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200071> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "loess global transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A loess global transformation is a loess transformation where only one loess fitting is performed, utilizing one subset of (or possibly all of) the data points in the input so that there is only one resulting loess curve y=f(x) which is used for the transformation."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "James Malone"@en ,
                                                                                          "Melanie Courtot"@en ,
                                                                                          "Philippe Rocca-Serra" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OTHER: Editor's generalization based on MGED Ontology term"@en ;
                                             rdfs:label "loess global transformation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200024
<http://purl.obolibrary.org/obo/OBI_0200024> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200071> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "loess group transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A loess group transformation is a loess transformation where the input is partitioned into groups and for each group a loess fitting is performed, utilizing a subset of (or possibly all of) the data points in that group. Thus, a collection of loess curves y=f_i(x) is generated, one per group. Each (x, y) in the input is transformed into (x, y-f_i(x)), where f_i(x) is the curve corresponding to the group to which that data point belongs."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "James Malone"@en ,
                                                                                          "Melanie Courtot"@en ,
                                                                                          "Philippe Rocca-Serra" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OTHER: Editor's generalization based on MGED Ontology term"@en ;
                                             rdfs:label "loess group transformation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200025
<http://purl.obolibrary.org/obo/OBI_0200025> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200185> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200183>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/RO_0002087> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200024>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "loess scale group transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A loess scale group transformation is a data transformation consisting in the application of a scale adjustment following a loess group transformation, to render the group variances for the second variable (y) similar.  Has objective scaling."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "James Malone"@en ,
                                                                                          "Melanie Courtot"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OTHER: Editor's generalization based on MGED Ontology term"@en ;
                                             rdfs:label "loess scale group transformation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200026
<http://purl.obolibrary.org/obo/OBI_0200026> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200169> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200167>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "total intensity transformation single"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "This can be used as a simple normalization method for expression microarray assays. For example, each intensity from a one-channel microarray assay is multiplied by a constant so that the output mean intensity over the microarray equals a desired target T (the multiplicative constant in this case is the T/(mean intensity))."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A total intensity transformation single is a data transformation that takes as input an n-dimensional (real) vector and multiplies each component of this vector by a coefficient, where the coefficient is obtained by taking the sum of the input components or of a subset of these, multiplied by a constant of choice."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "Helen Parkinson"@en ,
                                                                                          "James Malone"@en ,
                                                                                          "Melanie Courtot"@en ,
                                                                                          "Philippe Rocca-Serra" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OTHER: Adjusted from MGED Ontology"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000232> "Note that if the word \"sum\" is replaced by the word \"mean\" in the definition, the resulting definition is equivalent."@en ;
                                             rdfs:label "total intensity transformation single"@en .


###  http://purl.obolibrary.org/obo/OBI_0200027
<http://purl.obolibrary.org/obo/OBI_0200027> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200169> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200167>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "total intensity transformation paired"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "This can be used as a simple normalization method for the two channels from a two-channel expression microarray assay or from two related one-channel expression microarray assays."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A total intensity transformation paired is a data transformation that takes as input two n-dimensional (real) vectors and multiplies each component of the first vector by a coefficient, where the coefficient is obtained by taking the ratio of the sum of the second input components or of a subset of these by the sum of the first input components or of a subset of these (the same subset is used for the two vectors)."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "Philippe Rocca-Serra" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OTHER: Adjusted from MGED Ontology"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000232> "Note that if the word \"sum\" is replaced by the word \"mean\" in the definition, the resulting definition is equivalent."@en ;
                                             rdfs:label "total intensity transformation paired"@en .


###  http://purl.obolibrary.org/obo/OBI_0200028
<http://purl.obolibrary.org/obo/OBI_0200028> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200169> ,
                                                             <http://purl.obolibrary.org/obo/OBI_0200181> ,
                                                             [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000299> ;
                                                                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0000674>
                                                                                    ]
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200177>
                                                                                    ]
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200167>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "quantile transformation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "This can be used for expression microarray assay normalization and it is referred to as \"quantile normalization\", according to the procedure described e.g. in PMID 12538238."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A quantile transformation is a data transformation that takes as input a collection of data sets, where each can be thought as an n-dimensional (real) vector, and which transforms each data set so that the resulting output data sets have equal quantiles."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: Elisabetta Manduchi"@en ;
                                             rdfs:label "quantile transformation"@en .


###  http://purl.obolibrary.org/obo/OBI_0200029
<http://purl.obolibrary.org/obo/OBI_0200029> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200169> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200167>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "mean centering"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "This can be used as a normalization method in expression microarray assays. For example, given a two-channel microarray assay, the log ratios of the two channels (M values) can be mean-centered."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A mean centering is a data transformation that takes as input an n-dimensional (real) vector, performs a mean calculation on its components, and subtracts the resulting mean from each component of the input."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "Philippe Rocca-Serra" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "mean centring"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: Elisabetta Manduchi"@en ;
                                             rdfs:label "mean centering"@en .


###  http://purl.obolibrary.org/obo/OBI_0200030
<http://purl.obolibrary.org/obo/OBI_0200030> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200169> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200167>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "median centering"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "This can be used as a normalization method in expression microarray assays. For example, given a two-channel microarray assay, the log ratios of the two channels (M values) can be median-centered."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A median centering is a data transformation that takes as input an n-dimensional (real) vector, performs a median calculation on its components, and subtracts the resulting median from each component of the input."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "Philippe Rocca-Serra" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "median centring"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: Elisabetta Manduchi"@en ;
                                             rdfs:label "median centering"@en .


###  http://purl.obolibrary.org/obo/OBI_0200031
<http://purl.obolibrary.org/obo/OBI_0200031> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200166> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "differential expression analysis objective"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Analyses implemented by the SAM (http://www-stat.stanford.edu/~tibs/SAM), PaGE (www.cbil.upenn.edu/PaGE) or GSEA (www.broad.mit.edu/gsea/) algorithms and software"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A differential expression analysis objective is a data transformation objective whose input consists of expression levels of entities (such as transcripts or proteins), or of sets of such expression levels, under two or more conditions and whose output reflects which of these are likely to have different expression across such conditions."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: Elisabetta Manduchi"@en ;
                                             rdfs:label "differential expression analysis objective"@en .


###  http://purl.obolibrary.org/obo/OBI_0200032
<http://purl.obolibrary.org/obo/OBI_0200032> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000792> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200188>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "K-fold cross validation method"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000123> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "K-fold cross-validation randomly partitions the original sample into K subsamples. Of the K subsamples, a single subsample is retained as the validation data for testing the model, and the remaining K - 1 subsamples are used as training data. The cross-validation process is then repeated K times (the folds), with each of the K subsamples used exactly once as the validation data. The K results from the folds then can be averaged (or otherwise combined) to produce a single estimation. The advantage of this method over repeated random sub-sampling is that all observations are used for both training and validation, and each observation is used for validation exactly once. 10-fold cross-validation is commonly used"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Person:Helen Parkinson" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "Tina Boussard" ;
                                             rdfs:label "K-fold cross validation method"@en .


###  http://purl.obolibrary.org/obo/OBI_0200033
<http://purl.obolibrary.org/obo/OBI_0200033> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000792> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200188>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "leave one out cross validation method"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "The authors conducted  leave-one-out cross validation to estimate the strength and accuracy of the differentially expressed filtered genes. http://bioinformatics.oxfordjournals.org/cgi/content/abstract/19/3/368" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000123> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "is a data transformation :  leave-one-out cross-validation (LOOCV) involves using a single observation from the original sample as the validation data, and the remaining observations as the training data. This is repeated such that each observation in the sample is used once as the validation data"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "2009-11-10. Tracker: https://sourceforge.net/tracker/?func=detail&aid=2893049&group_id=177891&atid=886178" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Person:Helen Parkinson" ;
                                             rdfs:label "leave one out cross validation method"@en .


###  http://purl.obolibrary.org/obo/OBI_0200034
<http://purl.obolibrary.org/obo/OBI_0200034> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000792> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200188>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "jackknifing method" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "simple weighting procedure is suggested for combining information over alleles and loci, and sample variances may be estimated by a jackknife procedure" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "Jacknifing is a re-sampling data transformation process used to estimate the precision of sampling statistics and is a resampling method"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Helen Parkinson" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "jackknifing"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "http://en.wikipedia.org/wiki/Resampling_%28statistics%29" ;
                                             rdfs:label "jackknifing method"@en .


###  http://purl.obolibrary.org/obo/OBI_0200035
<http://purl.obolibrary.org/obo/OBI_0200035> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000792> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200188>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "boostrapping"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Although widely accepted that high throughput biological data are typically highly noisy, the effects that this uncertainty has upon the conclusions we draw from these data are often overlooked. However, in order to assign any degree of confidence to our conclusions, we must quantify these effects. Bootstrap resampling is one method by which this may be achieved." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "Bootstrapping is a statistical method for estimating the sampling distribution of a statistic by sampling with replacement from the original data, most often with the purpose of deriving robust estimates of standard errors and confidence intervals of a population parameter like a mean, median, proportion, odds ratio, correlation coefficient or regression coefficient"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Helen Parkinson" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "Bootstrapping is a data transformation process which estimates the precision of sampling statistics by drawing randomly with replacement from a set of data points" ;
                                             rdfs:label "boostrapping"@en .


###  http://purl.obolibrary.org/obo/OBI_0200036
<http://purl.obolibrary.org/obo/OBI_0200036> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200163> ,
                                                             [ rdf:type owl:Restriction ;
