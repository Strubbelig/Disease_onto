<http://purl.obolibrary.org/obo/OBI_0600012> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000659> ,
                                                             [ rdf:type owl:Restriction ;
