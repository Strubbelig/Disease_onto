###  http://purl.obolibrary.org/obo/OBI_0200149
<http://purl.obolibrary.org/obo/OBI_0200149> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200169> ,
                                                             [ rdf:type owl:Restriction ;
