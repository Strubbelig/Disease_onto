###  http://purl.obolibrary.org/obo/IAO_0000059
<http://purl.obolibrary.org/obo/IAO_0000059> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "report figure"@en ;
