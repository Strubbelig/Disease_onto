                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A software module is software composed of a collection of software methods."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON: Melanei Courtot"@en ,
                                                                                          "PERSON: Michel Dumontier"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
                                             rdfs:label "software module"@en .


###  http://purl.obolibrary.org/obo/IAO_0000593
<http://purl.obolibrary.org/obo/IAO_0000593> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000010> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000123> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A software library is software composed of a collection of software modules and/or software methods in a form that can be statically or dynamically linked to some software application."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON: Melanie Courtot"@en ,
                                                                                          "PERSON: Michel Dumontier"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
                                             rdfs:label "software library"@en .


###  http://purl.obolibrary.org/obo/IAO_0000594
