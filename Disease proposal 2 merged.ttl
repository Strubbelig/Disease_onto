###  http://purl.obolibrary.org/obo/OBI_0000601
<http://purl.obolibrary.org/obo/OBI_0000601> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000048> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "chromatography consumable" ;
