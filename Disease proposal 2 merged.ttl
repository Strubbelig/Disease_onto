###  http://purl.obolibrary.org/obo/UBERON_0000162
<http://purl.obolibrary.org/obo/UBERON_0000162> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000062>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000467>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001555>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Common chamber into which the intestines and excretory system opens. Arises during development in all vertebrates, but in many it becomes subdivided, lost or incorporated into other structures." ;
                                                rdfs:label "cloaca" .


###  http://purl.obolibrary.org/obo/UBERON_0000165
<http://purl.obolibrary.org/obo/UBERON_0000165> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000062>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001555>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The proximal portion of the digestive tract, containing the oral cavity and bounded by the oral opening. In vertebrates, this extends to the pharynx and includes gums, lips, tongue and parts of the palate. Typically also includes the teeth, except where these occur elsewhere (e.g. pharyngeal jaws) or protrude from the mouth (tusks)." ;
                                                rdfs:label "mouth" .


###  http://purl.obolibrary.org/obo/UBERON_0000173
<http://purl.obolibrary.org/obo/UBERON_0000173> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000463> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Amniotic fluid is a bodily fluid consisting of watery liquid surrounding and cushioning a growing fetus within the amnion. It allows the fetus to move freely without the walls of the uterus being too tight against its body. Buoyancy is also provided. The composition of the fluid changes over the course of gestation. Initially, amniotic fluid is similar to maternal plasma, mainly water with electrolytes. As the fetus develops, proteins, carbohydrates, lipids, phospholipids originating from the lungs, fetal cells, and urea are deposited in the fluid." ;
                                                rdfs:label "amniotic fluid" .


###  http://purl.obolibrary.org/obo/UBERON_0000178
<http://purl.obolibrary.org/obo/UBERON_0000178> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0006314> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000467>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A fluid that is composed of blood plasma and erythrocytes." ;
                                                rdfs:label "blood" .


###  http://purl.obolibrary.org/obo/UBERON_0000305
<http://purl.obolibrary.org/obo/UBERON_0000305> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000062>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000481>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000483>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The thin innermost layer of the extraembryonic membranes that contains the amniotic fluid; the membrane forms a closed sac in which the embryo and later, the fetus, is suspended and protected." ;
                                                rdfs:label "amnion" .


###  http://purl.obolibrary.org/obo/UBERON_0000310
<http://purl.obolibrary.org/obo/UBERON_0000310> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000477>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The upper ventral region of the torso of an organism." ;
                                                rdfs:label "breast" .


###  http://purl.obolibrary.org/obo/UBERON_0000316
<http://purl.obolibrary.org/obo/UBERON_0000316> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0006314> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A substance produced by the cervix and endocervical glands[BTO]. Thick acidic mucus that blocks the cervical os after mestruation[WP]. This 'infertile' mucus blocks spermatozoa from entering the uterus." ;
                                                rdfs:label "cervical mucus" .


###  http://purl.obolibrary.org/obo/UBERON_0000323
<http://purl.obolibrary.org/obo/UBERON_0000323> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "An embryo that is at the late embryonic stage; this stage covers late steps of the embryogenesis with a fully formed embryo still developing before birth or egg hatching." ;
                                                rdfs:label "late embryo" .


###  http://purl.obolibrary.org/obo/UBERON_0000341
<http://purl.obolibrary.org/obo/UBERON_0000341> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000477>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "In anatomy, the throat is the anterior part of the neck, in front of the vertebral column. It consists of the pharynx and larynx. An important feature of the throat is the epiglottis, a flap which separates the esophagus from the trachea and prevents inhalation of food or drink. The throat contains various blood vessels, various pharyngeal muscles, the trachea (windpipe) and the esophagus. The hyoid bone and the clavicle are the only bones located in the throat of mammals. It is sometimes considered a synonym for fauces. [WP,unvetted]." ;
                                                rdfs:label "throat" .


###  http://purl.obolibrary.org/obo/UBERON_0000362
<http://purl.obolibrary.org/obo/UBERON_0000362> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000481> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The inner portion of the kidney consisting of the renal pyramids." ;
                                                rdfs:label "renal medulla" .


###  http://purl.obolibrary.org/obo/UBERON_0000463
<http://purl.obolibrary.org/obo/UBERON_0000463> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000465> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Material anatomical entity in a gaseous, liquid, semisolid or solid state; produced by anatomical structures or derived from inhaled and ingested substances that have been modified by anatomical structures as they pass through the body." ;
                                                rdfs:label "organism substance" .


###  http://purl.obolibrary.org/obo/UBERON_0000465
<http://purl.obolibrary.org/obo/UBERON_0000465> rdf:type owl:Class ;
                                                owl:equivalentClass [ rdf:type owl:Class ;
                                                                      owl:unionOf ( <http://purl.obolibrary.org/obo/CL_0000000>
                                                                                    <http://purl.obolibrary.org/obo/COB_0000021>
                                                                                    <http://purl.obolibrary.org/obo/COB_0000022>
                                                                                    <http://purl.obolibrary.org/obo/GO_0110165>
                                                                                  )
                                                                    ] ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ,
                                                                <http://purl.obolibrary.org/obo/UBERON_0001062> ;
                                                owl:disjointWith <http://purl.obolibrary.org/obo/UBERON_0000466> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Anatomical entity that has mass." ;
                                                <http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/NCBITaxon_33090> ,
                                                                                            <http://purl.obolibrary.org/obo/NCBITaxon_4751> ;
