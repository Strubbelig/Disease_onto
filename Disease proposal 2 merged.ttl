<http://purl.obolibrary.org/obo/OBI_0400119> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0001034> ,
                                                             [ rdf:type owl:Restriction ;
