                                              <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/pr.owl> ;
                                              rdfs:label "aspartate aminotransferase (human)" .


###  http://purl.obolibrary.org/obo/PR_000050469
