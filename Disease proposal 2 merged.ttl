###  http://purl.obolibrary.org/obo/OBI_0000465
<http://purl.obolibrary.org/obo/OBI_0000465> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000038> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "organic acid column" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An organic acid column is a chromatography column which enables (reversed-phase) separation of hydrophilic aliphatic and aromatic organic acids with UV detection. Organic acid columns allow retention of polar and apolar organic acids and are hydrolysis resistant."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON:Daniel Schober" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "GROUP:<http://msi-ontology.sourceforge.net>" ,
                                                                                          "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01099" ;
                                             rdfs:label "organic acid column" .


###  http://purl.obolibrary.org/obo/OBI_0000466
<http://purl.obolibrary.org/obo/OBI_0000466> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000637> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "thermal conductivity detector" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "The most commonly used detector in preparative GC is the thermal conductivity detector (hot wire detector). Even this detector, however, is often too sensitive and has too high a flow impedance. Under such circumstances, the procedure mentioned above must be employed. The eluent from the preparative column is split and a small portion diverted through the detector (sometimes with further dilution with carrier gas to reduce sensitivity)."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON:Daniel Schober" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "TCD, hot wire detector" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "WEB:<http://www.chromatography-online.org/Preparative/Apparatus/Detectors/rs27.html>" ,
                                                                                          "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01084" ;
                                             rdfs:label "thermal conductivity detector" .


###  http://purl.obolibrary.org/obo/OBI_0000467
<http://purl.obolibrary.org/obo/OBI_0000467> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000597> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "Bruker US 2 NMR magnet" ;
