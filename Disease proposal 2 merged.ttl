                                             <http://purl.obolibrary.org/obo/IAO_0000118> "RNA interference knockdown assay" ,
                                                                                          "RNAi gene knockdown assay" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "Rebecca Jackson" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> "https://github.com/obi-ontology/obi/issues/1057" ;
                                             rdfs:label "RNAi knockdown assay" .


