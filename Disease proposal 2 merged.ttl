###  http://purl.obolibrary.org/obo/UBERON_0000007
<http://purl.obolibrary.org/obo/UBERON_0000007> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0002530> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The pituitary gland is an endocrine gland that secretes hormones that regulate many other glands [GO]. An endocrine gland located ventral to the diencephalon and derived from mixed neuroectodermal and non neuroectodermal origin [ZFIN]." ;
                                                rdfs:label "pituitary gland" .


###  http://purl.obolibrary.org/obo/UBERON_0000010
<http://purl.obolibrary.org/obo/UBERON_0000010> rdf:type owl:Class ;
