###  http://purl.obolibrary.org/obo/OBI_0002614
<http://purl.obolibrary.org/obo/OBI_0002614> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0500000> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "birth cohort study design" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "The LucKi Birth Cohort Study was designed and started in 2006 to follow children from birth into adulthood on a wide range of determinants, disorders, and diseases." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A cohort study design for which the subjects are followed from the time of birth usually including information about gestation and follow up."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "MIABIS" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "MIABIS contributors" ;
                                             rdfs:label "birth cohort study design" .


###  http://purl.obolibrary.org/obo/OBI_0002615
<http://purl.obolibrary.org/obo/OBI_0002615> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0500000> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "disease specific study design" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "A study of the symptoms experienced by patients who have been diagnosed with multiple sclerosis employs a disease specific study design." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A study design for which material and information is collected from subjects that have already developed a particular disease."@en ;
