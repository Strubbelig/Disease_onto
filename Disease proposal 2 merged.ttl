                                                                                          "Daniel Schober" ,
                                                                                          "Frank Gibson" ,
                                                                                          "Melanie Courtot" ;
                                             rdfs:label "record function"@en .


###  http://purl.obolibrary.org/obo/OBI_0000369
<http://purl.obolibrary.org/obo/OBI_0000369> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000034> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "magnify function"@en ;
