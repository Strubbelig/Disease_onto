                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000087> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "c has-biological-role r iff c has-role r and r is a biological role (CHEBI:24432)" ;
