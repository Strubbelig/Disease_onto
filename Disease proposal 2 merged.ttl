###  http://purl.obolibrary.org/obo/OBI_0400008
<http://purl.obolibrary.org/obo/OBI_0400008> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0400044> ,
