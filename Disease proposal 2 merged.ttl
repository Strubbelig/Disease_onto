                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "cell culture expansion"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "a process that results in the increase of cell numbers"@en ;
