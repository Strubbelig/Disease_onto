###  http://purl.obolibrary.org/obo/APOLLO_SV_00000522
<http://purl.obolibrary.org/obo/APOLLO_SV_00000522> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000310> ,
