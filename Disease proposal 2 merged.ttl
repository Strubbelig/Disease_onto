                                            <http://purl.obolibrary.org/obo/IAO_0000111> "histamine secretion mediated by immunoglobulin" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Histamine release triggered by the binding of an antigen to an immunoglobulin bound to the cell surface." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
