###  http://purl.obolibrary.org/obo/CL_0000019
<http://purl.obolibrary.org/obo/CL_0000019> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A mature male germ cell that develops from a spermatid." ;
                                            rdfs:label "sperm" .


###  http://purl.obolibrary.org/obo/CL_0000057
<http://purl.obolibrary.org/obo/CL_0000057> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001062>
                                                            ] ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A connective tissue cell which secretes an extracellular matrix rich in collagen and other macromolecules. Flattened and irregular in outline with branching processes; appear fusiform or spindle-shaped." ;
                                            rdfs:label "fibroblast" .


###  http://purl.obolibrary.org/obo/CL_0000066
<http://purl.obolibrary.org/obo/CL_0000066> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001062>
                                                            ] ;
                                            owl:disjointWith <http://purl.obolibrary.org/obo/CL_0000738> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A cell that is usually found in a two-dimensional sheet with a free surface. The cell has a cytoskeleton that allows for tight cell to cell contact and for cell polarity where apical part is directed towards the lumen and the basal part to the basal lamina." ;
                                            rdfs:label "epithelial cell" .


###  http://purl.obolibrary.org/obo/CL_0000077
<http://purl.obolibrary.org/obo/CL_0000077> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000066> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A flat, squamous-like epithelial cell of mesodermal origin. It forms the mesothelium, which lines the body's serous cavities including the pleural, peritoneal, and pericardial spaces. This cell plays a crucial role in synthesizing and secreting lubricants, such as glycosaminoglycans and surfactants, which minimize friction between adjacent tissues during movement." ;
                                            rdfs:label "mesothelial cell" .


###  http://purl.obolibrary.org/obo/CL_0000081
<http://purl.obolibrary.org/obo/CL_0000081> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A cell found predominately in the blood." ;
                                            rdfs:label "blood cell" .


###  http://purl.obolibrary.org/obo/CL_0000084
<http://purl.obolibrary.org/obo/CL_0000084> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000542> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A type of lymphocyte whose defining characteristic is the expression of a T cell receptor complex." ;
                                            rdfs:label "T cell" .


###  http://purl.obolibrary.org/obo/CL_0000097
<http://purl.obolibrary.org/obo/CL_0000097> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000738> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001062>
                                                            ] ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A cell that is found in almost all tissues containing numerous basophilic granules and capable of releasing large amounts of histamine and heparin upon activation. Progenitors leave bone marrow and mature in connective and mucosal tissue. Mature mast cells are found in all tissues, except the bloodstream. Their phenotype is CD117-high, CD123-negative, CD193-positive, CD200R3-positive, and FceRI-high. Stem-cell factor (KIT-ligand; SCF) is the main controlling signal of their survival and development." ;
                                            rdfs:label "mast cell" .


###  http://purl.obolibrary.org/obo/CL_0000101
<http://purl.obolibrary.org/obo/CL_0000101> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000540> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Any neuron having a sensory function; an afferent neuron conveying sensory impulses." ;
                                            <http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/NCBITaxon_9606> ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "BTO:0001037" ,
                                                                                                     "FMA:84649" ,
                                                                                                     "MESH:D011984" ,
                                                                                                     "WBbt:0005759" ;
                                            rdfs:label "sensory neuron" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/CL_0000101> ;
   owl:annotatedProperty <http://purl.obolibrary.org/obo/IAO_0000115> ;
   owl:annotatedTarget "Any neuron having a sensory function; an afferent neuron conveying sensory impulses." ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0721662544"
 ] .


###  http://purl.obolibrary.org/obo/CL_0000128
<http://purl.obolibrary.org/obo/CL_0000128> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0002319> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001062>
                                                            ] ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A class of large neuroglial (macroglial) cells in the central nervous system. Form the insulating myelin sheath of axons in the central nervous system." ;
                                            rdfs:label "oligodendrocyte" .


###  http://purl.obolibrary.org/obo/CL_0000182
<http://purl.obolibrary.org/obo/CL_0000182> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000066> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The main structural component of the liver. They are specialized epithelial cells that are organized into interconnected plates called lobules. Majority of cell population of liver, polygonal in shape, arranged in plates or trabeculae between sinusoids; may have single nucleus or binucleated." ;
                                            rdfs:label "hepatocyte" .


###  http://purl.obolibrary.org/obo/CL_0000232
<http://purl.obolibrary.org/obo/CL_0000232> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000081> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A red blood cell. In mammals, mature erythrocytes are biconcave disks containing hemoglobin whose function is to transport oxygen." ;
                                            rdfs:label "erythrocyte" .


###  http://purl.obolibrary.org/obo/CL_0000233
<http://purl.obolibrary.org/obo/CL_0000233> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000081> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A non-nucleated disk-shaped cell formed by extrusion from megakaryocytes, found in the blood of all mammals, and mainly involved in blood coagulation." ;
                                            rdfs:label "platelet" .


###  http://purl.obolibrary.org/obo/CL_0000235
<http://purl.obolibrary.org/obo/CL_0000235> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000842> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A mononuclear phagocyte present in variety of tissues, typically differentiated from monocytes, capable of phagocytosing a variety of extracellular particulate material, including immune complexes, microorganisms, and dead cells." ;
                                            rdfs:label "macrophage" .


###  http://purl.obolibrary.org/obo/CL_0000236
<http://purl.obolibrary.org/obo/CL_0000236> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000542> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A lymphocyte of B lineage that is capable of B cell mediated immunity." ;
                                            rdfs:label "B cell" .


###  http://purl.obolibrary.org/obo/CL_0000404
<http://purl.obolibrary.org/obo/CL_0000404> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A cell that initiates an electrical signal and passes that signal to another cell." ;
                                            rdfs:label "electrically signaling cell" .


###  http://purl.obolibrary.org/obo/CL_0000451
<http://purl.obolibrary.org/obo/CL_0000451> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000842> ;
                                            owl:disjointWith <http://purl.obolibrary.org/obo/CL_0000542> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A cell of hematopoietic origin, typically resident in particular tissues, specialized in the uptake, processing, and transport of antigens to lymph nodes for the purpose of stimulating an immune response via T cell activation. These cells are lineage negative (CD3-negative, CD19-negative, CD34-negative, and CD56-negative)." ;
                                            rdfs:label "dendritic cell" .


###  http://purl.obolibrary.org/obo/CL_0000540
<http://purl.obolibrary.org/obo/CL_0000540> rdf:type owl:Class ;
                                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/RO_0020104> ;
                                                                  owl:hasSelf "true"^^xsd:boolean
                                                                ] ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ,
                                                            <http://purl.obolibrary.org/obo/CL_0000404> ,
                                                            <http://purl.obolibrary.org/obo/CL_0002319> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The basic cellular unit of nervous tissue. Each neuron consists of a body, an axon, and dendrites. Their purpose is to receive, conduct, and transmit impulses in the nervous system." ;
                                            <http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/NCBITaxon_9606> ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "BTO:0000938" ,
                                                                                                     "CALOHA:TS-0683" ,
                                                                                                     "FMA:54527" ,
                                                                                                     "VHOG:0001483" ,
                                                                                                     "WBbt:0003679" ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "nerve cell" ;
                                            rdfs:comment "These cells are also reportedly CD4-negative and CD200-positive. They are also capable of producing CD40L and IFN-gamma." ;
                                            rdfs:label "neuron" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/CL_0000540> ;
   owl:annotatedProperty <http://purl.obolibrary.org/obo/IAO_0000115> ;
   owl:annotatedTarget "The basic cellular unit of nervous tissue. Each neuron consists of a body, an axon, and dendrites. Their purpose is to receive, conduct, and transmit impulses in the nervous system." ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MESH:D009474" ,
                                                            "http://en.wikipedia.org/wiki/Neuron"
 ] .


###  http://purl.obolibrary.org/obo/CL_0000542
<http://purl.obolibrary.org/obo/CL_0000542> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000842> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A lymphocyte is a leukocyte commonly found in the blood and lymph that has the characteristics of a large nucleus, a neutral staining cytoplasm, and prominent heterochromatin." ;
                                            rdfs:label "lymphocyte" .


###  http://purl.obolibrary.org/obo/CL_0000556
<http://purl.obolibrary.org/obo/CL_0000556> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A large hematopoietic cell (50 to 100 micron) with a lobated nucleus. Once mature, this cell undergoes multiple rounds of endomitosis and cytoplasmic restructuring to allow platelet formation and release." ;
                                            rdfs:label "megakaryocyte" .


###  http://purl.obolibrary.org/obo/CL_0000558
<http://purl.obolibrary.org/obo/CL_0000558> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001062>
                                                            ] ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "An immature erythrocyte that changes the protein composition of its plasma membrane by exosome formation and extrusion. The types of protein removed differ between species though removal of the transferrin receptor is apparent in mammals and birds." ;
                                            rdfs:label "reticulocyte" .


###  http://purl.obolibrary.org/obo/CL_0000560
<http://purl.obolibrary.org/obo/CL_0000560> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000775> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A late neutrophilic metamyelocyte in which the nucleus is indented to more than half the distance to the farthest nuclear margin but in no area being condensed to a single filament. The nucleus is in the form of a curved or coiled band, not having acquired the typical multilobar shape of the mature neutrophil. These cells are fMLP receptor-positive, CD11b-positive, CD35-negative, and CD49d-negative." ;
                                            rdfs:label "band form neutrophil" .


###  http://purl.obolibrary.org/obo/CL_0000562
<http://purl.obolibrary.org/obo/CL_0000562> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000232> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "An erythrocyte having a nucleus." ;
                                            rdfs:label "nucleate erythrocyte" .


###  http://purl.obolibrary.org/obo/CL_0000576
<http://purl.obolibrary.org/obo/CL_0000576> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000842> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Myeloid mononuclear recirculating leukocyte that can act as a precursor of tissue macrophages, osteoclasts and some populations of tissue dendritic cells." ;
                                            rdfs:label "monocyte" .


###  http://purl.obolibrary.org/obo/CL_0000578
<http://purl.obolibrary.org/obo/CL_0000578> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000312> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/COB_0000110>
                                                            ] ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A cell in vitro that has undergone physical changes as a consequence of a deliberate and specific experimental procedure." ;
                                            rdfs:label "experimentally modified cell in vitro" .


###  http://purl.obolibrary.org/obo/CL_0000623
<http://purl.obolibrary.org/obo/CL_0000623> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000542> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A lymphocyte that can spontaneously kill a variety of target cells without prior antigenic activation via germline encoded activation receptors and also regulate immune responses via cytokine release and direct contact with other cells." ;
                                            rdfs:label "natural killer cell" .


###  http://purl.obolibrary.org/obo/CL_0000624
<http://purl.obolibrary.org/obo/CL_0000624> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000789> ;
                                            owl:disjointWith <http://purl.obolibrary.org/obo/CL_0000625> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A mature alpha-beta T cell that expresses an alpha-beta T cell receptor and the CD4 coreceptor." ;
                                            rdfs:label "CD4-positive, alpha-beta T cell" .


###  http://purl.obolibrary.org/obo/CL_0000625
<http://purl.obolibrary.org/obo/CL_0000625> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000789> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A T cell expressing an alpha-beta T cell receptor and the CD8 coreceptor." ;
                                            rdfs:label "CD8-positive, alpha-beta T cell" .


###  http://purl.obolibrary.org/obo/CL_0000681
<http://purl.obolibrary.org/obo/CL_0000681> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0002319> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A cell present in the developing CNS. Functions as both a precursor cell and as a scaffold to support neuronal migration." ;
                                            rdfs:label "radial glial cell" .


###  http://purl.obolibrary.org/obo/CL_0000738
<http://purl.obolibrary.org/obo/CL_0000738> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001062>
                                                            ] ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "An achromatic cell of the myeloid or lymphoid lineages capable of ameboid movement, found in blood or other tissue." ;
                                            rdfs:label "leukocyte" .


###  http://purl.obolibrary.org/obo/CL_0000767
<http://purl.obolibrary.org/obo/CL_0000767> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000081> ,
                                                            <http://purl.obolibrary.org/obo/CL_0000738> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001062>
                                                            ] ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Any of the immature or mature forms of a granular leukocyte that in its mature form has an irregularly shaped, pale-staining nucleus that is partially constricted into two lobes, and with cytoplasm that contains coarse, bluish-black granules of variable size. Basophils contain vasoactive amines such as histamine and serotonin, which are released on appropriate stimulation. A basophil is CD123-positive, CD193-positive, CD203c-positive, and FceRIa-positive." ;
                                            rdfs:label "basophil" .


###  http://purl.obolibrary.org/obo/CL_0000771
<http://purl.obolibrary.org/obo/CL_0000771> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000081> ,
                                                            <http://purl.obolibrary.org/obo/CL_0000738> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001062>
                                                            ] ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Any of the immature or mature forms of a granular leukocyte with a nucleus that usually has two lobes connected by one or more slender threads of chromatin, and cytoplasm containing coarse, round granules that are uniform in size and which can be stained by the dye eosin. Eosinophils are CD9-positive, CD191-positive, and CD193-positive." ;
                                            rdfs:label "eosinophil" .


###  http://purl.obolibrary.org/obo/CL_0000775
<http://purl.obolibrary.org/obo/CL_0000775> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000081> ,
                                                            <http://purl.obolibrary.org/obo/CL_0000738> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001062>
                                                            ] ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Any of the immature or mature forms of a granular leukocyte that in its mature form has a nucleus with three to five lobes connected by slender threads of chromatin, and cytoplasm containing fine inconspicuous granules and stainable by neutral dyes." ;
                                            rdfs:label "neutrophil" .


###  http://purl.obolibrary.org/obo/CL_0000776
<http://purl.obolibrary.org/obo/CL_0000776> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000775> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Any of the immature forms of a neutrophil in which neutrophilic specific granules are present but other phenotypic features of the mature form may be lacking." ;
                                            rdfs:label "immature neutrophil" .


###  http://purl.obolibrary.org/obo/CL_0000786
<http://purl.obolibrary.org/obo/CL_0000786> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000542> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A terminally differentiated, post-mitotic, antibody secreting cell of the B cell lineage with the phenotype CD138-positive, surface immunonoglobulin-negative, and MHC Class II-negative. Plasma cells are oval or round with extensive rough endoplasmic reticulum, a well-developed Golgi apparatus, and a round nucleus having a characteristic cartwheel heterochromatin pattern and are devoted to producing large amounts of immunoglobulin." ;
                                            rdfs:label "plasma cell" .


###  http://purl.obolibrary.org/obo/CL_0000789
<http://purl.obolibrary.org/obo/CL_0000789> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000084> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A T cell that expresses an alpha-beta T cell receptor complex." ;
                                            rdfs:label "alpha-beta T cell" .


###  http://purl.obolibrary.org/obo/CL_0000794
<http://purl.obolibrary.org/obo/CL_0000794> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000625> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A CD8-positive, alpha-beta T cell that is capable of killing target cells in an antigen specific manner with the phenotype perforin-positive and granzyme B-positive." ;
                                            rdfs:label "CD8-positive, alpha-beta cytotoxic T cell" .


###  http://purl.obolibrary.org/obo/CL_0000814
<http://purl.obolibrary.org/obo/CL_0000814> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000789> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A mature alpha-beta T cell of a distinct lineage that bears natural killer markers and a T cell receptor specific for a limited set of ligands. NK T cells have activation and regulatory roles particularly early in an immune response." ;
                                            rdfs:label "mature NK T cell" .


###  http://purl.obolibrary.org/obo/CL_0000836
<http://purl.obolibrary.org/obo/CL_0000836> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001062>
                                                            ] ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A precursor in the granulocytic series, being a cell intermediate in development between a myeloblast and myelocyte, that has distinct nucleoli, a nuclear-to-cytoplasmic ratio of 5:1 to 3:1, and containing a few primary cytoplasmic granules. Markers for this cell are fucosyltransferase FUT4-positive, CD33-positive, integrin alpha-M-negative, low affinity immunoglobulin gamma Fc region receptor III-negative, and CD24-negative." ;
                                            rdfs:label "promyelocyte" .


###  http://purl.obolibrary.org/obo/CL_0000842
<http://purl.obolibrary.org/obo/CL_0000842> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000738> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001062>
                                                            ] ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A leukocyte with a single non-segmented nucleus in the mature form." ;
                                            rdfs:label "mononuclear leukocyte" .


###  http://purl.obolibrary.org/obo/CL_0001064
<http://purl.obolibrary.org/obo/CL_0001064> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A neoplastic cell that is capable of entering a surrounding tissue" ;
                                            rdfs:label "malignant cell" .


###  http://purl.obolibrary.org/obo/CL_0002192
<http://purl.obolibrary.org/obo/CL_0002192> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A eosinophil precursor in the granulocytic series, being a cell intermediate in development between a myelocyte and a band form cell. The nucleus becomes indented where the indentation is smaller than half the distance to the farthest nuclear margin; chromatin becomes coarse and clumped; specific granules predominate while primary granules are rare." ;
                                            rdfs:label "metamyelocyte" .


###  http://purl.obolibrary.org/obo/CL_0002193
<http://purl.obolibrary.org/obo/CL_0002193> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A cell type that is the first of the maturation stages of the granulocytic leukocytes normally found in the bone marrow. Granules are seen in the cytoplasm. The nuclear material of the myelocyte is denser than that of the myeloblast but lacks a definable membrane. The cell is flat and contains increasing numbers of granules as maturation progresses." ;
                                            rdfs:label "myelocyte" .


###  http://purl.obolibrary.org/obo/CL_0002319
<http://purl.obolibrary.org/obo/CL_0002319> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001062>
                                                            ] ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A cell that is part of the nervous system." ;
                                            rdfs:label "neural cell" .


###  http://purl.obolibrary.org/obo/CL_0002368
<http://purl.obolibrary.org/obo/CL_0002368> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000066> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "An epithelial cell of the respiratory tract epithelium.  These cells have an endodermal origin." ;
                                            rdfs:label "respiratory tract epithelial cell" .


###  http://purl.obolibrary.org/obo/CL_0011012
<http://purl.obolibrary.org/obo/CL_0011012> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000000> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A cell of the neural crest. Neural crest cells are multipotent. Premigratory neural crest cells are found at the neural plate boarder, some of which will undergo ectomesynchymal transition and delamination to form migratory neural crest cells." ;
                                            rdfs:label "neural crest cell" .


###  http://purl.obolibrary.org/obo/CL_0011114
<http://purl.obolibrary.org/obo/CL_0011114> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/CL_0000775> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A segmented neutrophilic cell of the bone marrow reserve pool that expresses CD11b (integrin alpha-M) and high levels of CD16 (low affinity immunoglobulin gamma Fc region receptor III) on its cell surface." ;
                                            rdfs:label "segmented neutrophil of bone marrow" .


###  http://purl.obolibrary.org/obo/CL_2000001
