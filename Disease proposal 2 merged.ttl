                                             <http://purl.org/dc/terms/created> "2023-03-03"^^xsd:date ;
                                             rdfs:label "misspelling" ;
                                             rdfs:subPropertyOf <http://www.geneontology.org/formats/oboInOwl#SynonymTypeProperty> .


###  http://purl.obolibrary.org/obo/OMO_0003007
<http://purl.obolibrary.org/obo/OMO_0003007> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A synonym type for misnomers, i.e., a synonym that is not technically correct but is commonly used anyway" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> <https://github.com/information-artifact-ontology/ontology-metadata/issues/133> ;
                                             <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0003-4423-4370> ;
                                             <http://purl.org/dc/terms/created> "2023-03-03"^^xsd:date ;
                                             rdfs:label "misnomer" ;
                                             rdfs:subPropertyOf <http://www.geneontology.org/formats/oboInOwl#SynonymTypeProperty> .


###  http://purl.obolibrary.org/obo/OMO_0003008
<http://purl.obolibrary.org/obo/OMO_0003008> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "MAPT, the gene that encodes the Tau protein, has a previous name DDPAC. Note: in this case, the name type is more specifically the gene symbol." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A synonym type for names that have been used as primary labels in the past." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> <https://github.com/information-artifact-ontology/ontology-metadata/issues/139> ;
                                             <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0003-4423-4370> ;
                                             <http://purl.org/dc/terms/created> "2023-07-25"^^xsd:date ;
                                             rdfs:label "previous name" ;
                                             rdfs:subPropertyOf <http://www.geneontology.org/formats/oboInOwl#SynonymTypeProperty> .


###  http://purl.obolibrary.org/obo/OMO_0003009
<http://purl.obolibrary.org/obo/OMO_0003009> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "The legal name for Harvard University (https://ror.org/03vek6s52) is President and Fellows of Harvard College" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A synonym type for the legal entity name" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> <https://github.com/information-artifact-ontology/ontology-metadata/issues/141> ;
                                             <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0003-4423-4370> ;
                                             <http://purl.org/dc/terms/created> "2023-07-27"^^xsd:date ;
                                             rdfs:label "legal name" ;
                                             rdfs:subPropertyOf <http://www.geneontology.org/formats/oboInOwl#SynonymTypeProperty> .


###  http://purl.obolibrary.org/obo/OMO_0003010
<http://purl.obolibrary.org/obo/OMO_0003010> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "CHEBI:46195 has been assigned the english International Nonproproprietary Name (INN) \"paracetamol\". In some cases such as this one, the INN might be the same as the ontology's primary label" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "The International Nonproprietary Name (INN) is a standardize name for a pharmaceutical drug or active ingredient issued by the World Health Organization (WHO) meant to address the issues with country- or language-specific brand names. These are issued in several languages, including English, Latin, French, Russian, Spanish, Arabic, and Chinese." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> <https://github.com/information-artifact-ontology/ontology-metadata/issues/149> ;
                                             <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0003-4423-4370> ;
                                             <http://purl.org/dc/terms/created> "2023-09-30"^^xsd:date ;
                                             <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "INN" ;
                                             rdfs:label "International Nonproprietary Name" ;
                                             rdfs:subPropertyOf <http://www.geneontology.org/formats/oboInOwl#SynonymTypeProperty> .


###  http://purl.obolibrary.org/obo/OMO_0003011
<http://purl.obolibrary.org/obo/OMO_0003011> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "nasopharynx (UBERON:0001728) has the latin name \"pars nasalis pharyngis" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A synonym type for describing Latin term synonyms." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> <https://github.com/information-artifact-ontology/ontology-metadata/issues/146> ;
                                             <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0002-1773-2692> ;
                                             <http://purl.org/dc/terms/created> "2023-10-12"^^xsd:date ;
                                             rdfs:label "latin term" ;
                                             rdfs:subPropertyOf <http://www.geneontology.org/formats/oboInOwl#SynonymTypeProperty> .


###  http://purl.obolibrary.org/obo/OMO_0003012
<http://purl.obolibrary.org/obo/OMO_0003012> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "NASA is an word acronym for the US National Aeronautics and Space Administration because the acronym is pronounced. FBI is an initialism (also known as alphabetism) for the US Federal Bureau of Investigation since the letters are pronounced one at a time. JPEG is an acronym for Joint Photographic Experts Group but does not count as a word acronym nor an initialism since it is mixed how it is pronounced." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A synonym type for describing abbreviations that are a part of the full name's words, such as initialisms or alphabetisms." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> <https://github.com/information-artifact-ontology/ontology-metadata/issues/135> ;
                                             <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0003-4423-4370> ;
                                             <http://purl.org/dc/terms/created> "2023-11-01"^^xsd:date ;
                                             rdfs:label "acronym" ;
                                             rdfs:subPropertyOf <http://www.geneontology.org/formats/oboInOwl#SynonymTypeProperty> .


###  http://purl.obolibrary.org/obo/OMO_0003014
<http://purl.obolibrary.org/obo/OMO_0003014> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "The Developing Mouse Brain Atlas Ontology (DBMA) ontology uses part-of in its hierarchy, so this would correspond to the following turtle: `<https://purl.brain-bican.org/ontology/dmbao/dmbao.owl> a owl:Ontology; OMO:0003014 rdfs:subClassOf, BFO:0000050`." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "Relates an ontology to predicates/properties that should be used by user interfaces to render the hierarchical structure of the ontology. Typically, this is rdfs:subClassOf, but in ontologies that are partonomies, this might also include BFO:0000050 (part of). Tools like OLS can use predicates annotated with this property for rendering the ontology class hierarchy. There can be more than one hierarchical property. In the absence of any, it should be assumed that it is rdfs:subClassOf." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> <https://github.com/information-artifact-ontology/IAO/issues/292> ;
                                             <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0003-4423-4370> ;
                                             <http://purl.org/dc/terms/created> "2025-09-17"^^xsd:date ;
                                             rdfs:label "has ontology hierarchical property" .


###  http://purl.obolibrary.org/obo/OMO_0004000
<http://purl.obolibrary.org/obo/OMO_0004000> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "A serial number such as \"12324X\"; a stop sign; a written proper name such as \"OBI" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An information content entity that is a mark(s) or character(s) used as a conventional representation of another entity." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> <https://github.com/information-artifact-ontology/ontology-metadata/issues/144> ;
                                             <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0002-6523-4866> ;
                                             <http://purl.org/dc/terms/created> "2024-03-25"^^xsd:date ;
                                             rdfs:label "has symbol" .


###  http://purl.obolibrary.org/obo/RO_0001900
<http://purl.obolibrary.org/obo/RO_0001900> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "An assertion that holds between an OWL Object Property and a temporal interpretation that elucidates how OWL Class Axioms that use this property are to be interpreted in a temporal context." ;
                                            rdfs:label "temporal interpretation" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002422> .


###  http://purl.obolibrary.org/obo/RO_0002161
<http://purl.obolibrary.org/obo/RO_0002161> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "tooth SubClassOf 'never in taxon' value 'Aves'" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "x never in taxon T if and only if T is a class, and x does not instantiate the class expression \"in taxon some T\". Note that this is a shortcut relation, and should be used as a hasValue restriction in OWL." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-6601-2165> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000119> <http://www.ncbi.nlm.nih.gov/pubmed/17921072> ,
                                                                                         <http://www.ncbi.nlm.nih.gov/pubmed/20973947> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000425> "Class: ?X DisjointWith: RO_0002162 some ?Y " ;
                                            <http://purl.obolibrary.org/obo/OMO_0002000> """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX in_taxon: <http://purl.obolibrary.org/obo/RO_0002162>
PREFIX never_in_taxon: <http://purl.obolibrary.org/obo/RO_0002161>
CONSTRUCT {
  in_taxon: a owl:ObjectProperty .
  ?x owl:disjointWith [
    a owl:Restriction ;
    owl:onProperty in_taxon: ;
    owl:someValuesFrom ?taxon
  ] .
  ?x rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty in_taxon: ;
    owl:someValuesFrom [
      a owl:Class ;
      owl:complementOf ?taxon
    ]
  ] .
}
WHERE {
  ?x never_in_taxon: ?taxon .
}""" ;
                                            rdfs:label "never in taxon" ;
                                            rdfs:seeAlso <https://github.com/obophenotype/uberon/wiki/Taxon-constraints> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002172> .


###  http://purl.obolibrary.org/obo/RO_0002171
<http://purl.obolibrary.org/obo/RO_0002171> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A is mutually_spatially_disjoint_with B if both A and B are classes, and there exists no p such that p is part_of some A and p is part_of some B." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000118> "non-overlapping with" ,
                                                                                         "shares no parts with" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000119> <http://www.ncbi.nlm.nih.gov/pubmed/22293552> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000425> "Class: <http://www.w3.org/2002/07/owl#Nothing> EquivalentTo: (BFO_0000050 some ?X) and (BFO_0000050 some ?Y)" ;
                                            <http://purl.obolibrary.org/obo/OMO_0002000> """PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX part_of: <http://purl.obolibrary.org/obo/BFO_0000050>
PREFIX mutually_spatially_disjoint_with: <http://purl.obolibrary.org/obo/RO_0002171>
CONSTRUCT {
  part_of: a owl:ObjectProperty .
  [
    a owl:Restriction ;
    owl:onProperty part_of: ;
    owl:someValuesFrom ?x ;
    owl:disjointWith [
      a owl:Restriction ;
      owl:onProperty part_of: ;
      owl:someValuesFrom ?y
    ]
  ]
}
WHERE {
  ?x mutually_spatially_disjoint_with: ?y .
}""" ;
                                            rdfs:label "mutually spatially disjoint with"@en ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/RO_0002163> ,
                                                         "https://github.com/obophenotype/uberon/wiki/Part-disjointness-Design-Pattern"^^xsd:anyURI ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002420> .


###  http://purl.obolibrary.org/obo/RO_0002172
<http://purl.obolibrary.org/obo/RO_0002172> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "An assertion that holds between an ontology class and an organism taxon class, which is intepreted to yield some relationship between instances of the ontology class and the taxon." ;
                                            rdfs:label "taxonomic class assertion"@en ;
                                            rdfs:seeAlso <https://github.com/obophenotype/uberon/wiki/Taxon-constraints> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002420> .


###  http://purl.obolibrary.org/obo/RO_0002173
<http://purl.obolibrary.org/obo/RO_0002173> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "S ambiguous_for_taxon T if the class S does not have a clear referent in taxon T. An example would be the class 'manual digit 1', which encompasses a homology hypotheses that is accepted for some species (e.g. human and mouse), but does not have a clear referent in Aves - the referent is dependent on the hypothesis embraced, and also on the ontogenetic stage.  [PHENOSCPAE:asilomar_mtg]" ;
                                            rdfs:label "ambiguous for taxon"@en ;
                                            rdfs:seeAlso <https://github.com/obophenotype/uberon/wiki/Taxon-constraints> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002172> .


###  http://purl.obolibrary.org/obo/RO_0002174
<http://purl.obolibrary.org/obo/RO_0002174> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "S dubious_for_taxon T if it is probably the case that no instances of S can be found in any instance of T." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-6601-2165> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000119> <http://www.ncbi.nlm.nih.gov/pubmed/22293552> ;
                                            rdfs:comment "This relation lacks a strong logical interpretation, but can be used in place of never_in_taxon where it is desirable to state that the definition of the class is too strict for the taxon under consideration, but placing a never_in_taxon link would result in a chain of inconsistencies that will take ongoing coordinated effort to resolve. Example: metencephalon in teleost" ;
                                            rdfs:label "dubious for taxon"@en ;
                                            rdfs:seeAlso <https://github.com/obophenotype/uberon/wiki/Taxon-constraints> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002172> .


###  http://purl.obolibrary.org/obo/RO_0002175
<http://purl.obolibrary.org/obo/RO_0002175> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "S present_in_taxon T if some instance of T has some S. This does not means that all instances of T have an S - it may only be certain life stages or sexes that have S" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-6601-2165> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000119> <http://www.ncbi.nlm.nih.gov/pubmed/22293552> ;
                                            <http://purl.obolibrary.org/obo/OMO_0002000> """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX in_taxon: <http://purl.obolibrary.org/obo/RO_0002162>
PREFIX present_in_taxon: <http://purl.obolibrary.org/obo/RO_0002175>
CONSTRUCT {
  in_taxon: a owl:ObjectProperty .
  ?witness rdfs:label ?label .
  ?witness rdfs:subClassOf ?x .
  ?witness rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty in_taxon: ;
    owl:someValuesFrom ?taxon
  ] .
}
WHERE {
  ?x present_in_taxon: ?taxon .
  BIND(IRI(CONCAT(
    \"http://purl.obolibrary.org/obo/RO_0002175#\",
    MD5(STR(?x)),
    \"-\",
    MD5(STR(?taxon))
  )) as ?witness)
  BIND(CONCAT(STR(?x), \" in taxon \", STR(?taxon)) AS ?label)
}""" ;
                                            rdfs:comment "The SPARQL expansion for this relation introduces new named classes into the ontology. For this reason it is likely that the expansion should only be performed during a QC pipeline; the expanded output should usually not be included in a published version of the ontology." ;
                                            rdfs:label "present in taxon"@en ;
                                            rdfs:seeAlso <https://github.com/obophenotype/uberon/wiki/Taxon-constraints> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002172> .


###  http://purl.obolibrary.org/obo/RO_0002259
<http://purl.obolibrary.org/obo/RO_0002259> rdf:type owl:AnnotationProperty ;
                                            rdfs:label "defined by inverse" ;
                                            rdfs:subPropertyOf <http://www.geneontology.org/formats/oboInOwl#SubsetProperty> .


###  http://purl.obolibrary.org/obo/RO_0002416
<http://purl.obolibrary.org/obo/RO_0002416> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "An assertion that involves at least one OWL object that is intended to be expanded into one or more logical axioms. The logical expansion can yield axioms expressed using any formal logical system, including, but not limited to OWL2-DL." ;
                                            rdfs:label "logical macro assertion"@en ;
                                            rdfs:seeAlso "http://purl.obolibrary.org/obo/ro/docs/shortcut-relations/"^^xsd:anyURI .


###  http://purl.obolibrary.org/obo/RO_0002419
<http://purl.obolibrary.org/obo/RO_0002419> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "An assertion that holds between an OWL Annotation Property P and a non-negative integer N, with the interpretation: for any P(i j) it must be the case that | { k : P(i k) } | = N." ;
                                            rdfs:label "annotation property cardinality"@en ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002423> ;
                                            rdfs:range xsd:nonNegativeInteger .


###  http://purl.obolibrary.org/obo/RO_0002420
<http://purl.obolibrary.org/obo/RO_0002420> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A logical macro assertion whose domain is an IRI for a class" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000116> "The domain for this class can be considered to be owl:Class, but we cannot assert this in OWL2-DL" ;
                                            rdfs:label "logical macro assertion on a class"@en ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002416> .


###  http://purl.obolibrary.org/obo/RO_0002421
<http://purl.obolibrary.org/obo/RO_0002421> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A logical macro assertion whose domain is an IRI for a property" ;
                                            rdfs:label "logical macro assertion on a property"@en ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002416> .


###  http://purl.obolibrary.org/obo/RO_0002422
<http://purl.obolibrary.org/obo/RO_0002422> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Used to annotate object properties to describe a logical meta-property or characteristic of the object property." ;
                                            rdfs:label "logical macro assertion on an object property"@en ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002421> .


###  http://purl.obolibrary.org/obo/RO_0002423
<http://purl.obolibrary.org/obo/RO_0002423> rdf:type owl:AnnotationProperty ;
                                            rdfs:label "logical macro assertion on an annotation property"@en ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002421> .


###  http://purl.obolibrary.org/obo/RO_0002474
<http://purl.obolibrary.org/obo/RO_0002474> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "An assertion that holds between an OWL Object Property and a dispositional interpretation that elucidates how OWL Class Axioms or OWL Individuals that use this property are to be interpreted in a dispositional context. For example,  A binds B may be interpreted as A have a mutual disposition that is realized by binding to the other one." ;
                                            rdfs:label "dispositional interpretation" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002422> .


###  http://purl.obolibrary.org/obo/RO_0002475
<http://purl.obolibrary.org/obo/RO_0002475> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "'pectoral appendage skeleton' has no connections with 'pelvic appendage skeleton'" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A is has_no_connections_with B if there are no parts of A or B that have a connection with the other." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000118> "shares no connection with" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000425> "Class: <http://www.w3.org/2002/07/owl#Nothing> EquivalentTo: (BFO_0000050 some ?X) and (RO_0002170 some (BFO_0000050 some ?Y))" ;
                                            rdfs:label "has no connections with" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002420> .


###  http://purl.obolibrary.org/obo/RO_0002483
<http://purl.obolibrary.org/obo/RO_0002483> rdf:type owl:AnnotationProperty ;
                                            rdfs:label "inherited annotation property" .


###  http://purl.obolibrary.org/obo/RO_0002484
<http://purl.obolibrary.org/obo/RO_0002484> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Connects an ontology entity (class, property, etc) to a URL from which curator guidance can be obtained. This assertion is inherited in the same manner as functional annotations (e.g. for GO, over SubClassOf and part_of)" ;
                                            rdfs:label "curator guidance link" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002483> .


###  http://purl.obolibrary.org/obo/RO_0002504
<http://purl.obolibrary.org/obo/RO_0002504> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "brain always_present_in_taxon 'Vertebrata'" ,
                                                                                         "forelimb always_present_in_taxon Euarchontoglires" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "S always_present_in_taxon T if every fully formed member of taxon T has part some S, or is an instance of S" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000116> "This is a very strong relation. Often we will not have enough evidence to know for sure that there are no species within a lineage that lack the structure - loss is common in evolution. However, there are some statements we can make with confidence - no vertebrate lineage could persist without a brain or a heart. All primates are limbed. " ;
                                            <http://purl.obolibrary.org/obo/IAO_0000118> "never lost in" ;
                                            rdfs:label "always present in taxon" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002175> .


###  http://purl.obolibrary.org/obo/RO_0002535
<http://purl.obolibrary.org/obo/RO_0002535> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000232> "This property was originally created for the annotation of developmental or life cycle stages, such as for example Carnegie Stage 20 in humans. " ;
                                            rdfs:label "temporal logical macro assertion on a class" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002420> .


###  http://purl.obolibrary.org/obo/RO_0002536
<http://purl.obolibrary.org/obo/RO_0002536> rdf:type owl:AnnotationProperty ;
                                            rdfs:label "measurement property has unit" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002423> .


###  http://purl.obolibrary.org/obo/RO_0002537
<http://purl.obolibrary.org/obo/RO_0002537> rdf:type owl:AnnotationProperty ;
                                            rdfs:label "has start time value" ;
                                            rdfs:seeAlso "http://purl.obolibrary.org/obo/ro/docs/temporal-durations/"^^xsd:anyURI ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002535> .


###  http://purl.obolibrary.org/obo/RO_0002538
<http://purl.obolibrary.org/obo/RO_0002538> rdf:type owl:AnnotationProperty ;
                                            rdfs:label "has end time value" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/temporal-durations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002535> .


###  http://purl.obolibrary.org/obo/RO_0002539
<http://purl.obolibrary.org/obo/RO_0002539> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Count of number of days intervening between the start of the stage and the time of fertilization according to a reference model. Note that the first day of development has the value of 0 for this property." ;
                                            rdfs:label "start, days post fertilization" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/temporal-durations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002537> .


###  http://purl.obolibrary.org/obo/RO_0002540
<http://purl.obolibrary.org/obo/RO_0002540> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Count of number of days intervening between the end of the stage and the time of fertilization according to a reference model. Note that the first day of development has the value of 1 for this property." ;
                                            rdfs:label "end, days post fertilization" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/temporal-durations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002538> .


###  http://purl.obolibrary.org/obo/RO_0002541
<http://purl.obolibrary.org/obo/RO_0002541> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Count of number of years intervening between the start of the stage and the time of birth according to a reference model. Note that the first year of post-birth development has the value of 0 for this property, and the period during which the child is one year old has the value 1." ;
                                            rdfs:label "start, years post birth" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/temporal-durations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002537> .


###  http://purl.obolibrary.org/obo/RO_0002542
<http://purl.obolibrary.org/obo/RO_0002542> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Count of number of years intervening between the end of the stage and the time of birth according to a reference model. Note that the first year of post-birth development has the value of 1 for this property, and the period during which the child is one year old has the value 2" ;
                                            rdfs:label "end, years post birth" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/temporal-durations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002538> .


###  http://purl.obolibrary.org/obo/RO_0002543
<http://purl.obolibrary.org/obo/RO_0002543> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Count of number of months intervening between the start of the stage and the time of birth according to a reference model. Note that the first month of post-birth development has the value of 0 for this property, and the period during which the child is one month old has the value 1." ;
                                            rdfs:label "start, months post birth" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/temporal-durations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002537> .


###  http://purl.obolibrary.org/obo/RO_0002544
<http://purl.obolibrary.org/obo/RO_0002544> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Count of number of months intervening between the end of the stage and the time of birth according to a reference model. Note that the first month of post-birth development has the value of 1 for this property, and the period during which the child is one month old has the value 2" ;
                                            rdfs:label "end, months post birth" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/temporal-durations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002538> .


###  http://purl.obolibrary.org/obo/RO_0002545
<http://purl.obolibrary.org/obo/RO_0002545> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Defines the start and end of a stage with a duration of 1 month, relative to either the time of fertilization or last menstrual period of the mother (to be clarified), counting from one, in terms of a reference model. Thus if month_of_gestation=3, then the stage is 2 month in." ;
                                            rdfs:label "month of gestation" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/temporal-durations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002535> .


###  http://purl.obolibrary.org/obo/RO_0002546
<http://purl.obolibrary.org/obo/RO_0002546> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A relationship between a stage class and an anatomical structure or developmental process class, in which the stage is characterized by the appearance of the structure or the occurrence of the biological process" ;
                                            rdfs:label "has developmental stage marker" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/temporal-durations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002535> .


###  http://purl.obolibrary.org/obo/RO_0002547
<http://purl.obolibrary.org/obo/RO_0002547> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Count of number of days intervening between the start of the stage and the time of coitum." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000232> "For mouse staging: assuming that it takes place around midnight during a 7pm to 5am dark cycle (noon of the day on which the vaginal plug is found, the embryos are aged 0.5 days post coitum)" ;
                                            rdfs:label "start, days post coitum" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/temporal-durations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002537> .


###  http://purl.obolibrary.org/obo/RO_0002548
<http://purl.obolibrary.org/obo/RO_0002548> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Count of number of days intervening between the end of the stage and the time of coitum." ;
                                            rdfs:label "end, days post coitum" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/temporal-durations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002538> .


###  http://purl.obolibrary.org/obo/RO_0002549
<http://purl.obolibrary.org/obo/RO_0002549> rdf:type owl:AnnotationProperty ;
                                            rdfs:label "start, weeks post birth" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/temporal-durations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002537> .


###  http://purl.obolibrary.org/obo/RO_0002550
<http://purl.obolibrary.org/obo/RO_0002550> rdf:type owl:AnnotationProperty ;
                                            rdfs:label "end, weeks post birth" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/temporal-durations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002538> .


###  http://purl.obolibrary.org/obo/RO_0002560
<http://purl.obolibrary.org/obo/RO_0002560> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "If Rel is the relational form of a process Pr, then it follow that: Rel(x,y) <-> exists p : Pr(p), x subject-partner-in p, y object-partner-in p" ;
                                            rdfs:label "is asymmetric relational form of process class" ;
                                            rdfs:seeAlso "http://purl.obolibrary.org/obo/ro/docs/interaction-relations/"^^xsd:anyURI ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002562> .


###  http://purl.obolibrary.org/obo/RO_0002561
<http://purl.obolibrary.org/obo/RO_0002561> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "If Rel is the relational form of a process Pr, then it follow that: Rel(x,y) <-> exists p : Pr(p), x partner-in p, y partner-in p" ;
                                            rdfs:label "is symmetric relational form of process class" ;
                                            rdfs:seeAlso "http://purl.obolibrary.org/obo/ro/docs/interaction-relations/"^^xsd:anyURI ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002562> .


###  http://purl.obolibrary.org/obo/RO_0002562
<http://purl.obolibrary.org/obo/RO_0002562> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "R is the relational form of a process if and only if either (1) R is the symmetric relational form of a process or (2) R is the asymmetric relational form of a process" ;
                                            rdfs:label "is relational form of process class" ;
                                            rdfs:seeAlso "http://purl.obolibrary.org/obo/ro/docs/interaction-relations/"^^xsd:anyURI ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002594> .


###  http://purl.obolibrary.org/obo/RO_0002575
<http://purl.obolibrary.org/obo/RO_0002575> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "relation p is the direct form of relation q iff p is a subPropertyOf q, p does not have the Transitive characteristic, q does have the Transitive characteristic, and for all x, y: x q y -> exists z1, z2, ..., zn such that x p z1 ... z2n y" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000116> """The general property hierarchy is:

  \"directly P\" SubPropertyOf \"P\"
  Transitive(P)

Where we have an annotation assertion

  \"directly P\" \"is direct form of\" \"P\"""" ;
                                            <http://purl.obolibrary.org/obo/RO_0002423> "If we have the annotation P is-direct-form-of Q, and we have inverses P' and Q', then it follows that P' is-direct-form-of Q'" ;
                                            <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-6601-2165> ;
                                            rdfs:label "is direct form of" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/direct-and-indirect-relations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002422> .


###  http://purl.obolibrary.org/obo/RO_0002579
<http://purl.obolibrary.org/obo/RO_0002579> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "relation p is the indirect form of relation q iff p is a subPropertyOf q, and there exists some p' such that p' is the direct form of q, p' o p' -> p, and forall x,y : x q y -> either (1) x p y or (2) x p' y" ;
                                            <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-6601-2165> ;
                                            rdfs:label "is indirect form of" ;
                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/direct-and-indirect-relations/> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002422> .


###  http://purl.obolibrary.org/obo/RO_0002580
<http://purl.obolibrary.org/obo/RO_0002580> rdf:type owl:AnnotationProperty ;
                                            rdfs:label "logical macro assertion on an axiom" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002416> .


###  http://purl.obolibrary.org/obo/RO_0002581
<http://purl.obolibrary.org/obo/RO_0002581> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "If R <- P o Q is a defining property chain axiom, then it also holds that R -> P o Q. Note that this cannot be expressed directly in OWL" ;
                                            rdfs:label "is a defining property chain axiom" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002580> .


###  http://purl.obolibrary.org/obo/RO_0002582
<http://purl.obolibrary.org/obo/RO_0002582> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "If R <- P o Q is a defining property chain axiom, then (1) R -> P o Q holds and (2) Q is either reflexive or locally reflexive. A corollary of this is that P SubPropertyOf R." ;
                                            rdfs:label "is a defining property chain axiom where second argument is reflexive" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002581> .


###  http://purl.obolibrary.org/obo/RO_0002594
<http://purl.obolibrary.org/obo/RO_0002594> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "An annotation property that connects an object property to a class, where the object property is derived from or a shortcut property for the class. The exact semantics of this annotation may vary on a case by case basis." ;
                                            rdfs:label "is relational form of a class" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002422> .


###  http://purl.obolibrary.org/obo/RO_0002601
<http://purl.obolibrary.org/obo/RO_0002601> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A shortcut relationship that holds between two entities based on their identity criteria" ;
                                            rdfs:label "logical macro assertion involving identity" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002416> .


###  http://purl.obolibrary.org/obo/RO_0002602
<http://purl.obolibrary.org/obo/RO_0002602> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A shortcut relationship between two entities x and y1, such that the intent is that the relationship is functional and inverse function, but there is no guarantee that this property holds." ;
                                            rdfs:label "in approximate one to one relationship with" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002601> .


###  http://purl.obolibrary.org/obo/RO_0002603
<http://purl.obolibrary.org/obo/RO_0002603> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "x is approximately equivalent to y if it is the case that x is equivalent, identical or near-equivalent to y" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000232> "The precise meaning of this property is dependent upon some contexts. It is intended to group multiple possible formalisms. Possibilities include a probabilistic interpretation, for example, Pr(x=y) > 0.95. Other possibilities include reified statements of belief, for example, \"Database D states that x=y\"" ;
                                            rdfs:label "is approximately equivalent to" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002602> .


###  http://purl.obolibrary.org/obo/RO_0002604
<http://purl.obolibrary.org/obo/RO_0002604> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "'anterior end of organism' is-opposite-of 'posterior end of organism'" ,
                                                                                         "'increase in temperature' is-opposite-of 'decrease in temperature'" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "x is the opposite of y if there exists some distance metric M, and there exists no z such as M(x,z) <= M(x,y) or M(y,z) <= M(y,x)." ;
                                            rdfs:label "is opposite of" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002602> .


###  http://purl.obolibrary.org/obo/RO_0002605
<http://purl.obolibrary.org/obo/RO_0002605> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "x is indistinguishable from y if there exists some distance metric M, and there exists no z such as M(x,z) <= M(x,y) or M(y,z) <= M(y,x)." ;
                                            rdfs:label "is indistinguishable from" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002603> .


###  http://purl.obolibrary.org/obo/RO_0002611
<http://purl.obolibrary.org/obo/RO_0002611> rdf:type owl:AnnotationProperty ;
                                            rdfs:label "evidential logical macro assertion on an axiom" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002580> .


###  http://purl.obolibrary.org/obo/RO_0002612
<http://purl.obolibrary.org/obo/RO_0002612> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A relationship between a sentence and an instance of a piece of evidence in which the evidence supports the axiom" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000232> "This annotation property is intended to be used in an OWL Axiom Annotation to connect an OWL Axiom to an instance of an ECO (evidence type ontology class). Because in OWL, all axiom annotations must use an Annotation Property, the value of the annotation cannot be an OWL individual, the convention is to use an IRI of the individual." ;
                                            rdfs:label "axiom has evidence" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002611> .


###  http://purl.obolibrary.org/obo/RO_0002613
<http://purl.obolibrary.org/obo/RO_0002613> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A relationship between a sentence and an instance of a piece of evidence in which the evidence contradicts the axiom" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000232> "This annotation property is intended to be used in an OWL Axiom Annotation to connect an OWL Axiom to an instance of an ECO (evidence type ontology class). Because in OWL, all axiom annotations must use an Annotation Property, the value of the annotation cannot be an OWL individual, the convention is to use an IRI of the individual." ;
                                            rdfs:label "axiom contradicted by evidence" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002611> .


###  http://purl.obolibrary.org/obo/RO_0002617
<http://purl.obolibrary.org/obo/RO_0002617> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "In the context of a particular project, the IRI with CURIE NCBIGene:64327 (which in this example denotes a class) is considered to be representative. This means that if we have equivalent classes with IRIs OMIM:605522, ENSEMBL:ENSG00000105983, HGNC:13243 forming an equivalence set, the NCBIGene is considered the representative member IRI. Depending on the policies of the project, the classes may be merged, or the NCBIGene IRI may be chosen as the default in a user interface context." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "this property relates an IRI to the xsd boolean value \"True\" if the IRI is intended to be the representative IRI for a collection of classes that are mutually equivalent." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000232> "If it is necessary to make the context explicit, an axiom annotation can be added to the annotation assertion" ;
                                            rdfs:label "is representative IRI for equivalence set" ;
                                            rdfs:seeAlso "OWLAPI Reasoner documentation for representativeElement, which follows a similar idea, but selects an arbitrary member" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002601> .


###  http://purl.obolibrary.org/obo/RO_0004036
<http://purl.obolibrary.org/obo/RO_0004036> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "true if the two properties are disjoint, according to OWL semantics. This should only be used if using a logical axiom introduces a non-simple property violation." ;
                                            <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-6601-2165> ;
                                            rdfs:label "nominally disjoint with"@en ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002422> .


###  http://purl.obolibrary.org/obo/RO_0004048
<http://purl.obolibrary.org/obo/RO_0004048> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Used to annotate object properties representing a causal relationship where the value indicates a direction. Should be \"+\", \"-\" or \"0\"" ;
                                            <http://www.geneontology.org/formats/oboInOwl#created_by> <https://orcid.org/0000-0002-6601-2165> ;
                                            <http://www.geneontology.org/formats/oboInOwl#creation_date> "2018-03-13T23:59:29Z"^^xsd:dateTime ;
                                            rdfs:label "is directional form of" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002422> .


###  http://purl.obolibrary.org/obo/RO_0004049
<http://purl.obolibrary.org/obo/RO_0004049> rdf:type owl:AnnotationProperty ;
                                            <http://www.geneontology.org/formats/oboInOwl#created_by> <https://orcid.org/0000-0002-6601-2165> ;
                                            <http://www.geneontology.org/formats/oboInOwl#creation_date> "2018-03-14T00:03:16Z"^^xsd:dateTime ;
                                            rdfs:label "is positive form of" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0004048> .


###  http://purl.obolibrary.org/obo/RO_0004050
<http://purl.obolibrary.org/obo/RO_0004050> rdf:type owl:AnnotationProperty ;
                                            <http://www.geneontology.org/formats/oboInOwl#created_by> <https://orcid.org/0000-0002-6601-2165> ;
                                            <http://www.geneontology.org/formats/oboInOwl#creation_date> "2018-03-14T00:03:24Z"^^xsd:dateTime ;
                                            rdfs:label "is negative form of" ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0004048> .


###  http://purl.obolibrary.org/obo/RO_0040042
<http://purl.obolibrary.org/obo/RO_0040042> rdf:type owl:AnnotationProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "part-of is homeomorphic for independent continuants." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "R is homemorphic for C iff (1) there exists some x,y such that x R y, and x and y instantiate C and (2) for all x, if x is an instance of C, and there exists some y some such that x R y, then it follows that y is an instance of C." ;
                                            <http://www.geneontology.org/formats/oboInOwl#created_by> <https://orcid.org/0000-0002-6601-2165> ;
                                            <http://www.geneontology.org/formats/oboInOwl#creation_date> "2018-10-21T19:46:34Z"^^xsd:dateTime ;
                                            rdfs:comment "R homeomorphic-for C expands to: C SubClassOf R only C. Additionally, for any class D that is disjoint with C, we can also expand to C DisjointWith R some D, D DisjointWith R some C." ;
                                            rdfs:label "is homeomorphic for" ;
                                            rdfs:seeAlso <https://github.com/oborel/obo-relations/issues/164> ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002422> .


