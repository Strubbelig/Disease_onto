###  http://purl.obolibrary.org/obo/OBI_0302896
<http://purl.obolibrary.org/obo/OBI_0302896> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000919> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "cervical dislocation" ;
