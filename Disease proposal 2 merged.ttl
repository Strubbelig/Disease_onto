###  http://purl.obolibrary.org/obo/IAO_0000584
<http://purl.obolibrary.org/obo/IAO_0000584> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000100> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/IAO_0000582>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "pmid:20604925 - time-lapse live cell microscopy"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A data set that is an aggregate of data recording some measurement at a number of time points. The time series data set is an ordered list of pairs of time measurement data and the corresponding measurement data acquired at that time."@en ;
