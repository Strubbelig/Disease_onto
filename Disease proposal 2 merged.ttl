                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Any of the rounded masses of lymphoid tissue that are surrounded by a capsule of connective tissue, are distributed along the lymphatic vessels, and contain numerous lymphocytes which filter the flow of lymph." ;
                                                rdfs:label "lymph node" .


###  http://purl.obolibrary.org/obo/UBERON_0000057
<http://purl.obolibrary.org/obo/UBERON_0000057> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000062> ,
                                                                [ rdf:type owl:Restriction ;
