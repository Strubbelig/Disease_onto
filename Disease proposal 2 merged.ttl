                                                            "Wikipedia:Capillary" ,
                                                            "https://github.com/obophenotype/uberon/issues/137"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/UBERON_0001982> ;
