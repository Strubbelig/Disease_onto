                                             <http://purl.obolibrary.org/obo/IAO_0000111> "environmental material collection"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Taking 1 liter of surface ocean water from the San Diego Mission Bay Jetty. Capturing mice living in rural Arkansas"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000123> ;
