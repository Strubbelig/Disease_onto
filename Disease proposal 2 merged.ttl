###  http://purl.obolibrary.org/obo/OBI_0100046
<http://purl.obolibrary.org/obo/OBI_0100046> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0302729> ,
                                                             [ rdf:type owl:Restriction ;
