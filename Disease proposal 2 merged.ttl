<http://purl.obolibrary.org/obo/RO_0002000> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002323> ;
                                            owl:inverseOf <http://purl.obolibrary.org/obo/RO_0002002> ;
