###  http://purl.obolibrary.org/obo/OBI_0000739
<http://purl.obolibrary.org/obo/OBI_0000739> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000673> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000299> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0000175>
                                                             ] ,
