<http://purl.obolibrary.org/obo/OBI_0200083> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200166> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "survival analysis objective"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Kaplan meier data transformation" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A data transformation objective which has the data transformation aims to model time to event data (where events are e.g. death and or disease recurrence); the purpose of survival analysis is to model the underlying distribution of event times and to assess the dependence of the event time on other explanatory variables"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON: James Malone" ,
                                                                                          "PERSON: Tina Boussard" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "survival analysis" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "http://en.wikipedia.org/wiki/Survival_analysis" ;
                                             rdfs:label "survival analysis objective"@en .


