<http://purl.obolibrary.org/obo/GO_0042446> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0009987> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "hormone biosynthetic process" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The chemical reactions and pathways resulting in the formation of any hormone, naturally occurring substances secreted by specialized cells that affects the metabolism or behavior of other cells possessing functional receptors for the hormone." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "hormone biosynthetic process" .


