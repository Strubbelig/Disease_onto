                                                                                          "Daniel Schober" ,
                                                                                          "Frank Gibson" ,
                                                                                          "Melanie Courtot" ;
                                             rdfs:label "light emission function"@en .


###  http://purl.obolibrary.org/obo/OBI_0000368
<http://purl.obolibrary.org/obo/OBI_0000368> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000034> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "record function"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A record function is a function that registers or collects information in a particular format on a particular recording medium. For example on paper or a digital representation"@en ;
