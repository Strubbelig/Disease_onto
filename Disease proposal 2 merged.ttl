                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An objective specification to transformation input data into output data"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Modified definition in 2013 Philly OBI workshop" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "James Malone"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: James Malone"@en ;
