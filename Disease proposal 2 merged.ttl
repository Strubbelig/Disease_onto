                                             <http://purl.obolibrary.org/obo/IAO_0000112> "The production of IFN-gamma by effector T cells is a process result of T cell stimulation through the TCR" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000123> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "is a relationship between a process and a preceding occurrent that directly caused the later one to occur"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "IEDB" ,
                                                                                          "PERSON:Bjoern Peters" ;
                                             rdfs:label "process is result of" .


