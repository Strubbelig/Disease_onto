###  http://purl.obolibrary.org/obo/OBI_0000301
<http://purl.obolibrary.org/obo/OBI_0000301> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteProperty> ;
