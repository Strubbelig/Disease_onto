                                                                                 ]
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "data visualization" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Generation of a heatmap from a microarray dataset" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A planned process with the objective to graphically represent some data by inputing the data and outputting images, diagrams or animations."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "James Malone"@en ,
                                                                                          "Melanie Courtot"@en ,
                                                                                          "Tina Boussard"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "data encoding as image" ,
