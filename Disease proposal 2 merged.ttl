                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000467>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Anatomical structure that performs a specific function or group of functions [WP]." ;
                                                rdfs:label "organ" .


###  http://purl.obolibrary.org/obo/UBERON_0000105
<http://purl.obolibrary.org/obo/UBERON_0000105> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A spatiotemporal region encompassing some part of the life cycle of an organism." ;
                                                rdfs:label "life cycle stage" .


###  http://purl.obolibrary.org/obo/UBERON_0000122
<http://purl.obolibrary.org/obo/UBERON_0000122> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A fasciculated bundle of neuron projections (GO:0043005), largely or completely lacking synapses." ;
                                                <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "CARO:0001001" ,
                                                                                                         "NLX:147821" ;
                                                <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "funiculus" ,
                                                                                                               "nerve fiber bundle" ,
                                                                                                               "neural fiber bundle" ;
                                                <http://www.geneontology.org/formats/oboInOwl#id> "UBERON:0000122" ;
                                                <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/uberon/core#human_subset> ,
                                                                                                        <http://purl.obolibrary.org/obo/uberon/core#mouse_subset> ;
                                                rdfs:label "neuron projection bundle" .

