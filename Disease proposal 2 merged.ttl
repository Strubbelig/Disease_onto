                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A role which inheres in an organism or part thereof from which any part including cell, organ or tissue is removed with the intention that the donated part will be placed into another organism and/or cultured in vitro."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "IEDB"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "donor role" ;
