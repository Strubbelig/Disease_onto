###  http://purl.obolibrary.org/obo/OBI_0000367
<http://purl.obolibrary.org/obo/OBI_0000367> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000374> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "light emission function"@en ;
