                                                                                      owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                                                      owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0000425>
                                                                                    ]
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ] ,
