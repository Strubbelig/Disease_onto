                                           rdfs:subClassOf <http://purl.obolibrary.org/obo/WOND_0000194> ;
                                           <http://purl.obolibrary.org/obo/IAO_0000115> "An acute porphyria characterized by painful, blistering skin lesions that develop on sun-exposed skin." ;
