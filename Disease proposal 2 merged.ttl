###  http://purl.obolibrary.org/obo/HP_0032674
<http://purl.obolibrary.org/obo/HP_0032674> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/HP_0011121> ,
                                                            <http://purl.obolibrary.org/obo/WOND_0000380> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A cutaneous wound is a defined as a disruption of normal anatomic structure and function of the skin that occurs owing to an injury of the skin. Wound healing is a dynamic, interactive process involving soluble mediators, blood cells, extracellularmatrix, and parenchymal cells. Wound healing has three phases: inflammation, tissue formation, and tissue remodeling, that overlap in time." ;
                                            <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-0736-9199> ;
                                            <http://purl.org/dc/terms/date> "2020-02-23T09:13:36Z"^^xsd:dateTime ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Skin wound" ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "human_phenotype" ;
                                            <http://www.geneontology.org/formats/oboInOwl#id> "HP:0032674" ;
                                            rdfs:label "Cutaneous wound" ,
                                                       "Skin wound" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/HP_0032674> ;
   owl:annotatedProperty <http://purl.obolibrary.org/obo/IAO_0000115> ;
   owl:annotatedTarget "A cutaneous wound is a defined as a disruption of normal anatomic structure and function of the skin that occurs owing to an injury of the skin. Wound healing is a dynamic, interactive process involving soluble mediators, blood cells, extracellularmatrix, and parenchymal cells. Wound healing has three phases: inflammation, tissue formation, and tissue remodeling, that overlap in time." ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10471461"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/HP_0032674> ;
   owl:annotatedProperty <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> ;
   owl:annotatedTarget "Skin wound" ;
   <http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp.obo#layperson>
 ] .


###  http://purl.obolibrary.org/obo/HP_0032675
<http://purl.obolibrary.org/obo/HP_0032675> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/HP_0032674> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A cutaneous wound that is proceeding through an orderly and timely reparative process that results in sustained restoration of the anatomic and functional integrity of the skin." ;
                                            <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-0736-9199> ;
                                            <http://purl.org/dc/terms/date> "2020-02-23T09:13:36Z"^^xsd:dateTime ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "human_phenotype" ;
                                            <http://www.geneontology.org/formats/oboInOwl#id> "HP:0032675" ;
                                            rdfs:comment "Wound healing accors in multiple overlapping stages, with re=-eipthelialization normally beginning on day one or two. In most clinical settings, closure of acute and chronic wounds is considered the wound healing end point, but wounds can continue to undergo remodeling or tissue maturation for several months or even years." ;
                                            rdfs:label "Acute cutaneous wound" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/HP_0032675> ;
   owl:annotatedProperty <http://purl.obolibrary.org/obo/IAO_0000115> ;
   owl:annotatedTarget "A cutaneous wound that is proceeding through an orderly and timely reparative process that results in sustained restoration of the anatomic and functional integrity of the skin." ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30475656"
 ] .


###  http://purl.obolibrary.org/obo/HP_0032676
<http://purl.obolibrary.org/obo/HP_0032676> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/HP_0032674> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A cutaneous wound that has failed to proceed through the orderly and timely process to produce an atomic and functional integrity, or proceeded through the repair process without establishing a sustained anatomic and functional result." ;
                                            <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-0736-9199> ;
                                            <http://purl.org/dc/terms/date> "2020-02-23T09:13:36Z"^^xsd:dateTime ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Chronic nonhealing cutaneous wound" ;
                                            <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "human_phenotype" ;
                                            <http://www.geneontology.org/formats/oboInOwl#id> "HP:0032676" ;
                                            rdfs:label "Chronic cutaneous wound" ,
                                                       "Chronic wound" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/HP_0032676> ;
