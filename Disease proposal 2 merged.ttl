                                                                                                    <http://purl.obolibrary.org/obo/valid_for_go_ontology> ,
                                                                                                    <http://purl.obolibrary.org/obo/valid_for_gocam> ;
                                            rdfs:label "results in formation of anatomical entity"@en .


###  http://purl.obolibrary.org/obo/RO_0002298
<http://purl.obolibrary.org/obo/RO_0002298> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002295> ,
                                                               <http://purl.obolibrary.org/obo/RO_0040036> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "an annotation of gene X to cell morphogenesis with results_in_morphogenesis_of CL:0000540 (neuron) means that at the end of the process an input neuron has attained its shape." ,
                                                                                         "tongue morphogenesis (GO:0043587) results in morphogenesis of tongue (UBERON:0001723)"@en ;
                                            <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The relationship that links an entity with the process that results in the formation and shaping of that entity over time from an immature to a mature state." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-6601-2165> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000119> "GOC:mtg_berkeley_2013" ;
