                                             <http://purl.obolibrary.org/obo/IAO_0000119> "GROUP:<http://msi-ontology.sourceforge.net>" ,
                                                                                          "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01096" ;
                                             rdfs:label "cation exchange column" .


