                                             rdfs:label "hydrogen generator" .


###  http://purl.obolibrary.org/obo/OBI_0000609
<http://purl.obolibrary.org/obo/OBI_0000609> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000038> ;
