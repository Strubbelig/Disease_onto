                                             <http://purl.obolibrary.org/obo/IAO_0000115> "cervical dislocation is a process by which a Vertebrate organism has its life terminated by rupturing spinal cord between cervical vertebrae induced by excessive mechanical torsion"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "PRS:21102008: Input must be restricted to Vertebrates (requires import from NCBI tax)"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Philippe Rocca-Serra" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OBI branch" ;
                                             rdfs:label "cervical dislocation"@en .


