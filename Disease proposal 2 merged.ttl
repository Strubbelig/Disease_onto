###  http://purl.obolibrary.org/obo/OBI_0000371
<http://purl.obolibrary.org/obo/OBI_0000371> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000034> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "heat function"@en ;
