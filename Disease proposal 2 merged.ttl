                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200078>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "arithmetic mean calculation"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An arithmetic mean calculation is a descriptive statistics calculation in which the mean is calculated by taking the sum of all of the observations in a data set divided by the total number of observations. It gives a measure of the 'center of gravity' for the data set. It is also known as the first moment."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "James Malone"@en ,
                                                                                          "Monnie McGee"@en ,
                                                                                          "Philippe Rocca-Serra" ;
