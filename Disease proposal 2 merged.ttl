###  http://purl.obolibrary.org/obo/UBERON_0011011
<http://purl.obolibrary.org/obo/UBERON_0011011> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000062> ,
                                                                [ rdf:type owl:Restriction ;
