###  http://purl.obolibrary.org/obo/OBI_0500010
<http://purl.obolibrary.org/obo/OBI_0500010> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0500000> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "reference design" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "PMID: 12933549" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A reference experiment design type is where all samples are compared to a common reference."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Philippe Rocca-Serra on behalf of MO" ;
