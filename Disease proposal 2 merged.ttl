                                             <http://purl.obolibrary.org/obo/IAO_0000119> "GROUP:<http://msi-ontology.sourceforge.net>" ,
                                                                                          "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01055" ;
                                             rdfs:label "column cartridge" .


###  http://purl.obolibrary.org/obo/OBI_0000533
<http://purl.obolibrary.org/obo/OBI_0000533> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000038> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "affinity column" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An affinity column is a chromatography column that is used in affinity chromatography. Differences in the affinity of molecules to be separated to a stationary phase are used for discriminate retention."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON:Daniel Schober" ;
