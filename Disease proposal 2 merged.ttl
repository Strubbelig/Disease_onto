                                                                                          "PERSON: Bill Hogan"@en ,
                                                                                          "PERSON: Bjoern Peters"@en ,
                                                                                          "PERSON: Melanie Courtot"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "looking up a CRID" ;
                                             rdfs:label "looking up a centrally registered identifier"@en .


