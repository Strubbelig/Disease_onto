                                                       "tissue regeneration" .


###  http://purl.obolibrary.org/obo/GO_0042310
<http://purl.obolibrary.org/obo/GO_0042310> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/WOND_0000409> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A decrease in the diameter of blood vessels, especially arteries, due to constriction of smooth muscle cells that line the vessels, and usually causing an increase in blood pressure." ;
                                            rdfs:label "Vasoconstriction process"@en ,
                                                       "vasoconstriction" .


###  http://purl.obolibrary.org/obo/GO_0042311
<http://purl.obolibrary.org/obo/GO_0042311> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/WOND_0000409> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "An increase in the internal diameter of blood vessels, especially arterioles or capillaries, due to relaxation of smooth muscle cells that line the vessels, and usually resulting in a decrease in blood pressure." ;
                                            rdfs:label "Vasodilation process"@en ,
                                                       "vasodilation" .


