<http://purl.obolibrary.org/obo/OMO_0002001> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "The property is intended to be used exclusively on synonym assertions, to express that the synonym in question is the preference of a specific community. For example, one community may prefer to say call a disease \"A\" and another one \"B\" (but they are the same thing)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A provenance property that denotes a synonym to be the preferred one for a specific community." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> <https://github.com/information-artifact-ontology/ontology-metadata/issues/185> ;
                                             <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0002-7356-1779> ;
                                             <http://purl.org/dc/terms/created> "2025-06-02"^^xsd:date ;
                                             rdfs:label "preferred label for community" .


