###  http://purl.obolibrary.org/obo/OBI_0002129
<http://purl.obolibrary.org/obo/OBI_0002129> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0003683> ,
                                                             [ rdf:type owl:Restriction ;
