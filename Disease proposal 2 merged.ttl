                                                                                          "PERSON:Melanie Courtot"@en ;
                                             rdfs:label "gating"@en .


###  http://purl.obolibrary.org/obo/OBI_0200078
<http://purl.obolibrary.org/obo/OBI_0200078> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200166> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "descriptive statistical calculation objective"@en ;
