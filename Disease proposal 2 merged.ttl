###  http://purl.obolibrary.org/obo/OBI_0003049
<http://purl.obolibrary.org/obo/OBI_0003049> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/COB_0001300> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "hand-held sweep net" ;
