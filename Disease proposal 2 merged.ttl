###  http://purl.obolibrary.org/obo/ENVO_01003004
<http://purl.obolibrary.org/obo/ENVO_01003004> rdf:type owl:ObjectProperty ;
                                               <http://purl.obolibrary.org/obo/IAO_0000115> "A relation between two distinct material entities, the new entity and the old entity, in which the new entity begins to exist through the separation or transformation of a part of the old entity, and the new entity inherits a significant portion of the matter belonging to that part of the old entity."@en ;
                                               rdfs:label "derives from part of"@en .


###  http://purl.obolibrary.org/obo/ENVO_02000200
<http://purl.obolibrary.org/obo/ENVO_02000200> rdf:type owl:ObjectProperty ;
                                               rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002180> ;
                                               <http://purl.obolibrary.org/obo/IAO_0000115> "A has part relationship between a whole and a part, where the number of parts present in the whole is higher than in comparable entities." ;
                                               rdfs:comment "This relation is present in ENVO to support compositional classes such as \"X-enriched soil\". These will later be formalized, and a different relation from RO may be chosen." ;
                                               rdfs:label "has increased levels of" ;
                                               rdfs:seeAlso <https://github.com/EnvironmentOntology/envo/issues/1380> .


###  http://purl.obolibrary.org/obo/IAO_0000011
<http://purl.obolibrary.org/obo/IAO_0000011> rdf:type owl:ObjectProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "One of my mental representations is directed towards the Pacific Ocean."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A relationship between a quality and a portion of reality such that the quality refers to or is cognitively directed towards the portion of reality."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "person: William Hogan"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "https://ceur-ws.org/Vol-1515/regular10.pdf" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> <https://github.com/information-artifact-ontology/IAO/issues/285> ;
                                             rdfs:comment "In the definition source, the relation is called 'is_about'. To avoid confusion with the existing \"is about\" relation in IAO, we called it 'is directed towards' per Alan Ruttenberg's suggestion."@en ;
                                             rdfs:label "is directed towards"@en .


