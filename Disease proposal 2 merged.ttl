                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "unit-variance scaling"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A unit-variance scaling is a data transformation that divides all measurements of a variable by the standard deviation of that variable."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi"@en ,
                                                                                          "Philippe Rocca-Serra"@en ;
