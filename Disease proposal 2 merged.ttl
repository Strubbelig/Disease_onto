                                             <http://purl.obolibrary.org/obo/IAO_0000119> "https://bmcgenomics.biomedcentral.com/articles/10.1186/s12864-018-4585-1" ;
                                             rdfs:label "ribosomal RNA-depleted RNA extract" .


