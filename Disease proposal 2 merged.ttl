###  http://purl.obolibrary.org/obo/RO_0004004
<http://purl.obolibrary.org/obo/RO_0004004> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0004000> ;
                                            owl:inverseOf <http://purl.obolibrary.org/obo/RO_0004014> ;
