                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "calibration" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "the process of using pH buffer adjust a pH meter" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
