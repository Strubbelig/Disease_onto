<http://purl.obolibrary.org/obo/OBI_0000724> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000734> ,
                                                             [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000055> ;
