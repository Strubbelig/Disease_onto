                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/SO_0000353> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "contig" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "A contiguous sequence derived from sequence assembly. Has no gaps, but may contain N's from unavailable bases." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/so.owl> ;
                                            rdfs:label "contig" .


