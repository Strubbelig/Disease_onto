###  http://purl.obolibrary.org/obo/DOID_8506
<http://purl.obolibrary.org/obo/DOID_8506> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://purl.obolibrary.org/obo/WOND_0000194> ;
                                           <http://purl.obolibrary.org/obo/IAO_0000115> "A pemphigoid that is characterized by large blisters." ;
                                           rdfs:label "Bullous pemphigoid" ,
