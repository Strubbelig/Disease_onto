                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "viral hemagglutination inhibition assay" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Examining the ability of a monoclonal antibody to inhibit hemagglutination by Influenza A virus by comparing the levels of hemagglutination with and without the presence of the antibody." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An assay that measures the ability of an evaluant to inhibit hemagglutination by a virus. Hemagglutinin is a viral protein which binds to sialic acid receptors on cells or to erythrocytes, causing the cells to clump. Loss of clumping indicates that the evaluant blocks binding of hemagglutinin to sialic acid receptors."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Bjoern Peters" ,
                                                                                          "Melanie Courtot" ,
                                                                                          "Randi Vita" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "HAI" ,
                                                                                          "HIA" ,
                                                                                          "biological activity" ,
                                                                                          "hemagglutination inhibition" ,
                                                                                          "viral haemagglutinin inhibition assay" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OBI branch derived" ;
                                             rdfs:label "viral hemagglutination inhibition assay" .


