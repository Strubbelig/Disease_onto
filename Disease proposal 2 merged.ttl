<http://purl.obolibrary.org/obo/OBI_0000610> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000504> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "auto injector" ;
