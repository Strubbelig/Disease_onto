###  http://purl.obolibrary.org/obo/RO_0009001
<http://purl.obolibrary.org/obo/RO_0009001> rdf:type owl:ObjectProperty ,
                                                     owl:IrreflexiveProperty ;
                                            rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                            rdfs:range <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "muffin 'has substance added' some 'baking soda'"@en ;
                                            <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "\"has substance added\" is a relation existing between a (physical) entity and a substance in which the entity has had the substance added to it at some point in time."@en ;
                                            <http://purl.obolibrary.org/obo/IAO_0000116> "The relation X 'has substance added' some Y doesn't imply that X still has Y in any detectable fashion subsequent to the addition. Water in dehydrated food or ice cubes are examples, as is food that undergoes chemical transformation. This definition should encompass recipe ingredients."@en ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-8844-9165> ;
                                            rdfs:label "has substance added"@en .


###  http://purl.obolibrary.org/obo/RO_0009002
<http://purl.obolibrary.org/obo/RO_0009002> rdf:type owl:ObjectProperty ,
                                                     owl:IrreflexiveProperty ;
                                            rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                            rdfs:range <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "'egg white' 'has substance removed' some 'egg yolk'"@en ;
                                            <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "\"has substance removed\" is a relation existing between two physical entities in which the first entity has had the second entity (a substance) removed from it at some point in time."@en ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-8844-9165> ;
                                            rdfs:label "has substance removed"@en .


###  http://purl.obolibrary.org/obo/RO_0009003
<http://purl.obolibrary.org/obo/RO_0009003> rdf:type owl:ObjectProperty ,
                                                     owl:IrreflexiveProperty ;
                                            rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                            rdfs:range <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "sardines 'immersed in' some 'oil and mustard'"@en ;
                                            <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "\"immersed in\" is a relation between a (physical) entity and a fluid substance in which the entity is wholely or substantially surrounded by the substance."@en ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-8844-9165> ;
                                            rdfs:label "immersed in"@en .


###  http://purl.obolibrary.org/obo/RO_0009004
<http://purl.obolibrary.org/obo/RO_0009004> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                            rdfs:range <http://purl.obolibrary.org/obo/COB_0000022> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "sardine has consumer some homo sapiens"@en ;
                                            <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "'has consumer' is a relation between a material entity and an organism in which the former can normally be digested or otherwise absorbed by the latter without immediate or persistent ill effect."@en ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-8844-9165> ;
                                            rdfs:label "has consumer"@en .


###  http://purl.obolibrary.org/obo/RO_0009005
<http://purl.obolibrary.org/obo/RO_0009005> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0009001> ;
                                            rdf:type owl:IrreflexiveProperty ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "bread 'has primary substance added' some 'flour'"@en ;
                                            <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "'has primary substance added' indicates that an entity has had the given substance added to it in a proportion greater than any other added substance."@en ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-8844-9165> ;
                                            rdfs:label "has primary substance added"@en .


###  http://purl.obolibrary.org/obo/RO_0009006
<http://purl.obolibrary.org/obo/RO_0009006> rdf:type owl:ObjectProperty ;
                                            owl:inverseOf <http://purl.obolibrary.org/obo/RO_0009007> ;
