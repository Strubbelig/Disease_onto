                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "isolation of cell population" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "removing CD4+ cells from PBMCs using magnetic beads." ;
