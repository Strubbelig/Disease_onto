                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "reconstitution assay" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "\"In an attempt to define the mechanism of insulin-regulated glucose transporter 4 (Glut4) translocation, we have developed an in vitro reconstitution assay... insulin-induced Glut4 translocation can be reconstituted in vitro to a limited extent by using isolated membranes.\" (PMID:10611313)" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An assay in which a cellular process is replicated from the bottom-up using isolated components in order to observe how the components work together."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Rebecca Jackson" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "reconstitution experiment" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "url:https://jcs.biologists.org/content/132/4/jcs227488" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> "https://github.com/obi-ontology/obi/issues/1059" ;
                                             rdfs:label "reconstitution assay" .


