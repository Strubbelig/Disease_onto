                                                                                         "GO" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000232> "Regulation precludes parthood; the regulatory process may not be within the regulated process." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000589> "regulates (processual)" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000600> "false"^^xsd:boolean ;
