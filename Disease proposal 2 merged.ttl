                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001004>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A thin musculomebranous barrier that separates the abdominal and thoracic cavities. Often used for breathing control." ;
                                                rdfs:label "diaphragm" .


###  http://purl.obolibrary.org/obo/UBERON_0001134
<http://purl.obolibrary.org/obo/UBERON_0001134> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0002385> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Muscle tissue that consists primarily of skeletal muscle fibers." ;
                                                rdfs:label "skeletal muscle tissue" .


###  http://purl.obolibrary.org/obo/UBERON_0001155
<http://purl.obolibrary.org/obo/UBERON_0001155> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000062>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001555>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A portion of the large intestine before it becomes the rectum. In mammals, the colon is the most part of the large intestine, excluding the vermiform appendix, the rectum and the anal canal." ;
                                                rdfs:label "colon" .


###  http://purl.obolibrary.org/obo/UBERON_0001159
<http://purl.obolibrary.org/obo/UBERON_0001159> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000062>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001155>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001555>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The part of the large intestine that is closest to the rectum and anus. It forms a loop that averages about 40 cm. in length, and normally lies within the pelvis, but on account of its freedom of movement it is liable to be displaced into the abdominal cavity." ;
                                                rdfs:label "sigmoid colon" .


###  http://purl.obolibrary.org/obo/UBERON_0001225
<http://purl.obolibrary.org/obo/UBERON_0001225> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000062>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Outer cortical portion of the kidney, between the renal capsule and the renal medulla." ;
                                                rdfs:label "cortex of kidney" .


###  http://purl.obolibrary.org/obo/UBERON_0001255
<http://purl.obolibrary.org/obo/UBERON_0001255> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000062> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001062>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Distensible musculomembranous organ situated in the anterior part of the pelvic cavity in which urine collects before excretion[MP]." ;
                                                rdfs:label "urinary bladder" .


###  http://purl.obolibrary.org/obo/UBERON_0001264
<http://purl.obolibrary.org/obo/UBERON_0001264> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000062> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000481>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "An endoderm derived structure that produces precursors of digestive enzymes and blood glucose regulating hormones[GO]." ;
                                                rdfs:label "pancreas" .


###  http://purl.obolibrary.org/obo/UBERON_0001268
<http://purl.obolibrary.org/obo/UBERON_0001268> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0006314> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Transudate contained in the peritoneal cavity." ;
                                                rdfs:label "peritoneal fluid" .


###  http://purl.obolibrary.org/obo/UBERON_0001323
<http://purl.obolibrary.org/obo/UBERON_0001323> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000010>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000467>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000978>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The tibial nerve is a branch of the sciatic nerve. The tibial nerve passes through the popliteal fossa to pass below the arch of soleus. In the popliteal fossa the nerve gives off branches to gastrocnemius, popliteus, soleus and plantaris muscles, an articular branch to the knee joint, and a cutaneous branch that will become the sural nerve. The sural nerve is joined by fibres from the common peroneal nerve and runs down the calf to supply the lateral side of the foot. Below the soleus muscle the nerve lies close to the tibia and supplies the tibialis posterior, the flexor digitorum longus and the flexor hallucis longus. The nerve passes into the foot running posterior to the medial malleolus. Here it is bound down by the flexor retinaculum in company with the posterior tibial artery. [WP,unvetted]." ;
                                                rdfs:label "tibial nerve" .


###  http://purl.obolibrary.org/obo/UBERON_0001359
<http://purl.obolibrary.org/obo/UBERON_0001359> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0006314> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A clear, colorless, bodily fluid, that occupies the subarachnoid space and the ventricular system around and inside the brain and spinal cord." ;
                                                rdfs:label "cerebrospinal fluid" .


###  http://purl.obolibrary.org/obo/UBERON_0001434
<http://purl.obolibrary.org/obo/UBERON_0001434> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000467>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000465>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Anatomical system that is a multi-element, multi-tissue anatomical cluster that consists of the skeleton and the articular system." ;
                                                rdfs:label "skeletal system" .


###  http://purl.obolibrary.org/obo/UBERON_0001460
<http://purl.obolibrary.org/obo/UBERON_0001460> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The part of the forelimb extending from the shoulder to the autopod[cjm]." ;
                                                rdfs:label "arm" .


###  http://purl.obolibrary.org/obo/UBERON_0001485
<http://purl.obolibrary.org/obo/UBERON_0001485> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000465>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The knee joint joins the thigh with the leg and consists of two articulations: one between the femur and tibia, and one between the femur and patella. It is the largest and most complicated joint in the human body. The knee is a mobile trocho-ginglymus (i.e. a pivotal hinge joint), which permits flexion and extension as well as a slight medial and lateral rotation[WP,unvetted]." ;
                                                rdfs:label "knee joint" .


###  http://purl.obolibrary.org/obo/UBERON_0001488
<http://purl.obolibrary.org/obo/UBERON_0001488> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000465>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A joint that connects the hindlimb autopod and zeugopod skeletons." ;
                                                rdfs:label "ankle joint" .


###  http://purl.obolibrary.org/obo/UBERON_0001530
<http://purl.obolibrary.org/obo/UBERON_0001530> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0001637> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A bilaterally paired branched artery that originates from the aortic arches and divides into and includes as parts the internal and external carotid arteries[cjm]." ;
                                                rdfs:label "common carotid artery plus branches" .


###  http://purl.obolibrary.org/obo/UBERON_0001555
<http://purl.obolibrary.org/obo/UBERON_0001555> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000061> ,
