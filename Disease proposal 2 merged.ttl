                                            owl:propertyChainAxiom ( <http://purl.obolibrary.org/obo/RO_0002206>
                                                                     <http://purl.obolibrary.org/obo/BFO_0000050>
                                                                   ) ;
                                            <http://purl.obolibrary.org/obo/IAO_0000112> "'neural crest cell'  SubClassOf expresses some 'Wnt1 gene'" ;
