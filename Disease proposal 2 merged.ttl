                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0003136> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "enhancer-trap mutagenesis" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "We generated several lines of enhancer trap mice carrying an enhancer detector cassette expressing Cre recombinase under the transcriptional control of the minimal promoter (129 base pairs) of the mouse Thy-1.2 gene. PMID:22492032" ;
