<http://purl.obolibrary.org/obo/GO_0043565> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0001588> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "sequence-specific DNA binding" ;
