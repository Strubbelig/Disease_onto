                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0002587> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "supervised machine learning" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A machine learning process using a function that maps an input to an output based on example input-output pairs. It infers a function from labeled training data consisting of a set of training examples."@en ;
