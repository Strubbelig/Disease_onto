                                             <http://purl.obolibrary.org/obo/IAO_0000119> "sep:00095" ;
                                             rdfs:label "gel tank" .


###  http://purl.obolibrary.org/obo/OBI_0400142
<http://purl.obolibrary.org/obo/OBI_0400142> rdf:type owl:Class ;
