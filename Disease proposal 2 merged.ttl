                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/SO_0000353> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "supercontig" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "One or more contigs that have been ordered and oriented using end-read information. Contains gaps that are filled with N's." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/so.owl> ;
                                            rdfs:label "supercontig" .


###  http://purl.obolibrary.org/obo/SO_0000149
