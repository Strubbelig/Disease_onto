###  http://purl.obolibrary.org/obo/GO_0043227
<http://purl.obolibrary.org/obo/GO_0043227> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0005575> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "membrane-bounded organelle" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Organized structure of distinctive morphology and function, bounded by a single or double lipid bilayer membrane. Includes the nucleus, mitochondria, plastids, vacuoles, and vesicles. Excludes the plasma membrane." ;
