###  http://purl.obolibrary.org/obo/OBI_0000494
<http://purl.obolibrary.org/obo/OBI_0000494> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000485> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "liquid chromatography autosampler" ;
