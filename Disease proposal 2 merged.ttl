###  http://purl.obolibrary.org/obo/OBI_0200088
<http://purl.obolibrary.org/obo/OBI_0200088> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200194> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0200083>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "Kaplan Meier"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "a nonparametric (actuarial) data transformation technique for estimating time-related events. It is a univariate analysis that estimates the probability of the proportion of subjects in remission at a particular time, starting from the initiation of active date (time zero), and takes into account those lost to follow-up or not yet in remission at end of study (censored)"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON: James Malone" ,
                                                                                          "PERSON: Tina Boussard" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "http://en.wikipedia.org/wiki/Kaplan%E2%80%93Meier_estimator" ;
                                             rdfs:label "Kaplan Meier"@en .


###  http://purl.obolibrary.org/obo/OBI_0200089
<http://purl.obolibrary.org/obo/OBI_0200089> rdf:type owl:Class ;
                                             owl:equivalentClass [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://purl.obolibrary.org/obo/OBI_0000417> ;
                                                                   owl:someValuesFrom <http://purl.obolibrary.org/obo/OBI_0000791>
                                                                 ] ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000668> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "multiple testing correction method" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000123> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A multiple testing correction method is a hypothesis test performed simultaneously on M > 1 hypotheses.  Multiple testing procedures produce a set of rejected hypotheses that is an estimate for the set of false null hypotheses while controlling for a suitably define Type I error rate"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Monnie McGee" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "multiple testing procedure"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PAPER: Dudoit, Sandrine and van der Laan, Mark J. (2008) Multiple Testing Procedures with Applications to Genomics.  New York: Springer , p. 9-10." ;
                                             rdfs:label "multiple testing correction method"@en .


###  http://purl.obolibrary.org/obo/OBI_0200091
<http://purl.obolibrary.org/obo/OBI_0200091> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200166> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "inter-rater reliability objective" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> """A study was conducted to determine the inter-rater reliability of common clinical examination procedures proposed to identify patients with lumbar segmental instability.

Examples include joint-probability of agreement, Cohen's kappa and the related Fleiss' kappa, inter-rater correlation, concordance correlation coefficient and intra-class correlation.""" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "a data transformation objective of determining the concordance or agreement between human judges."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Person:Alan Ruttenberg" ,
                                                                                          "Person:Helen Parkinson" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "inter-rater agreement" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "http://en.wikipedia.org/wiki/Inter-rater_reliability" ;
                                             rdfs:label "inter-rater reliability objective"@en .


