###  http://purl.obolibrary.org/obo/IAO_0000012
<http://purl.obolibrary.org/obo/IAO_0000012> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.geneontology.org/formats/oboInOwl#ObsoleteClass> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "obsolete_digital entity"@en ;
