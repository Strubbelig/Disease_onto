<http://purl.obolibrary.org/obo/IAO_0000039> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                             rdf:type owl:FunctionalProperty ;
