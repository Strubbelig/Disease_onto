                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "nutrient role" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Luria broth; vitamin A; A nutrient is a substance used in an organism's metabolism which must be taken in from the environment.  Wikipedia."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "a role that inheres in a material entity and is realized in the use of that material entity by an organism when it is used in that organism's metabolism and provides nourishment."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "GROUP:  Role branch"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "nutrient" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "Wikipedia, feb 29, 2008"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000232> "19 Feb 2009; old def: A nutrient role is a role played by a substance used in an organism's metabolism which is taken in from the environment and provides nourishment." ;
                                             rdfs:label "nutrient role"@en .


