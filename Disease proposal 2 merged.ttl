                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "gel tank" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "CHEF gel box, slab gel box, capillary electrophoresis" ;
