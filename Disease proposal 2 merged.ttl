                                              <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/gaz.owl> ;
                                              rdfs:label "geographic location" .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:Restriction ;
  owl:onProperty <http://purl.obolibrary.org/obo/RO_0002566> ;
  owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040> ;
  rdfs:subClassOf [ rdf:type owl:Class ;
                    owl:unionOf ( [ rdf:type owl:Restriction ;
                                    owl:onProperty <http://purl.obolibrary.org/obo/RO_0000056> ;
                                    owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.obolibrary.org/obo/RO_0002418> ;
                                                         owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000015>
                                                       ]
                                  ]
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty <http://purl.obolibrary.org/obo/RO_0002215> ;
                                    owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.obolibrary.org/obo/RO_0000056> ;
                                                         owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <http://purl.obolibrary.org/obo/RO_0002418> ;
                                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000015>
                                                                            ]
                                                       ]
                                  ]
                                )
                  ]
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120038>
                <http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120039>
                <http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120040>
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120041>
                <http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120042>
                <http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120043>
                <http://www.semanticweb.org/strubbelig/moritzmilewskisdiseaseproposal/WOND_120044>
              )
] .


[ rdf:type owl:Restriction ;
  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0002072> ;
  owl:disjointWith [ rdf:type owl:Restriction ;
                     owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                     owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0002097>
                   ]
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( <http://purl.obolibrary.org/obo/IAO_0000120>
                        <http://purl.obolibrary.org/obo/IAO_0000121>
                        <http://purl.obolibrary.org/obo/IAO_0000122>
                        <http://purl.obolibrary.org/obo/IAO_0000123>
                        <http://purl.obolibrary.org/obo/IAO_0000124>
                        <http://purl.obolibrary.org/obo/IAO_0000125>
                        <http://purl.obolibrary.org/obo/IAO_0000423>
                        <http://purl.obolibrary.org/obo/IAO_0000428>
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( <http://purl.obolibrary.org/obo/IAO_0000226>
                        <http://purl.obolibrary.org/obo/IAO_0000227>
                        <http://purl.obolibrary.org/obo/IAO_0000228>
                        <http://purl.obolibrary.org/obo/IAO_0000229>
                      )
] .


