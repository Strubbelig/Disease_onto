                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "regulation of feeding behavior" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "Any process that modulates the rate, frequency or extent of the behavior associated with the intake of food." ;
