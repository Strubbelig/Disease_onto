###  http://purl.obolibrary.org/obo/OBI_0200172
<http://purl.obolibrary.org/obo/OBI_0200172> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200166> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "partitioning objective"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "A k-means clustering which has partitioning objective is a data transformation in which the input data is partitioned into k output sets."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A partitioning objective is a data transformation objective where the aim is to generate a collection of disjoint non-empty subsets whose union equals a non-empty input set."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi" ,
                                                                                          "James Malone"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: Elisabetta Manduchi" ;
                                             rdfs:label "partitioning objective"@en .


###  http://purl.obolibrary.org/obo/OBI_0200173
<http://purl.obolibrary.org/obo/OBI_0200173> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200168> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "background correction objective"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A background correction objective is a data transformation objective where the aim is to remove irrelevant contributions from the measured signal, e.g. those due to instrument noise or sample preparation."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi" ,
                                                                                          "James Malone"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: Elisabetta Manduchi" ;
                                             rdfs:label "background correction objective"@en .


###  http://purl.obolibrary.org/obo/OBI_0200174
