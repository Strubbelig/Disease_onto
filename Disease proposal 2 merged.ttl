                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A dot plot is a report graph which is a graphical representation of data where each data point is represented by a single dot placed on coordinates corresponding to data point values in particular dimensions."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "person:Allyson Lister"@en ,
                                                                                          "person:Chris Stoeckert"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OBI_0000123"@en ,
                                                                                          "group:OBI"@en ;
                                             rdfs:label "dot plot"@en .


