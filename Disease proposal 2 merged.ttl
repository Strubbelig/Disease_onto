                                                                                          "Rebecca Jackson" ,
                                                                                          "Suvarna Nadendla" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "CUT&Tag assay" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "url:https://www.nature.com/articles/s41467-019-09982-5" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> "https://github.com/obi-ontology/obi/issues/1192" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000234> "bonitalam" ;
                                             rdfs:label "cleavage under targets and tagmentation" .


