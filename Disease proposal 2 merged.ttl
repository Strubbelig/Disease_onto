                                                                                  ]
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "clinical chemistry assay" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Influence of hydroxyethyl starch (6% HES 130/0.4) administration on hematology and clinical chemistry parameters." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An analyte assay which uses analytical methods to produce measurements and data on the concentration of chemical parameters (analytes) present in a specimen collected from an organism in order to determine a phenotype of that organism."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Philippe Rocca-Serra" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "chemical pathology" ,
                                                                                          "detection of analyte in blood sample" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "url:https://en.wikipedia.org/wiki/Clinical_chemistry" ;
                                             rdfs:label "clinical chemistry assay" .


###  http://purl.obolibrary.org/obo/OBI_0000521
<http://purl.obolibrary.org/obo/OBI_0000521> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000637> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "flame ionization detector" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A flame ionization detector is a GC detector that consist of a hydrogen/air flame and a collector plate which are normally heated independently of the chromatographic oven. Heating is necessary in order to prevent condensation of water generated by the flame and also to prevent any hold-up of solutes as they pass from the column to the flame. There is an electrode above the flame to collect the ions formed at a hydrogen/air flame. The number of ions hitting the collector is measured and a signal is generated. Flame ionization detectors are most widely used and generally applicable for gas chromatography and hence is used for routine and general purpose analysis. It is easy to use but destructive of the sample."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON:Daniel Schober" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "FID" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "WEB:<http://homepages.onsnet.nu/%7Ealkema/html/whatisgc.html>" ,
                                                                                          "http://msi-ontology.sourceforge.net/ontology/CHROM.owl#msi_01197" ;
                                             rdfs:label "flame ionization detector" .


