###  http://purl.obolibrary.org/obo/OBI_0004001
<http://purl.obolibrary.org/obo/OBI_0004001> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0003699> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "randomized clinical trial"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A clinical trial in which the participants are divided by chance into separate groups that compare different treatments or other interventions. Using chance to divide people into groups means that the groups will be similar and that the effects of the treatments they receive can be compared more fairly. At the time of the trial, it is not known which treatment is best."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Sebastian Duesing"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "https://www.cancer.gov/publications/dictionaries/cancer-terms/def/randomized-clinical-trial"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> "https://github.com/obi-ontology/obi/issues/1891" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000234> "Charles Tapley Hoyt" ;
                                             rdfs:label "randomized clinical trial"@en .


###  http://purl.obolibrary.org/obo/OBI_0004002
<http://purl.obolibrary.org/obo/OBI_0004002> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0003699> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "non-randomized clinical trial"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A clinical trial in which the participants are not assigned by chance to different treatment groups. Participants may choose which group they want to be in, or they may be assigned to the groups by the researchers."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Sebastian Duesing"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "nonrandomized clinical trial" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "https://www.cancer.gov/publications/dictionaries/cancer-terms/def/nonrandomized-clinical-trial"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000233> "https://github.com/obi-ontology/obi/issues/1891" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000234> "Charles Tapley Hoyt" ;
                                             rdfs:label "non-randomized clinical trial"@en .


