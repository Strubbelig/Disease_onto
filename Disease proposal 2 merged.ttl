###  http://purl.obolibrary.org/obo/OBI_0001966
<http://purl.obolibrary.org/obo/OBI_0001966> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0200187> ,
                                                             [ rdf:type owl:Restriction ;
