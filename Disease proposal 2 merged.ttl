###  http://purl.obolibrary.org/obo/OBI_0000416
<http://purl.obolibrary.org/obo/OBI_0000416> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
