###  http://purl.obolibrary.org/obo/OBI_0000611
<http://purl.obolibrary.org/obo/OBI_0000611> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000566> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "Varian NMR instrument" ;
