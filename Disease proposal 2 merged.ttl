###  http://purl.obolibrary.org/obo/RO_0002570
<http://purl.obolibrary.org/obo/RO_0002570> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002131> ;
                                            rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                            rdfs:range <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "x is a conduit for y iff y overlaps through the lumen_of of x, and y has parts on either side of the lumen of x." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000117> <https://orcid.org/0000-0002-6601-2165> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000119> "UBERON:cjm" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000232> "This relation holds between a thing with a 'conduit' (e.g. a bone foramen) and a 'conduee' (for example, a nerve) such that at the time the relationship holds, the conduee has two ends sticking out either end of the conduit. It should therefore note be used for objects that move through the conduit but whose spatial extent does not span the passage. For example, it would not be used for a mountain that contains a long tunnel through which trains pass. Nor would we use it for a digestive tract and objects such as food that pass through." ;
                                            <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/ro/subsets#ro-eco> ;
                                            rdfs:label "conduit for" .


