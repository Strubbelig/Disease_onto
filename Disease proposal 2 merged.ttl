                                             <http://purl.obolibrary.org/obo/IAO_0000111> "vaccine preparation" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "The production of B. pertussis vaccine." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A planned process with the objective to create a vaccine."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OBI" ;
                                             rdfs:label "vaccine production" .


###  http://purl.obolibrary.org/obo/OBI_0000720
<http://purl.obolibrary.org/obo/OBI_0000720> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_1110092> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000054> ;
                                                               owl:allValuesFrom <http://purl.obolibrary.org/obo/GO_0006955>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "immunologic adjuvant role" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Adjuvants are pharmacological or immunological agents that modify the effect of other agents (e.g., drugs, vaccines) while having few if any direct effects when given by themselves.   http://en.wikipedia.org/wiki/Adjuvant" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000120> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "The role a material entity plays when it is co-administered with an immunogen in order to enhance the immune response to the immunogen."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> """11Feb09:Vaccine Ontology Definition: Adjuvant boosts immune response of a vaccine or antigen in the host.  
the role 'adjuvant role' inheres in some 'material entity' and is realized by some 'immune response assay'.""" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "GROUP:  Role branch" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "Vaccine Ontology, Wikipedia, OBI" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000232> "Renamed from adjuvent role, to be a more specific useage for immunology, tracker https://sourceforge.net/tracker/?func=detail&atid=886178&aid=2887909&group_id=177891" ;
                                             rdfs:comment "" ;
                                             rdfs:label "immunologic adjuvant role" .


