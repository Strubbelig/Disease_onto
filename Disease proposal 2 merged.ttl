<http://purl.obolibrary.org/obo/RO_0002449> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002448> ;
                                            rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                            rdfs:range <http://purl.obolibrary.org/obo/BFO_0000040> ;
