###  http://purl.obolibrary.org/obo/RO_0011004
<http://purl.obolibrary.org/obo/RO_0011004> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0011002> ;
                                            rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000040> ;
