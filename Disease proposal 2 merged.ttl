                                             <http://purl.obolibrary.org/obo/IAO_0000233> "https://github.com/obi-ontology/obi/issues/1117" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000234> "VEuPathDB" ;
                                             rdfs:label "nested polymerase chain reaction" .


