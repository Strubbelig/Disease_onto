                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A curve fitting objective is a data transformation objective in which the aim is to find a curve which matches a series of data points and possibly other constraints."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "Elisabetta Manduchi" ,
                                                                                          "James Malone"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "PERSON: Elisabetta Manduchi" ;
                                             rdfs:label "curve fitting objective"@en .


