                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/GO_0008150> ;
                                            <http://purl.obolibrary.org/obo/IAO_0000111> "T cell activation" ;
                                            <http://purl.obolibrary.org/obo/IAO_0000115> "The change in morphology and behavior of a mature or immature T cell resulting from exposure to a mitogen, cytokine, chemokine, cellular ligand, or an antigen for which it is specific." ;
                                            <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/go.owl> ;
                                            rdfs:label "T cell activation" .


###  http://purl.obolibrary.org/obo/GO_0042246
