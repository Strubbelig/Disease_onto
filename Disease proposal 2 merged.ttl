                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A chromatography consumable is a consumable that is used in a chromatography experiment."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "PERSON:Daniel Schober" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "GROUP:<http://msi-ontology.sourceforge.net>" ,
