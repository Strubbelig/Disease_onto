                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000123> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An analog-to-digital_converter is an instrument that converts an infinite resolution analog signal to a finite resolution digital signal."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "John Quinn" ,
