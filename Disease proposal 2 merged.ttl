                                             rdfs:label "affinity column" .


###  http://purl.obolibrary.org/obo/OBI_0000534
<http://purl.obolibrary.org/obo/OBI_0000534> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0000566> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "tecmag NMR instrument" ;
