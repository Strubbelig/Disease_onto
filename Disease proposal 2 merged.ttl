                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A major division of the nervous system that contains nerves which connect the central nervous system (CNS) with sensory organs, other organs, muscles, blood vessels and glands." ;
                                                rdfs:label "peripheral nervous system" .


###  http://purl.obolibrary.org/obo/UBERON_0000029
<http://purl.obolibrary.org/obo/UBERON_0000029> rdf:type owl:Class ;
