@prefix : <https://bioportal.bioontology.org/ontologies/MILD/tests/cq_probes_2026-10-30#> .
@prefix probe: <https://bioportal.bioontology.org/ontologies/MILD/tests/cq_probes_2026-10-30#> .
@prefix mild: <https://bioportal.bioontology.org/ontologies/MILD/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# Probe classes for the MILD competency-question test, 2026-10-30
#
# Each probe is the intersection of two classes that the competency
# questions say must never share an instance. A probe is expected to be
# UNSATISFIABLE after reasoning. The runner reasons these in a separate
# run (ROBOT refuses to write output when a class is unsatisfiable, so
# the probes cannot sit in the main test file) and reads the list of
# unsatisfiable classes ROBOT reports.
#################################################################

<https://bioportal.bioontology.org/ontologies/MILD/tests/cq_probes_2026-10-30> rdf:type owl:Ontology ;
    owl:imports <https://bioportal.bioontology.org/ontologies/MILD> ;
    rdfs:label "MILD competency-question probe classes 2026-10-30"@en .

# CQ3: a disease predisposition is not a material disease entity.
probe:P_predisposition_and_disease rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( mild:MILD_120023 mild:MILD_120020 ) ] ;
    rdfs:label "probe: disease predisposition and material disease entity (expected unsatisfiable)" .

# CQ6: a disease diagnostic result is not a material disease entity.
probe:P_diagnostic_result_and_disease rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( mild:MILD_120024 mild:MILD_120020 ) ] ;
    rdfs:label "probe: disease diagnostic result and material disease entity (expected unsatisfiable)" .

# CQ6: a disease stage classification result is not a material disease entity.
probe:P_stage_result_and_disease rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( mild:MILD_120054 mild:MILD_120020 ) ] ;
    rdfs:label "probe: disease stage classification result and material disease entity (expected unsatisfiable)" .

# CQ6: a disease threshold specification is not a material disease entity.
# Not asserted disjoint in MILD; follows only through the closure
# (directive information entity -> information content entity -> generically
# dependent continuant, disjoint from independent continuant).
probe:P_threshold_spec_and_disease rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( mild:MILD_120029 mild:MILD_120020 ) ] ;
    rdfs:label "probe: disease threshold specification and material disease entity (expected unsatisfiable)" .

# CQ6: no information content entity at all is a material disease entity.
probe:P_information_entity_and_disease rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( obo:IAO_0000030 mild:MILD_120020 ) ] ;
    rdfs:label "probe: information content entity and material disease entity (expected unsatisfiable)" .

# CQ6, informational: the DOID category 'disease' (DOID_4) and material disease
# entity. The DOID module gives DOID_4 no parent class, so MILD cannot rule this
# out; the runner reports the result but does not fail CQ6 on it (the question
# asks for a non-entailment, which holds).
probe:P_doid_disease_and_disease rdf:type owl:Class ;
    owl:equivalentClass [ rdf:type owl:Class ; owl:intersectionOf ( obo:DOID_4 mild:MILD_120020 ) ] ;
    rdfs:label "probe: DOID disease and material disease entity (informational)" .
